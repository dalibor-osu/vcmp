import { Theme } from "theme.slint";
import { FocusRing, ScrollArea, SectionHeading } from "components.slint";
import { Glyph, Icon } from "icons.slint";
import { PlayerState } from "player-state.slint";
import { TrackList, TrackRow } from "album-page.slint";
import { AddFolderButton } from "library-settings.slint";

// A folder in the browser: a music folder at the top, a subfolder below.
export struct FolderRow {
    name: string,
    // Tracks in it and in its subfolders.
    track-count: int,
    // A music folder that is not there now (an unplugged drive).
    missing: bool,
}

// One folder. A click or Enter opens it.
component FolderLine {
    in property <FolderRow> folder;
    in property <bool> focused;
    callback clicked();
    callback shown-focused(length, length);

    changed focused => {
        if self.focused {
            root.shown-focused(self.absolute-position.y, self.height);
        }
    }

    min-height: Theme.target-height;
    accessible-role: list-item;
    accessible-label: root.folder.name;
    accessible-description: root.folder.missing ? @tr("Not connected") : @tr("{n} track" | "{n} tracks" % root.folder.track-count);
    accessible-item-selected: root.focused;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover ? Theme.colors.surface : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 20px;
                height: 20px;
                glyph: Glyph.folder;
                tint: root.folder.missing ? Theme.colors.outline : Theme.colors.text-muted;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.folder.name;
            color: Theme.colors.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        Text {
            text: root.folder.missing ? @tr("Not connected") : @tr("{n} track" | "{n} tracks" % root.folder.track-count);
            color: touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
    }

    if root.focused: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// One step of the path above the folders. The last one is where the page is.
component Crumb {
    in property <string> text;
    in property <bool> here;
    callback clicked();

    min-height: Theme.target-height;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: !root.here;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover && !root.here ? Theme.colors.surface : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;

        Text {
            text: root.text;
            color: root.here || touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
            font-size: Theme.font-body;
            font-weight: root.here ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: !root.here;
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: !root.here;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// The music folders as a file tree, built from the tracks the library holds. Above
// the lists, the path back up; Backspace goes up one folder. The folders are one tab
// stop (arrows, Enter opens), the files another, like every track list.
export component FolderBrowser {
    // The path from the music folders down to here; empty at the top.
    in property <[string]> crumbs;
    in property <[FolderRow]> folders;
    // `title` is the file name; `artist` holds the tags.
    in property <[TrackRow]> files;
    // A music folder is set up at all.
    in property <bool> has-sources;
    callback open-folder(int);
    // Goes to step `n` of the path (-1: the music folders).
    callback go-to(int);
    callback play-file(int);
    callback queue-file(int, bool);

    private property <int> current: 0;

    public function focus-list() {
        if root.folders.length > 0 {
            list.focus();
        }
    }

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    changed folders => {
        root.current = 0;
        scroll.content-y = 0;
    }

    // Backspace goes up from anywhere on the page.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Backspace || (event.modifiers.alt && event.text == Key.UpArrow)) && root.crumbs.length > 0 {
                root.go-to(root.crumbs.length - 2);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: Theme.space-l;

            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-xs;
                accessible-role: AccessibleRole.list;
                accessible-label: @tr("Path");

                Crumb {
                    text: @tr("Music folders");
                    here: root.crumbs.length == 0;
                    clicked => {
                        root.go-to(-1);
                    }
                }
                for crumb[index] in root.crumbs: HorizontalLayout {
                    spacing: Theme.space-xs;

                    VerticalLayout {
                        alignment: center;

                        // The chevron points into the folder that follows.
                        Icon {
                            width: 14px;
                            height: 14px;
                            glyph: Glyph.chevron-down;
                            tint: Theme.colors.outline;
                            transform-rotation: -90deg;
                        }
                    }
                    Crumb {
                        text: crumb;
                        here: index == root.crumbs.length - 1;
                        clicked => {
                            root.go-to(index);
                        }
                    }
                }
            }

            if !root.has-sources: Text {
                text: @tr("No music folders yet. Add the folder your music is in, and its folders show here.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
                max-width: Theme.content-max-width;
            }
            if !root.has-sources: AddFolderButton { }

            scroll := ScrollArea {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-bottom: Theme.space-xxl;
                    spacing: Theme.space-l;
                    alignment: start;

                    list := FocusScope {
                        max-width: Theme.content-max-width;
                        focus-on-click: false;
                        focus-on-tab-navigation: root.folders.length > 0;
                        focus-gained(reason) => {
                            if reason == FocusReason.tab-navigation {
                                Theme.keyboard-navigation = true;
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.DownArrow {
                                root.current = min(root.folders.length - 1, root.current + 1);
                            } else if event.text == Key.UpArrow && !event.modifiers.alt {
                                root.current = max(0, root.current - 1);
                            } else if event.text == Key.Home {
                                root.current = 0;
                            } else if event.text == Key.End {
                                root.current = root.folders.length - 1;
                            } else if event.text == Key.Return || event.text == Key.Space {
                                root.open-folder(root.current);
                            } else {
                                return reject;
                            }
                            accept
                        }

                        VerticalLayout {
                            accessible-role: AccessibleRole.list;
                            accessible-label: @tr("Folders");

                            for folder[index] in root.folders: FolderLine {
                                folder: folder;
                                focused: list.has-focus && index == root.current;
                                clicked => {
                                    root.current = index;
                                    root.open-folder(index);
                                }
                                shown-focused(top, height) => {
                                    root.ensure-visible(top, height);
                                }
                            }
                        }
                    }

                    if root.files.length > 0 && root.folders.length > 0: SectionHeading {
                        text: @tr("Files");
                    }

                    TrackList {
                        label: @tr("Files");
                        title-heading: @tr("File");
                        detail-heading: @tr("Title and artist");
                        tracks: root.files;
                        playing-path: PlayerState.track-path;
                        play(index) => {
                            root.play-file(index);
                        }
                        queue(index, next) => {
                            root.queue-file(index, next);
                        }
                        shown-focused(top, height) => {
                            root.ensure-visible(top, height);
                        }
                    }
                }
            }
        }
    }
}
