import { Theme } from "theme.slint";
import { FocusRing, IconButton, TextLink } from "components.slint";
import { Glyph, Icon } from "icons.slint";
import { PlayerProblem, PlayerState, PlayState, Repeat, ScrobbleMark, Shuffle } from "player-state.slint";
import { LastfmState, LastfmStatus } from "lastfm-state.slint";

// The play/pause button: the focal point of the bar, filled with the accent.
component PlayButton {
    in property <bool> playing;
    in property <bool> enabled;
    callback clicked;

    function press() {
        if root.enabled {
            root.clicked();
        }
    }

    width: 48px;
    height: 48px;
    accessible-role: button;
    accessible-label: root.playing ? @tr("Pause") : @tr("Play");
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.press();
    }
    forward-focus: focus;

    Rectangle {
        border-radius: self.height / 2;
        background: root.enabled ? Theme.colors.accent : Theme.colors.surface;
    }

    Icon {
        width: 22px;
        height: 22px;
        glyph: root.playing ? Glyph.pause : Glyph.play;
        tint: root.enabled ? Theme.colors.on-accent : Theme.colors.outline;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            Theme.keyboard-navigation = false;
            root.press();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.press();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: root.height / 2;
    }
}

// A small mark about the playing track (a lossless file, Last.fm). Its label is
// spoken, and shown above it while pointed at, since the glyph alone is no word.
component TrackMark {
    in property <Glyph> glyph;
    in property <string> label;
    in property <color> tint: Theme.colors.text-muted;

    width: 16px;
    height: 16px;
    accessible-role: image;
    accessible-label: root.label;

    Icon {
        width: 14px;
        height: 14px;
        glyph: root.glyph;
        tint: root.tint;
    }

    touch := TouchArea { }

    // Above the mark, over the page: the bar is drawn after the pages.
    if touch.has-hover: Rectangle {
        x: 0;
        y: -self.height - Theme.space-s;
        width: hint.preferred-width + 2 * Theme.space-s;
        height: hint.preferred-height + 2 * Theme.space-xs;
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.colors.surface;
        background: Theme.colors.base;

        hint := Text {
            text: root.label;
            color: Theme.colors.text;
            font-size: Theme.font-small;
            accessible-role: none;
        }
    }
}

// A horizontal slider from 0 to 1. While dragged it follows the pointer and reports
// `moved`; `released` gives the final value. Arrow keys step by `step`, and so does a
// notch of the wheel over it when `wheel` is set.
export component Slider {
    in property <float> value;
    in property <string> label;
    // Spoken value, e.g. "1:23 of 4:05".
    in property <string> value-text;
    in property <float> step: 0.05;
    in property <bool> enabled: true;
    // The wheel moves the value: up raises it. Only for the volume; a wheel over the
    // position would seek by accident while scrolling past the bar.
    in property <bool> wheel;
    // The fill is the accent for progress (something happening now), muted for a
    // plain setting such as volume.
    in property <bool> accent-fill: true;
    callback moved(float);
    callback released(float);

    private property <bool> dragging: touch.pressed;
    private property <float> drag-value;
    private property <float> shown: self.dragging ? self.drag-value : clamp(self.value, 0, 1);

    function set-from(x: length) {
        root.drag-value = clamp(x / root.width, 0, 1);
        root.moved(root.drag-value);
    }
    function step-by(delta: float) {
        let next = clamp(root.value + delta, 0, 1);
        root.moved(next);
        root.released(next);
    }

    min-width: 64px;
    height: Theme.target-height / 2;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => {
        root.step-by(root.step);
    }
    accessible-action-decrement => {
        root.step-by(-root.step);
    }
    forward-focus: focus;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: self.height / 2;
        background: Theme.colors.surface;
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * root.shown;
        height: 4px;
        border-radius: self.height / 2;
        background: !root.enabled ? Theme.colors.outline : root.accent-fill ? Theme.colors.accent : Theme.colors.text-muted;
    }

    if root.enabled && (touch.has-hover || root.dragging || focus.has-focus): Rectangle {
        x: parent.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: self.height / 2;
        background: Theme.colors.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Theme.keyboard-navigation = false;
                root.set-from(self.mouse-x);
            } else if event.kind == PointerEventKind.up {
                root.released(root.drag-value);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
        // A notch is a line of 60 px (`wheel::LINE`); the steps of a glide and a
        // touchpad's pixels add up to the same. Each step is reported as it comes,
        // the value released once the wheel rests.
        scroll-event(event) => {
            if !root.wheel || event.delta-y == 0 {
                return reject;
            }
            root.moved(clamp(root.value + event.delta-y / 60px * root.step, 0, 1));
            if wheel-rest.running {
                wheel-rest.restart();
            } else {
                wheel-rest.start();
            }
            accept
        }
    }

    wheel-rest := Timer {
        interval: Theme.wheel-commit-delay;
        running: false;
        triggered => {
            self.stop();
            root.released(clamp(root.value, 0, 1));
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.RightArrow {
                root.step-by(root.step);
            } else if event.text == Key.LeftArrow {
                root.step-by(-root.step);
            } else if event.text == Key.Home {
                root.step-by(-1);
            } else if event.text == Key.End {
                root.step-by(1);
            } else {
                return reject;
            }
            accept
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// The bar along the bottom of the window: what is playing, the controls and the
// volume.
export component PlayerBar inherits Rectangle {
    in-out property <bool> queue-open;
    // Leads from the playing track to its album or artist.
    callback show-album();
    callback show-artist();

    // The play will be or was scrobbled to a connected account.
    private property <bool> scrobble-shown: PlayerState.scrobble != ScrobbleMark.none && LastfmState.status == LastfmStatus.connected;

    background: Theme.colors.mantle;
    height: 88px;

    // Separates the bar from the page above.
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.colors.surface;
    }

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-xl;
        spacing: Theme.space-xl;

        // What is playing. The title and the cover lead to the album, the artist
        // to the artist; the cover is for the pointer, the title the keyboard's way.
        HorizontalLayout {
            min-width: 160px;
            preferred-width: 280px;
            horizontal-stretch: 1;
            spacing: Theme.space-m;
            alignment: start;

            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-m;
                clip: true;
                background: Theme.colors.surface;

                if PlayerState.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: PlayerState.cover;
                    image-fit: ImageFit.cover;
                    accessible-role: none;
                }
                if PlayerState.has-track && !PlayerState.has-cover: Text {
                    text: PlayerState.initial;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-heading;
                    font-weight: Theme.weight-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                TouchArea {
                    enabled: PlayerState.has-album-link;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => {
                        Theme.keyboard-navigation = false;
                        root.show-album();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                if !PlayerState.has-track: Text {
                    text: @tr("Nothing playing");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    overflow: elide;
                }

                if PlayerState.has-track: TextLink {
                    text: PlayerState.title;
                    label: PlayerState.album == "" ? PlayerState.title : @tr("{0}, go to the album {1}", PlayerState.title, PlayerState.album);
                    font-weight: Theme.weight-strong;
                    enabled: PlayerState.has-album-link;
                    clicked => {
                        root.show-album();
                    }
                }

                // The artist, then marks for a lossless file and Last.fm.
                if PlayerState.has-track && (PlayerState.artist != "" || PlayerState.lossless-format != "" || root.scrobble-shown): HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-s;

                    if PlayerState.artist != "": TextLink {
                        text: PlayerState.artist;
                        label: @tr("{}, go to the artist", PlayerState.artist);
                        color: Theme.colors.text-muted;
                        font-size: Theme.font-small;
                        enabled: PlayerState.has-artist-link;
                        clicked => {
                            root.show-artist();
                        }
                    }

                    if PlayerState.lossless-format != "": VerticalLayout {
                        alignment: center;

                        TrackMark {
                            glyph: Glyph.lossless;
                            label: @tr("Lossless ({})", PlayerState.lossless-format);
                        }
                    }

                    if root.scrobble-shown: VerticalLayout {
                        alignment: center;

                        TrackMark {
                            glyph: PlayerState.scrobble == ScrobbleMark.scrobbled ? Glyph.scrobbled : Glyph.scrobble;
                            tint: PlayerState.scrobble == ScrobbleMark.scrobbled ? Theme.colors.text : Theme.colors.text-muted;
                            label: PlayerState.scrobble == ScrobbleMark.scrobbled ? @tr("Scrobbled to Last.fm") : @tr("Scrobbling to Last.fm");
                        }
                    }
                }

                if PlayerState.problem != PlayerProblem.none: Text {
                    text: PlayerState.problem == PlayerProblem.no-output ? @tr("No sound output: {}. Press play to try again.", PlayerState.problem-detail)
                        : PlayerState.problem == PlayerProblem.tags-not-written ? @tr("The new tags could not be written to {}. Edit its tags to try again.", PlayerState.problem-detail)
                        : @tr("A track could not be played and was skipped: {}", PlayerState.problem-detail);
                    color: Theme.colors.text;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }
        }

        // Controls and the position in the track.
        VerticalLayout {
            min-width: 240px;
            preferred-width: 520px;
            horizontal-stretch: 2;
            alignment: center;
            spacing: 0px;

            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-s;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        glyph: Glyph.shuffle;
                        checkable: true;
                        active: PlayerState.shuffle == Shuffle.on;
                        label: @tr("Shuffle");
                        clicked => {
                            PlayerState.set-shuffle(PlayerState.shuffle == Shuffle.on ? Shuffle.off : Shuffle.on);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;

                    IconButton {
                        glyph: Glyph.previous;
                        label: @tr("Previous track");
                        enabled: PlayerState.has-track;
                        clicked => {
                            PlayerState.previous();
                        }
                    }
                }

                PlayButton {
                    playing: PlayerState.state == PlayState.playing;
                    enabled: PlayerState.has-track;
                    clicked => {
                        PlayerState.toggle-play();
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        glyph: Glyph.next;
                        label: @tr("Next track");
                        enabled: PlayerState.has-track;
                        clicked => {
                            PlayerState.next();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;

                    IconButton {
                        glyph: PlayerState.repeat == Repeat.one ? Glyph.repeat-one : Glyph.repeat;
                        checkable: true;
                        active: PlayerState.repeat != Repeat.off;
                        label: PlayerState.repeat == Repeat.one ? @tr("Repeat this track") : PlayerState.repeat == Repeat.all ? @tr("Repeat all") : @tr("Repeat");
                        clicked => {
                            PlayerState.set-repeat(PlayerState.repeat == Repeat.off ? Repeat.all : PlayerState.repeat == Repeat.all ? Repeat.one : Repeat.off);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-s;

                Text {
                    width: 52px;
                    text: PlayerState.position-text;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Slider {
                    horizontal-stretch: 1;
                    enabled: PlayerState.has-track && PlayerState.duration-ms > 0;
                    value: PlayerState.duration-ms > 0 ? PlayerState.position-ms / PlayerState.duration-ms : 0;
                    label: @tr("Position");
                    value-text: @tr("{0} of {1}", PlayerState.position-text, PlayerState.duration-text);
                    step: PlayerState.duration-ms > 0 ? 5000 / PlayerState.duration-ms : 0.05;
                    released(fraction) => {
                        PlayerState.seek(round(fraction * PlayerState.duration-ms));
                    }
                }

                Text {
                    width: 52px;
                    text: PlayerState.duration-text;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }

        // The now playing view's and the queue panel's switches, and the volume.
        HorizontalLayout {
            min-width: 200px;
            preferred-width: 280px;
            horizontal-stretch: 1;
            alignment: end;
            spacing: Theme.space-s;

            VerticalLayout {
                alignment: center;

                IconButton {
                    glyph: Glyph.expand;
                    checkable: true;
                    active: PlayerState.now-playing-open;
                    enabled: PlayerState.has-track || PlayerState.now-playing-open;
                    label: @tr("Now playing");
                    clicked => {
                        PlayerState.now-playing-open = !PlayerState.now-playing-open;
                        if PlayerState.now-playing-open {
                            PlayerState.load-large-cover();
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                IconButton {
                    glyph: Glyph.queue;
                    checkable: true;
                    active: root.queue-open;
                    label: @tr("Queue");
                    clicked => {
                        root.queue-open = !root.queue-open;
                        Theme.preferences-changed();
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                IconButton {
                    glyph: PlayerState.muted ? Glyph.muted : Glyph.volume;
                    label: PlayerState.muted ? @tr("Unmute") : @tr("Mute");
                    clicked => {
                        PlayerState.toggle-mute();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                max-width: 120px;

                Slider {
                    accent-fill: false;
                    wheel: true;
                    value: PlayerState.muted ? 0 : PlayerState.volume;
                    label: @tr("Volume");
                    value-text: PlayerState.muted ? @tr("Muted") : @tr("{}%", round(PlayerState.volume * 100));
                    moved(volume) => {
                        PlayerState.volume-changed(volume);
                    }
                    released(volume) => {
                        PlayerState.volume-committed(volume);
                    }
                }
            }
        }
    }
}
