import "../../../assets/fonts/sora/Sora[wght].ttf";
import { ReduceMotion, Theme, ThemeMode, ThemePalette } from "theme.slint";
import { NavItem, PlaylistLink, ScrollArea } from "components.slint";
import { AboutPage, AlbumsPage, ArtistsPage, FoldersPage, PlaylistsPage, SearchPage, SettingsPage, SongsPage } from "pages.slint";
import { FolderRow } from "folders-page.slint";
import { SongColumn, SongRow, SongSelection } from "songs-page.slint";
import { ArtistDetail } from "artist-page.slint";
import { AlbumTile, ArtworkState } from "album-grid.slint";
import { AlbumDetail, TrackRow, TrackSelection } from "album-page.slint";
import { SelectionChange } from "selection.slint";
import { PlaylistDetail } from "playlist-page.slint";
import { Playlists } from "playlist-state.slint";
import { LibraryError, LibraryState, ScanPhase, SourceFolder, UnreadableFile } from "library-state.slint";
import { ProgressBar } from "components.slint";
import { PlayerProblem, PlayerState, PlayState, QueueRow, QueueSource, Repeat, ScrobbleMark, Shuffle, ShuffleKind, SleepTimer } from "player-state.slint";
import { PlayerBar } from "player-bar.slint";
import { QueuePanel } from "queue-panel.slint";
import { NowPlayingView } from "now-playing.slint";
import { MovingPictures, PictureFrame, PictureSlot } from "picture.slint";
import { Glyph, IconArt } from "icons.slint";
import { LastfmProblem, LastfmState, LastfmStatus } from "lastfm-state.slint";
import { SidebarUpdateNote, UpdateState } from "updates.slint";
import { CoverPicker, CoverSearch, CoverSearchStatus } from "cover-picker.slint";
import { PhotoPicker, PhotoSearch, PhotoSearchStatus } from "photo-picker.slint";
import { TagChange, TagEditorState, TagEditorStatus, TagEditorView, TagFailure, TagFailureReason, TagField, TagMixed, TagProblem, TagValues } from "tag-editor.slint";
import { ColumnWidths } from "columns.slint";
import { AgentState, ChangeEntry, ChangeField, ChangeGroup, ChangeHistory, ChangeKind, ChangeProblem, ChangeReview, ChangeRow, ChangeStatus, ReviewStatus, ServerStatus, SidebarReviewNote } from "agents.slint";
import { LabelChoice, LabelEditor, LabelEntry, LabelFilterPage, LabelProblem, Labels, PaletteColour } from "labels.slint";
import { LabelDetail, LabelsPage } from "label-page.slint";
import { CaptionButtons, WindowFrame } from "window-frame.slint";
import { ConfirmDialog, Confirmation } from "confirmation.slint";

export { Confirmation, WindowFrame }
export { LabelChoice, LabelDetail, LabelEntry, LabelFilterPage, LabelProblem, Labels, PaletteColour }
export { AgentState, ChangeEntry, ChangeField, ChangeGroup, ChangeKind, ChangeProblem, ChangeRow, ChangeStatus, ReviewStatus, ServerStatus }
export { LastfmProblem, LastfmState, LastfmStatus }
export { Glyph, IconArt, PlayerProblem, PlayerState, PlayState, QueueRow, QueueSource, Repeat, ScrobbleMark, Shuffle, ShuffleKind, SleepTimer }
export { CoverSearch, CoverSearchStatus, PhotoSearch, PhotoSearchStatus }
export { TagChange, TagEditorState, TagEditorStatus, TagFailure, TagFailureReason, TagField, TagMixed, TagProblem, TagValues }
export { FolderRow, PlaylistDetail, Playlists, SongColumn, SongRow, SongSelection }
export { SelectionChange }
export { MovingPictures, PictureFrame, PictureSlot }
export { ColumnWidths }
export { UpdateState }
export { TrackSelection }
export { AlbumDetail, AlbumTile, ArtistDetail, ArtworkState, LibraryError, LibraryState, ReduceMotion, ScanPhase, SourceFolder, Theme, ThemeMode, ThemePalette, TrackRow, UnreadableFile }

export enum Page { search, albums, artists, playlists, labels, songs, folders, settings, about }

struct NavEntry {
    page: Page,
    label: string,
    // The sidebar groups its sections: Search, then the library, then the app's own
    // pages. Numbered in order, from 0.
    group: int,
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <[AlbumTile]> albums;
    // The album shown instead of the grid while `album-open` is set.
    in property <AlbumDetail> album-detail;
    in property <[TrackRow]> album-tracks;
    in property <bool> album-multi-disc;
    in-out property <bool> album-open;
    // Filters on the Albums, Artists and Songs pages, and their edits.
    in-out property <string> albums-filter;
    in-out property <string> artists-filter;
    in-out property <string> songs-filter;
    callback albums-filter-edited(string);
    callback artists-filter-edited(string);
    callback songs-filter-edited(string);
    // The Artists page: its grid, the open artist and an album opened from there.
    in property <[AlbumTile]> artists;
    in-out property <bool> artists-show-all;
    in-out property <bool> artist-open;
    in-out property <bool> artist-album-open;
    in property <ArtistDetail> artist-detail;
    in property <[AlbumTile]> artist-albums;
    in property <[TrackRow]> artist-appearances;
    callback artist-activated(int);
    callback artist-range-changed(int, int);
    // The grid switched between album artists and everyone.
    callback artists-filter-changed();
    callback artist-album-activated(int);
    // Plays everything by the open artist, shuffled or not, or from an appearance.
    callback play-artist(bool);
    callback play-artist-appearance(int);
    callback queue-artist-appearance(int, bool);
    // The Playlists page: its grid, and the playlist open instead of it.
    in property <[AlbumTile]> playlists;
    in-out property <bool> playlist-open;
    in property <PlaylistDetail> playlist-detail;
    in property <[TrackRow]> playlist-tracks;
    // Position of the open playlist in `playlists` and the sidebar; -1 for none.
    in property <int> open-playlist-index: -1;
    callback playlist-activated(int);
    callback playlist-range-changed(int, int);
    // Makes a playlist with this name and opens it.
    callback create-playlist(string);
    // Edits the open playlist.
    callback rename-playlist(string);
    callback delete-playlist();
    callback choose-playlist-picture();
    callback clear-playlist-picture();
    callback export-playlist();
    callback remove-playlist-track(int);
    callback move-playlist-track(int, int);
    // Plays the open playlist from an entry (-1: from its start), shuffled or not.
    callback play-playlist(int, bool);
    callback queue-playlist-track(int, bool);
    // The Labels section: the open label's page, and what it plays.
    in-out property <bool> label-open;
    in property <LabelDetail> label-detail;
    in property <[TrackRow]> label-tracks;
    // Position of the open label in `Labels.all` and the sidebar; -1 for none.
    in property <int> open-label-index: -1;
    callback label-activated(int);
    // Plays the open label's tracks from one (-1: from the first), shuffled or not.
    callback play-label(int, bool);
    callback queue-label-track(int, bool);
    // The queue panel is shown beside the page.
    in-out property <bool> queue-open;
    // The library database could not be opened or read.
    in property <bool> library-failed;
    // Starts on Albums.
    in-out property <int> selected-index: 1;
    // The album grid's rows in view changed: first album index and how many fit.
    callback album-range-changed(int, int);
    callback album-activated(int);
    // Plays the open album from a track (-1: from its start), shuffled or not.
    callback play-album(int, bool);
    // Puts a track of the open album into Up next: at its front, or at its end.
    callback queue-album-track(int, bool);
    // Search: the typed text, its results, and what can be done with them.
    in-out property <string> search-text;
    in property <[AlbumTile]> search-artists;
    in property <[AlbumTile]> search-albums;
    in property <[AlbumTile]> search-playlists;
    in property <[TrackRow]> search-tracks;
    // An album or artist page was opened from search; its back button returns there.
    in-out property <bool> opened-from-search;
    callback search-edited(string);
    callback search-artist-activated(int);
    callback search-album-activated(int);
    callback search-playlist-activated(int);
    // Plays the found tracks from one of them, or puts one into Up next.
    callback play-search-track(int);
    callback queue-search-track(int, bool);
    // The Songs page: every track, sorted by a column.
    in property <[SongRow]> songs;
    in property <SongColumn> songs-sort-column: SongColumn.artist;
    in property <bool> songs-sort-descending;
    // The Songs page is shown and wants its tracks loaded.
    callback songs-needed();
    // A column header was chosen: sort by it, or reverse the order.
    callback sort-songs(SongColumn);
    callback play-song(int);
    callback queue-song(int, bool);
    // The Folders page: the path from the music folders to the folder shown, its
    // subfolders and its files.
    in property <[string]> folder-crumbs;
    in property <[FolderRow]> folder-rows;
    in property <[TrackRow]> folder-files;
    callback folders-needed();
    callback open-folder(int);
    // Goes to step `n` of the path (-1: the music folders).
    callback folder-go-to(int);
    callback play-folder-file(int);
    callback queue-folder-file(int, bool);
    out property <Page> current-page: root.nav[root.selected-index].page;

    private property <[NavEntry]> nav: [
        { page: Page.search, label: @tr("Search"), group: 0 },
        { page: Page.albums, label: @tr("Albums"), group: 1 },
        { page: Page.artists, label: @tr("Artists"), group: 1 },
        { page: Page.playlists, label: @tr("Playlists"), group: 1 },
        { page: Page.labels, label: @tr("Labels"), group: 1 },
        { page: Page.songs, label: @tr("Songs"), group: 1 },
        { page: Page.folders, label: @tr("Folders"), group: 1 },
        { page: Page.settings, label: @tr("Settings"), group: 2 },
        { page: Page.about, label: @tr("About"), group: 2 },
    ];
    // Back and forward through the places shown, like a browser (src/navigation.rs):
    // the mouse's back and forward buttons, and Alt+Left and Alt+Right. The window
    // reports every change of section or of the page open in it.
    callback navigated();
    callback go-back();
    callback go-forward();
    changed selected-index => {
        root.navigated();
    }
    changed album-open => {
        root.navigated();
    }
    changed artist-open => {
        root.navigated();
    }
    changed artist-album-open => {
        root.navigated();
    }
    changed playlist-open => {
        root.navigated();
    }
    changed album-detail => {
        root.navigated();
    }
    changed artist-detail => {
        root.navigated();
    }
    changed open-playlist-index => {
        root.navigated();
    }
    changed label-open => {
        root.navigated();
    }
    changed open-label-index => {
        root.navigated();
    }

    // Shows a section on its grid, not on the album, artist or playlist it last
    // showed, as its sidebar entry does.
    public function show-section(index: int) {
        root.selected-index = index;
        let page = root.nav[index].page;
        if page == Page.albums && root.album-open {
            albums-page.close-album();
        }
        if page == Page.artists && (root.artist-open || root.artist-album-open) {
            artists-page.show-grid();
        }
        if page == Page.playlists && root.playlist-open {
            playlists-page.close-playlist();
        }
        if page == Page.labels && root.label-open {
            labels-page.close-label();
        }
    }

    // Opens the playing track's album, or its artist, on their page, from the
    // player bar or the now playing view (which closes).
    function show-playing-album() {
        PlayerState.go-to-album();
        root.opened-from-search = false;
        PlayerState.now-playing-open = false;
        root.selected-index = 1;
    }
    function show-playing-artist() {
        PlayerState.go-to-artist();
        root.opened-from-search = false;
        PlayerState.now-playing-open = false;
        root.selected-index = 2;
    }

    // A text field has the focus, so Space types instead of playing.
    out property <bool> typing: TextInputInterface.text-input-focused;

    // Takes the focus off whatever has it, back to the window: a click does this
    // first (src/shortcuts.rs), so the focus ring goes and Space plays and pauses.
    public function release-focus() {
        shortcuts.focus();
        Theme.keyboard-navigation = false;
    }

    // Opens playlist `index` on the Playlists page, from the sidebar.
    function show-playlist(index: int) {
        root.playlist-activated(index);
        root.opened-from-search = false;
        root.selected-index = 3;
    }

    // Opens label `index` on the Labels page, from the sidebar.
    function show-label(index: int) {
        root.label-activated(index);
        root.opened-from-search = false;
        root.selected-index = 4;
    }

    // Shows the Search page with its field focused.
    function show-search() {
        root.opened-from-search = false;
        root.selected-index = 0;
        search-page.focus-field();
    }

    private property <length> nav-spacing: Theme.space-xs;
    // Wide enough for the queue panel beside the page, the page narrows to make
    // room; in a narrower window the panel lies over the page's right edge, so the
    // page keeps the width its controls need. Only page widths depend on this, never
    // the window's layout.
    private property <length> queue-width: 320px;
    private property <bool> queue-beside: root.width >= 1000px;
    // In a narrower window the open queue covers the pages (not the sidebar), and
    // once it has slid in the pages are hidden, so the keyboard can't reach controls
    // under it. Escape closes it.
    private property <bool> queue-covers: root.queue-open && !root.queue-beside;
    // How far out of its place the queue panel is, from 0 (open) to 1 (gone): it
    // slides in and out, and stays made until it is out.
    private property <float> queue-out: root.queue-open ? 0 : 1;
    animate queue-out { duration: Theme.duration-medium; easing: ease-out; }
    private property <bool> queue-settled: root.queue-open && root.queue-out == 0;
    // How much of the now playing view shows: it fades in and out. The conditions
    // that make the view and the queue panel read these first, so the animations
    // follow every change, drawn or not.
    private property <float> now-playing-shown: PlayerState.now-playing-open ? 1 : 0;
    animate now-playing-shown { duration: Theme.duration-medium; easing: ease-out; }
    private property <length> page-width: pages.width - (root.queue-open && root.queue-beside ? root.queue-width : 0px);

    private property <length> marker-height: 20px;
    // The marker's place below the first section; it slides when the page changes.
    // The room between two groups of sections, with a line across its middle.
    private property <length> nav-group-gap: Theme.space-l;
    private property <length> marker-offset: root.selected-index * (Theme.target-height + root.nav-spacing)
        + root.nav[root.selected-index].group * root.nav-group-gap + (Theme.target-height - root.marker-height) / 2;
    animate marker-offset { duration: Theme.duration-medium; easing: ease-in-out; }

    // Scrolls the sidebar so the entry at window y `top` with `height` is in view,
    // when the keyboard moves to it.
    function show-in-sidebar(top: length, height: length) {
        let view-top = sidebar-scroll.absolute-position.y;
        let view-bottom = view-top + sidebar-scroll.visible-height;
        if top < view-top {
            sidebar-scroll.content-y = min(0px, sidebar-scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            sidebar-scroll.content-y = sidebar-scroll.content-y - (top + height - view-bottom);
        }
    }

    title: "VCMP";
    // Windows: the window has no system title bar (src/title_bar.rs). Its frame
    // takes the theme's colours, and the window drags by the sidebar down to its
    // first section while nothing covers it; both are handed on when they change.
    callback frame-changed();
    private property <ThemePalette> frame-colors: Theme.colors;
    changed frame-colors => {
        root.frame-changed();
    }
    private property <bool> sidebar-covered: root.now-playing-shown > 0 || PlayerState.now-playing-open || CoverSearch.open || PhotoSearch.open || TagEditorState.open || AgentState.history-open || AgentState.review-open || Labels.editor-open || Confirmation.open;
    out property <length> frame-sidebar-width: sidebar.width;
    out property <length> frame-sidebar-drag-height: root.sidebar-covered ? 0px : max(0px, sidebar-scroll.y + sidebar-scroll.content-y + sidebar-content.y + nav-list.y - Theme.space-s);
    changed frame-sidebar-drag-height => {
        root.frame-changed();
    }
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1100px;
    preferred-height: 720px;
    default-font-family: "Sora";
    background: Theme.colors.base;

    // Holds the focus at start, so shortcuts work before anything was focused.
    forward-focus: shortcuts;

    // Sees every key press before the focused control does, to switch focus rings on
    // and catch shortcuts.
    shortcuts := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            Theme.keyboard-navigation = true;
            if event.modifiers.alt && !root.typing && event.text == Key.LeftArrow {
                root.go-back();
                return accept;
            }
            if event.modifiers.alt && !root.typing && event.text == Key.RightArrow {
                root.go-forward();
                return accept;
            }
            if event.text == Key.Escape && root.queue-covers {
                root.queue-open = false;
                return accept;
            }
            // Ctrl+F (Cmd+F on macOS) filters the page shown, where it has a
            // filter, and searches from anywhere else.
            if (event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") {
                if root.current-page == Page.albums && !root.album-open {
                    albums-page.focus-filter();
                } else if root.current-page == Page.artists && !root.artist-open && !root.artist-album-open {
                    artists-page.focus-filter();
                } else if root.current-page == Page.songs {
                    songs-page.focus-filter();
                } else {
                    root.show-search();
                }
                return accept;
            }
            // Ctrl+= (or Ctrl++) and Ctrl+- zoom, Ctrl+0 goes back to 100 %.
            if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt {
                if event.text == "=" || event.text == "+" {
                    Theme.zoom-by(1);
                    return accept;
                }
                if event.text == "-" {
                    Theme.zoom-by(-1);
                    return accept;
                }
                if event.text == "0" {
                    Theme.zoom-by(0);
                    return accept;
                }
            }
            // Space plays and pauses unless a text field is being typed in: caught
            // here, before the focused control, so buttons and lists never take it.
            // The app also catches it before Slint routes keys (src/shortcuts.rs),
            // so it works when nothing has the focus.
            // Ctrl+Space is left to the track lists, where it selects.
            if event.text == Key.Space && !root.typing && !event.modifiers.control {
                if PlayerState.has-track {
                    PlayerState.toggle-play();
                }
                return accept;
            }
            reject
        }


        VerticalLayout {
            // The sidebar and pages, and the now playing view over them; the player
            // bar stays below both.
            Rectangle {
                vertical-stretch: 1;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;

                    sidebar := Rectangle {
                        width: 220px;
                        background: Theme.colors.mantle;

                        // The wordmark, the sections and the playlists scroll together
                        // when the window is too short for them; the scan status and the
                        // update note stay below.
                        sidebar-scroll := ScrollArea {
                            y: 0;
                            width: parent.width;
                            height: parent.height - sidebar-foot.height;

                            sidebar-content := VerticalLayout {
                                padding: Theme.space-l;
                                spacing: Theme.space-xl;
                                alignment: start;

                                // Wordmark, inset to line up with the navigation labels.
                                HorizontalLayout {
                                    padding-left: Theme.space-l;

                                    Text {
                                        text: "VCMP";
                                        color: Theme.colors.text;
                                        font-size: Theme.font-wordmark;
                                        font-weight: Theme.weight-strong;
                                    }
                                }

                                nav-list := VerticalLayout {
                                    spacing: root.nav-spacing;
                                    accessible-role: tab-list;
                                    accessible-label: @tr("Sections");

                                    for entry[index] in root.nav: VerticalLayout {
                                        // The first section of a group has the gap above it.
                                        if index > 0 && root.nav[index - 1].group != entry.group: Rectangle {
                                            height: root.nav-group-gap;

                                            Rectangle {
                                                x: Theme.space-l;
                                                width: parent.width - 2 * Theme.space-l;
                                                height: 1px;
                                                background: Theme.colors.surface;
                                            }
                                        }

                                        NavItem {
                                            label: entry.label;
                                            selected: index == root.selected-index;
                                            activated => {
                                                root.show-section(index);
                                            }
                                            shown-focused(top, height) => {
                                                root.show-in-sidebar(top, height);
                                            }
                                        }
                                    }
                                }

                                // The playlists, below the sections.
                                if Playlists.names.length > 0: VerticalLayout {
                                    spacing: Theme.space-s;

                                    HorizontalLayout {
                                        padding-left: Theme.space-l;

                                        Text {
                                            text: @tr("Playlists");
                                            color: Theme.colors.text-muted;
                                            font-size: Theme.font-small;
                                            accessible-role: none;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: root.nav-spacing;
                                        accessible-role: list;
                                        accessible-label: @tr("Playlists");

                                        for name[index] in Playlists.names: PlaylistLink {
                                            label: name;
                                            selected: root.current-page == Page.playlists && root.playlist-open && index == root.open-playlist-index;
                                            activated => {
                                                root.show-playlist(index);
                                            }
                                            shown-focused(top, height) => {
                                                root.show-in-sidebar(top, height);
                                            }
                                        }
                                    }
                                }

                                // The labels, below the playlists.
                                if Labels.all.length > 0: VerticalLayout {
                                    spacing: Theme.space-s;

                                    HorizontalLayout {
                                        padding-left: Theme.space-l;

                                        Text {
                                            text: @tr("Labels");
                                            color: Theme.colors.text-muted;
                                            font-size: Theme.font-small;
                                            accessible-role: none;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: root.nav-spacing;
                                        accessible-role: list;
                                        accessible-label: @tr("Labels");

                                        for label[index] in Labels.all: PlaylistLink {
                                            label: label.name;
                                            dot: true;
                                            dot-light: label.light;
                                            dot-dark: label.dark;
                                            selected: root.current-page == Page.labels && root.label-open && index == root.open-label-index;
                                            activated => {
                                                root.show-label(index);
                                            }
                                            shown-focused(top, height) => {
                                                root.show-in-sidebar(top, height);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Its own height, at the bottom: left to the default, the layout
                        // would fill the sidebar from `y` down.
                        sidebar-foot := VerticalLayout {
                            y: parent.height - self.height;
                            width: parent.width;
                            height: self.preferred-height;

                            // Scan status, visible from every page while albums appear.
                            if LibraryState.scanning: VerticalLayout {
                                padding: Theme.space-l;
                                padding-left: Theme.space-xl;
                                spacing: Theme.space-s;

                                Text {
                                    text: @tr("Scanning your music");
                                    color: Theme.colors.text-muted;
                                    font-size: Theme.font-small;
                                }

                                ProgressBar {
                                    progress: LibraryState.progress;
                                    label: @tr("Scan progress");
                                }
                            }

                            // A change an agent asked for waits for review: shown on
                            // every page, above the update note, until it is decided.
                            if AgentState.pending-count > 0: SidebarReviewNote { }

                            // A newer VCMP is out: shown where the scan status goes,
                            // which has the place while a scan runs. About shows it too.
                            if UpdateState.available && !LibraryState.scanning: SidebarUpdateNote { }
                        }

                        // Current-page marker. It scrolls with the sections and hides
                        // outside their view.
                        marker := Rectangle {
                            x: Theme.space-l - 6px;
                            y: sidebar-scroll.y + sidebar-scroll.content-y + sidebar-content.y + nav-list.y + root.marker-offset;
                            visible: self.y >= sidebar-scroll.y && self.y + self.height <= sidebar-scroll.y + sidebar-scroll.visible-height;
                            width: 3px;
                            height: root.marker-height;
                            border-radius: Theme.radius-s;
                            background: Theme.colors.accent;
                        }
                    }

                    pages := Rectangle {
                        accessible-role: tab-panel;
                        visible: !(root.queue-covers && root.queue-settled);

                        search-page := SearchPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.search;
                            text <=> root.search-text;
                            artists: root.search-artists;
                            albums: root.search-albums;
                            playlists: root.search-playlists;
                            tracks: root.search-tracks;
                            edited(text) => {
                                root.search-edited(text);
                            }
                            artist-activated(index) => {
                                root.search-artist-activated(index);
                                root.opened-from-search = true;
                                root.selected-index = 2;
                            }
                            album-activated(index) => {
                                root.search-album-activated(index);
                                root.opened-from-search = true;
                                root.selected-index = 1;
                            }
                            playlist-activated(index) => {
                                root.search-playlist-activated(index);
                                root.opened-from-search = true;
                                root.selected-index = 3;
                            }
                            play-track(index) => {
                                root.play-search-track(index);
                            }
                            queue-track(index, next) => {
                                root.queue-search-track(index, next);
                            }
                        }
                        albums-page := AlbumsPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.albums;
                            from-search: root.opened-from-search;
                            back-to-search => {
                                root.album-open = false;
                                root.show-search();
                            }
                            filter <=> root.albums-filter;
                            filter-edited(text) => {
                                root.albums-filter-edited(text);
                            }
                            albums: root.albums;
                            album: root.album-detail;
                            tracks: root.album-tracks;
                            multi-disc: root.album-multi-disc;
                            album-open <=> root.album-open;
                        library-failed: root.library-failed;
                        play-album(start, shuffle) => {
                            root.play-album(start, shuffle);
                        }
                        queue-album-track(index, next) => {
                            root.queue-album-track(index, next);
                        }
                            range-changed(first, count) => {
                                root.album-range-changed(first, count);
                            }
                            activated(index) => {
                                root.opened-from-search = false;
                                root.album-activated(index);
                            }
                        }
                        artists-page := ArtistsPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.artists;
                            from-search: root.opened-from-search;
                            back-to-search => {
                                root.artist-album-open = false;
                                root.artist-open = false;
                                root.show-search();
                            }
                            filter <=> root.artists-filter;
                            filter-edited(text) => {
                                root.artists-filter-edited(text);
                            }
                            artists: root.artists;
                            show-all <=> root.artists-show-all;
                            library-failed: root.library-failed;
                            artist-open <=> root.artist-open;
                            album-open <=> root.artist-album-open;
                            artist: root.artist-detail;
                            artist-albums: root.artist-albums;
                            appearances: root.artist-appearances;
                            album: root.album-detail;
                            tracks: root.album-tracks;
                            multi-disc: root.album-multi-disc;
                            activated(index) => {
                                root.opened-from-search = false;
                                root.artist-activated(index);
                            }
                            range-changed(first, count) => {
                                root.artist-range-changed(first, count);
                            }
                            filter-changed => {
                                root.artists-filter-changed();
                            }
                            album-activated(index) => {
                                root.artist-album-activated(index);
                            }
                            play-artist(shuffle) => {
                                root.play-artist(shuffle);
                            }
                            play-appearance(index) => {
                                root.play-artist-appearance(index);
                            }
                            queue-appearance(index, next) => {
                                root.queue-artist-appearance(index, next);
                            }
                            play-album(start, shuffle) => {
                                root.play-album(start, shuffle);
                            }
                            queue-album-track(index, next) => {
                                root.queue-album-track(index, next);
                            }
                        }
                        playlists-page := PlaylistsPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.playlists;
                            from-search: root.opened-from-search;
                            back-to-search => {
                                root.playlist-open = false;
                                root.show-search();
                            }
                            playlists: root.playlists;
                            library-failed: root.library-failed;
                            playlist-open <=> root.playlist-open;
                            playlist: root.playlist-detail;
                            tracks: root.playlist-tracks;
                            range-changed(first, count) => {
                                root.playlist-range-changed(first, count);
                            }
                            activated(index) => {
                                root.opened-from-search = false;
                                root.playlist-activated(index);
                            }
                            create(name) => {
                                root.opened-from-search = false;
                                root.create-playlist(name);
                            }
                            play(start, shuffle) => {
                                root.play-playlist(start, shuffle);
                            }
                            queue-track(index, next) => {
                                root.queue-playlist-track(index, next);
                            }
                            remove-track(index) => {
                                root.remove-playlist-track(index);
                            }
                            move-track(from, to) => {
                                root.move-playlist-track(from, to);
                            }
                            rename(name) => {
                                root.rename-playlist(name);
                            }
                            choose-picture => {
                                root.choose-playlist-picture();
                            }
                            clear-picture => {
                                root.clear-playlist-picture();
                            }
                            export => {
                                root.export-playlist();
                            }
                            delete => {
                                root.delete-playlist();
                            }
                        }
                        labels-page := LabelsPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.labels;
                            library-failed: root.library-failed;
                            label-open <=> root.label-open;
                            label: root.label-detail;
                            tracks: root.label-tracks;
                            playing-path: PlayerState.track-path;
                            activated(index) => {
                                root.label-activated(index);
                            }
                            play(start, shuffle) => {
                                root.play-label(start, shuffle);
                            }
                            queue-track(index, next) => {
                                root.queue-label-track(index, next);
                            }
                        }
                        songs-page := SongsPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.songs;
                            songs: root.songs;
                            sort-column: root.songs-sort-column;
                            sort-descending: root.songs-sort-descending;
                            library-failed: root.library-failed;
                            filter <=> root.songs-filter;
                            filter-edited(text) => {
                                root.songs-filter-edited(text);
                            }
                            needed => {
                                root.songs-needed();
                            }
                            sort(column) => {
                                root.sort-songs(column);
                            }
                            play(index) => {
                                root.play-song(index);
                            }
                            queue(index, next) => {
                                root.queue-song(index, next);
                            }
                        }
                        FoldersPage {
                            x: 0;
                            width: root.page-width;
                            shown: root.current-page == Page.folders;
                            crumbs: root.folder-crumbs;
                            folders: root.folder-rows;
                            files: root.folder-files;
                            needed => {
                                root.folders-needed();
                            }
                            open-folder(index) => {
                                root.open-folder(index);
                            }
                            go-to(index) => {
                                root.folder-go-to(index);
                            }
                            play-file(index) => {
                                root.play-folder-file(index);
                            }
                            queue-file(index, next) => {
                                root.queue-folder-file(index, next);
                            }
                        }
                        if root.current-page == Page.settings: ScrollArea {
                            x: 0;
                            width: root.page-width;
                            SettingsPage {
                                width: parent.width;
                            }
                        }
                        if root.current-page == Page.about: ScrollArea {
                            x: 0;
                            width: root.page-width;
                            AboutPage {
                                width: parent.width;
                                version: root.version;
                            }
                        }

                    }


                }

                // Leaves the queue panel its room when the window is wide enough.
                if root.now-playing-shown > 0 || PlayerState.now-playing-open: NowPlayingView {
                    opacity: root.now-playing-shown;
                    visible: !(root.queue-covers && root.queue-settled);
                    width: parent.width - (root.queue-open && root.queue-beside ? root.queue-width : 0px);
                    height: parent.height;
                    close => {
                        PlayerState.now-playing-open = false;
                    }
                    show-album => {
                        root.show-playing-album();
                    }
                    show-artist => {
                        root.show-playing-artist();
                    }
                }

                // Over the pages and the now playing view alike: at the right edge, or
                // over all of them in a narrower window.
                if root.queue-out < 1 || root.queue-open: QueuePanel {
                    x: parent.width - self.width + root.queue-out * self.width;
                    width: root.queue-beside ? root.queue-width : parent.width - sidebar.width;
                    height: parent.height;
                }

                // "Find cover online" from an album page, over everything but the bar.
                if CoverSearch.open: CoverPicker {
                    width: parent.width;
                    height: parent.height;
                }

                // "Find photo online" from an artist page, the same way.
                if PhotoSearch.open: PhotoPicker {
                    width: parent.width;
                    height: parent.height;
                }

                // The tag editor, the same way.
                if TagEditorState.open: TagEditorView {
                    width: parent.width;
                    height: parent.height;
                }

                // The changes agents asked for, opened from Settings, the same way.
                if AgentState.history-open: ChangeHistory {
                    width: parent.width;
                    height: parent.height;
                }

                // The review of a change an agent asked for, the same way.
                if AgentState.review-open: ChangeReview {
                    width: parent.width;
                    height: parent.height;
                }

                // Making or editing a label, from Settings, the Labels page or a menu.
                if Labels.editor-open: LabelEditor {
                    width: parent.width;
                    height: parent.height;
                }

                // An "are you sure?" before deleting, last so it is over any dialog
                // that asks one.
                if Confirmation.open: ConfirmDialog {
                    width: parent.width;
                    height: parent.height;
                }

                // Windows: the window's own buttons, over everything, as its title
                // bar's would be.
                if WindowFrame.custom: CaptionButtons {
                    x: parent.width - self.width;
                    y: 0;
                }
            }

            PlayerBar {
                queue-open <=> root.queue-open;
                show-album => {
                    root.show-playing-album();
                }
                show-artist => {
                    root.show-playing-artist();
                }
            }
        }
    }
}
