// Standard control glyphs (ui/icons, drawn on a 24 x 24 grid). They are the shapes
// people read without labels; each button still carries a spoken label.
export enum Glyph { play, pause, previous, next, shuffle, repeat, repeat-one, volume, muted, queue, remove, chevron-down, search, folder, expand, more, lossless, scrobble, scrobbled, plus, minus }

// Icon art painted in a colour, by src/icons.rs. The colour is written into the SVG
// before it is drawn, because both ways of tinting inside Slint misdraw small glyphs
// with the GPU renderer: a filled Path loses pixels at the corner where it starts,
// and `colorize` (which paints the image into a texture first) cut pieces out of
// the next button on the owner's machine.
export global IconArt {
    pure callback paint(Glyph, color) -> image;
}

// A glyph painted in `tint`.
export component Icon inherits Image {
    in property <Glyph> glyph;
    in property <color> tint;

    source: IconArt.paint(root.glyph, root.tint);
    accessible-role: none;
}
