import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, SectionHeading } from "components.slint";
import { PlayerState } from "player-state.slint";
import { AlbumTile, CardGrid } from "album-grid.slint";
import { BackButton, TrackLine, TrackRow } from "album-page.slint";

export struct ArtistDetail {
    name: string,
    // First letter of the name, shown while there is no picture.
    initial: string,
    album-count: int,
    track-count: int,
    // Until artists have photos, the cover of their newest album.
    has-picture: bool,
    picture: image,
    // The artist left the library while the page was open.
    missing: bool,
}

// One artist: picture and name, their own albums, then the tracks they appear on
// elsewhere (features, compilations, tracks without an album).
export component ArtistView {
    in property <ArtistDetail> artist;
    in property <[AlbumTile]> albums;
    // `artist` holds the album each track is on.
    in property <[TrackRow]> appearances;
    callback back();
    callback album-activated(int);
    // Plays everything by the artist: their albums' tracks, then the appearances;
    // from the start, or shuffled.
    callback play(bool);
    // Plays the same list from an appearance.
    callback play-appearance(int);
    // Puts an appearance into Up next: at its front (`next`), or at its end.
    callback queue-appearance(int, bool);

    // The keyboard's current track in the appearances list.
    private property <int> current: 0;

    public function focus-back() {
        back-button.focus();
    }

    // Shows the albums with `index` as the current card, focused.
    public function focus-album(index: int) {
        albums-grid.focus-card(index);
    }

    function show-menu(index: int, x: length, y: length) {
        root.current = index;
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    forward-focus: back-button;

    // Handles Escape for everything on the page; not a tab stop itself.
    FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.back();
                return accept;
            }
            reject
        }

        scroll := ScrollView {
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                padding: Theme.space-xxl;
                padding-top: Theme.space-xl;
                spacing: Theme.space-xl;
                alignment: start;

                HorizontalLayout {
                    alignment: start;

                    back-button := BackButton {
                        label: @tr("Artists");
                        clicked => {
                            root.back();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xl;
                    alignment: start;

                    Rectangle {
                        width: 200px;
                        height: 200px;
                        border-radius: self.width / 2;
                        clip: true;
                        background: Theme.colors.surface;

                        if root.artist.has-picture: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.artist.picture;
                            image-fit: ImageFit.cover;
                            accessible-role: none;
                        }
                        if !root.artist.has-picture: Text {
                            text: root.artist.initial;
                            color: Theme.colors.text-muted;
                            font-size: 64px;
                            font-weight: Theme.weight-strong;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: end;
                        max-width: Theme.content-max-width;

                        Text {
                            text: root.artist.name;
                            color: Theme.colors.text;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-strong;
                            wrap: word-wrap;
                        }

                        if !root.artist.missing: HorizontalLayout {
                            spacing: Theme.space-l;
                            alignment: start;

                            if root.artist.album-count > 0: Text {
                                text: @tr("{n} album" | "{n} albums" % root.artist.album-count);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: @tr("{n} track" | "{n} tracks" % root.artist.track-count);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-small;
                            }
                        }

                        if !root.artist.missing && root.artist.track-count > 0: HorizontalLayout {
                            padding-top: Theme.space-s;
                            spacing: Theme.space-m;
                            alignment: start;

                            Button {
                                text: @tr("Play");
                                label: @tr("Play {}", root.artist.name);
                                primary: true;
                                clicked => {
                                    root.play(false);
                                }
                            }

                            Button {
                                text: @tr("Shuffle");
                                label: @tr("Shuffle {}", root.artist.name);
                                clicked => {
                                    root.play(true);
                                }
                            }
                        }
                    }
                }

                if root.artist.missing: Text {
                    text: @tr("This artist is no longer in your library: their files were moved or deleted, or their folder was removed.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                if root.albums.length > 0: SectionHeading {
                    text: @tr("Albums");
                }

                // Always there (it is focused by id); empty when the artist has no albums.
                albums-grid := CardGrid {
                    tiles: root.albums;
                    label: @tr("Albums");
                    available-width: root.width - 2 * Theme.space-xxl - Theme.space-l;
                    activated(index) => {
                        root.album-activated(index);
                    }
                }

                if root.appearances.length > 0: SectionHeading {
                    text: @tr("Appears on");
                }

                // The appearances: one tab stop; Up/Down move, Enter or Space plays, and
                // the Menu key (or a right click) opens the track's menu.
                menu := ContextMenuArea {
                    max-width: Theme.content-max-width;

                    Menu {
                        MenuItem {
                            title: @tr("Play now");
                            activated => {
                                root.play-appearance(root.current);
                            }
                        }
                        MenuItem {
                            title: @tr("Play next");
                            activated => {
                                root.queue-appearance(root.current, true);
                            }
                        }
                        MenuItem {
                            title: @tr("Add to queue");
                            activated => {
                                root.queue-appearance(root.current, false);
                            }
                        }
                    }

                    list := FocusScope {
                        focus-on-click: false;
                        focus-on-tab-navigation: root.appearances.length > 0;
                        focus-gained(reason) => {
                            if reason == FocusReason.tab-navigation {
                                Theme.keyboard-navigation = true;
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.DownArrow {
                                root.current = min(root.appearances.length - 1, root.current + 1);
                            } else if event.text == Key.UpArrow {
                                root.current = max(0, root.current - 1);
                            } else if event.text == Key.Home {
                                root.current = 0;
                            } else if event.text == Key.End {
                                root.current = root.appearances.length - 1;
                            } else if event.text == Key.Return || event.text == Key.Space {
                                root.play-appearance(root.current);
                            } else {
                                return reject;
                            }
                            accept
                        }

                        VerticalLayout {
                            accessible-role: AccessibleRole.list;
                            accessible-label: @tr("Appears on");

                            for track[index] in root.appearances: TrackLine {
                                track: track;
                                playing: track.path == PlayerState.track-path;
                                focused: list.has-focus && index == root.current;
                                clicked => {
                                    root.current = index;
                                    root.play-appearance(index);
                                }
                                menu-requested(x, y) => {
                                    root.show-menu(index, x, y);
                                }
                                shown-focused(top, height) => {
                                    root.ensure-visible(top, height);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
