// AI agents through MCP: the switch and the connection in Settings, the dialog that
// lists the changes they asked for with Review and Undo, the note in the sidebar while
// one waits, and the dialog that reviews one. Rust keeps `AgentState` current and implements its callbacks
// (src/agents.rs).

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, Modal, ProgressBar, SectionHeading, SettingRow, TextField, TextLink, Toggle } from "components.slint";
import { Confirmation } from "confirmation.slint";

export enum ServerStatus { off, running, failed }
export enum ChangeKind { tags, undo, playlist, labels, label-undo }
export enum ChangeStatus { pending, accepted, partly-written, rejected, discarded, undone }

// One change an agent asked for, as the history lists it.
export struct ChangeEntry {
    id: int,
    kind: ChangeKind,
    // The files a change of tags covers.
    files: int,
    // The playlist a deletion names.
    playlist: string,
    // Who asked: the agent's own name, empty for the owner's undo.
    agent: string,
    minutes-ago: int,
    status: ChangeStatus,
    can-undo: bool,
}

// `label`: a label, `before` and `after` holding its name while the track has it.
export enum ChangeField { title, artist, album, album-artist, track, disc, year, genre, cover, other, label }

// One change the review lists: a tag and its values before and after.
export struct ChangeRow {
    field: ChangeField,
    // The tag's key, for a tag other than the nine fields.
    key: string,
    // Values joined by semicolons; empty for none.
    before: string,
    after: string,
    // A change of cover: the image before and after, `has-` false for no cover.
    has-before-cover: bool,
    before-cover: image,
    has-after-cover: bool,
    after-cover: image,
}

// One file's changes in the review: its track's title, its file name and the rows.
export struct ChangeGroup {
    title: string,
    file: string,
    rows: [ChangeRow],
}

export enum ReviewStatus { waiting, writing, done }

// A file the accepted change left as it was.
export struct ChangeProblem {
    file: string,
    // Its tags changed since the change was asked for; otherwise writing failed.
    conflict: bool,
}

export global AgentState {
    // Agents may connect while VCMP is open.
    in property <bool> enabled;
    callback set-enabled(bool);
    // Agents may also control playback; off by default.
    in property <bool> playback-enabled;
    callback set-playback-enabled(bool);
    in property <ServerStatus> status;
    in property <string> address;
    in property <string> token;
    in property <string> port;
    // The command that adds VCMP to Claude Code.
    in property <string> setup-command;
    // The entry that adds VCMP to Claude Desktop's mcpServers, through `vcmp mcp`.
    in property <string> desktop-config;
    callback set-port(string);
    callback new-token();

    // Newest first, in their own dialog opened from Settings.
    in property <[ChangeEntry]> history;
    in-out property <bool> history-open;
    // The review was opened from that dialog, which comes back when it closes.
    in-out property <bool> review-from-history;
    callback review(int);
    callback undo(int);
    // The covers kept for finished changes ("2.4 MB"), empty when none are kept.
    in property <string> backups-size;
    in property <bool> has-finished;
    callback delete-backups();

    // Changes waiting for review; the sidebar note opens the oldest.
    in property <int> pending-count;
    callback review-next();

    // The review dialog.
    in property <bool> review-open;
    in property <ChangeKind> review-kind;
    in property <string> review-agent;
    in property <int> review-files;
    in property <string> review-playlist;
    // With several files: the changes every one of them gets, listed once. Then each
    // file with changes of its own, by path.
    in property <[ChangeRow]> review-shared;
    // The labels a change of labels makes, by name; empty when it makes none. A
    // change may only make labels, with no track to change (review-files 0).
    in property <string> review-new-labels;
    in property <int> review-new-label-count;
    // The undo of a change of labels: the labels that change made, which go unless a
    // track holds them by then; empty when it made none.
    in property <string> review-gone-labels;
    in property <[ChangeGroup]> review-groups;
    in property <ReviewStatus> review-status;
    in property <int> review-done;
    in property <int> review-written;
    in property <[ChangeProblem]> review-problems;
    // On Windows: the file playback has open, when the change would rewrite it.
    in property <string> review-playing;
    // The library could not be read or written.
    in property <bool> review-failed;
    callback accept();
    callback reject();
    callback close-review();
}

// "2 changes by agents wait for your review" at the foot of the sidebar, like the
// update note: on screen on every page, opening the oldest change.
export component SidebarReviewNote inherits VerticalLayout {
    padding: Theme.space-l;
    padding-left: 2 * Theme.space-l;

    TextLink {
        text: @tr("{n} change by an agent waits for your review" | "{n} changes by agents wait for your review" % AgentState.pending-count);
        label: @tr("{n} change by an agent waits for your review, opens it" | "{n} changes by agents wait for your review, opens the oldest" % AgentState.pending-count);
        font-size: Theme.font-small;
        wrap: true;
        clicked => {
            AgentState.review-next();
        }
    }
}

// A value to copy, with its Copy button.
component CopyField inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <string> copy-label;

    spacing: Theme.space-m;

    // A long value (the token, the command) scrolls inside the field rather than
    // widening the column.
    field := TextField {
        horizontal-stretch: 1;
        min-width: 96px;
        preferred-width: 96px;
        label: root.label;
        text: root.text;
        read-only: true;
    }
    Button {
        text: @tr("Copy");
        label: root.copy-label;
        clicked => {
            field.copy-all();
        }
    }
}

// How the history and the review word what they list.
global AgentWords {
    // A field's name as the tag editor labels it, or the key of another tag.
    public pure function field-name(row: ChangeRow) -> string {
        if row.field == ChangeField.title {
            return @tr("Title");
        }
        if row.field == ChangeField.artist {
            return @tr("Artist");
        }
        if row.field == ChangeField.album {
            return @tr("Album");
        }
        if row.field == ChangeField.album-artist {
            return @tr("Album artist");
        }
        if row.field == ChangeField.track {
            return @tr("Track");
        }
        if row.field == ChangeField.disc {
            return @tr("Disc");
        }
        if row.field == ChangeField.year {
            return @tr("Year");
        }
        if row.field == ChangeField.genre {
            return @tr("Genre");
        }
        if row.field == ChangeField.cover {
            return @tr("Cover");
        }
        if row.field == ChangeField.label {
            return @tr("Label “{}”", row.key);
        }
        row.key
    }

    public pure function age(minutes: int) -> string {
        if minutes < 1 {
            return @tr("just now");
        }
        if minutes < 60 {
            return @tr("{n} minute ago" | "{n} minutes ago" % minutes);
        }
        if minutes < 24 * 60 {
            return @tr("{n} hour ago" | "{n} hours ago" % floor(minutes / 60));
        }
        @tr("{n} day ago" | "{n} days ago" % floor(minutes / (24 * 60)))
    }

    public pure function status-text(status: ChangeStatus) -> string {
        if status == ChangeStatus.pending {
            return @tr("waiting for your review");
        }
        if status == ChangeStatus.accepted {
            return @tr("written");
        }
        if status == ChangeStatus.partly-written {
            return @tr("partly written");
        }
        if status == ChangeStatus.rejected {
            return @tr("rejected");
        }
        if status == ChangeStatus.discarded {
            return @tr("not reviewed before VCMP closed");
        }
        @tr("undone")
    }

    public pure function asked-by(agent: string) -> string {
        agent == "" ? @tr("you") : agent
    }
}

// The AI agents section of Settings: the switch, how to connect while it is on and
// whether agents may control playback then, the changes agents asked for, and the
// backups that keep them undoable.
export component AgentsSection inherits VerticalLayout {
    // The dialog asks about deleting the backups.
    private property <bool> asked;

    spacing: Theme.space-xs;

    SectionHeading {
        text: @tr("AI agents");
    }

    SettingRow {
        title: @tr("Let AI agents use your library");
        description: @tr("While VCMP is open, agents that speak MCP, such as Claude, can read your library and edit playlists. Changes to tags and deleting a playlist wait for your review.");

        Toggle {
            label: @tr("Let AI agents use your library");
            checked: AgentState.enabled;
            toggled(on) => {
                AgentState.set-enabled(on);
            }
        }
    }

    // How an agent connects, while the switch is on.
    if AgentState.enabled: VerticalLayout {
        spacing: Theme.space-m;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-m;

        Text {
            text: AgentState.status == ServerStatus.failed ? @tr("Port {} is in use by another program, so agents can't connect. Choose another port below.", AgentState.port)
                : @tr("Agents connect to this address with the token. Anyone with the token can read your library and edit your playlists while VCMP is open, so keep it to yourself.");
            color: AgentState.status == ServerStatus.failed ? Theme.colors.error : Theme.colors.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }

        if AgentState.status == ServerStatus.running: CopyField {
            label: @tr("Address");
            text: AgentState.address;
            copy-label: @tr("Copy the address");
        }

        HorizontalLayout {
            spacing: Theme.space-m;

            CopyField {
                horizontal-stretch: 1;
                label: @tr("Token");
                text: AgentState.token;
                copy-label: @tr("Copy the token");
            }
            Button {
                text: @tr("New token");
                label: @tr("Make a new token; agents with the old one can't connect any more");
                clicked => {
                    AgentState.new-token();
                }
            }
        }

        if AgentState.status == ServerStatus.running: VerticalLayout {
            spacing: Theme.space-s;

            Text {
                text: @tr("To add VCMP to Claude Code, run:");
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            CopyField {
                label: @tr("Command for Claude Code");
                text: AgentState.setup-command;
                copy-label: @tr("Copy the command for Claude Code");
            }
            Text {
                text: @tr("For Claude Desktop, which starts VCMP's relay itself, add this inside \"mcpServers\" in its configuration file:");
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            CopyField {
                label: @tr("Configuration for Claude Desktop");
                text: AgentState.desktop-config;
                copy-label: @tr("Copy the configuration for Claude Desktop");
            }
        }

        SettingRow {
            title: @tr("Let AI agents control playback");
            description: @tr("Agents can play and queue music, pause, skip, change the volume and the output device, and set the sleep timer. Off, they can still read your library.");

            Toggle {
                label: @tr("Let AI agents control playback");
                checked: AgentState.playback-enabled;
                toggled(on) => {
                    AgentState.set-playback-enabled(on);
                }
            }
        }

        SettingRow {
            title: @tr("Port");
            description: @tr("The port on this computer agents connect to. Change it if another program uses it.");

            TextField {
                width: 96px;
                label: @tr("Port");
                text: AgentState.port;
                accepted(text) => {
                    AgentState.set-port(text);
                }
            }
        }
    }

    // The changes agents asked for, in a dialog of their own so a long history doesn't
    // fill Settings.
    SettingRow {
        title: @tr("Changes by agents");
        description: AgentState.history.length == 0 ? @tr("Changes agents ask for are kept here for 30 days, and a written change can be undone in that time.")
            : @tr("{n} change from the last 30 days. Review it while it waits, or undo it once written." | "{n} changes from the last 30 days. Review the ones waiting, or undo written ones." % AgentState.history.length);

        Button {
            text: @tr("Show changes…");
            label: @tr("Show the changes by agents");
            enabled: AgentState.history.length > 0;
            clicked => {
                AgentState.history-open = true;
            }
        }
    }

    SettingRow {
        title: @tr("Backups for undo");
        description: AgentState.backups-size == "" ? @tr("A written change can be undone for 30 days, with the covers it replaced. Deleting the backups frees their room, and those changes can't be undone after.")
            : @tr("A written change can be undone for 30 days, with the covers it replaced. The covers kept now take {}. Deleting the backups frees that room, and those changes can't be undone after.", AgentState.backups-size);

        // Asks first, in a dialog (`Confirmation`).
        Button {
            property <int> answers: Confirmation.answers;
            changed answers => {
                if root.asked {
                    root.asked = false;
                    if Confirmation.accepted {
                        AgentState.delete-backups();
                    }
                    self.focus();
                }
            }
            text: @tr("Delete backups…");
            enabled: AgentState.has-finished;
            clicked => {
                root.asked = true;
                Confirmation.ask(@tr("Delete the backups of every finished change?"), @tr("None of them can be undone afterwards. Changes waiting for review stay."), @tr("Delete backups"), @tr("Delete backups"), @tr("Keep the backups"));
            }
        }
    }
}

// The changes agents asked for, newest first, each with what can still be done: a
// dialog over Settings like the review, which it hands over to. Escape, Close or a
// click beside it closes; it holds nothing to lose.
export component ChangeHistory inherits Modal {
    // Tab went past the last control, or Shift+Tab before the first.
    private property <int> wrap-first;
    private property <int> wrap-last;

    function close() {
        AgentState.history-open = false;
    }
    // The review takes the dialog's place, and gives it back when it closes.
    function review(id: int, undo: bool) {
        AgentState.review-from-history = true;
        AgentState.history-open = false;
        if undo {
            AgentState.undo(id);
        } else {
            AgentState.review(id);
        }
    }

    label: @tr("Changes by agents");
    card-width: Theme.dialog-width;
    escape => {
        root.close();
    }
    scrim-clicked => {
        root.close();
    }
    focus-first => {
        root.wrap-first += 1;
    }
    focus-last => {
        root.wrap-last += 1;
    }

    scroll := ScrollView {
        vertical-stretch: 1;
        preferred-height: body.preferred-height;

        body := VerticalLayout {
            padding: Theme.space-xl;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: @tr("Changes by agents");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            Text {
                text: @tr("Newest first. A written change can be undone for 30 days.");
                color: Theme.colors.text-muted;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }

            for entry[index] in AgentState.history: VerticalLayout {
                // A line between changes.
                if index > 0: Rectangle {
                    height: 1px;
                    background: Theme.colors.surface;
                }

                HorizontalLayout {
                    spacing: Theme.space-xl;
                    padding-top: Theme.space-m;
                    padding-bottom: Theme.space-m;

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: entry.kind == ChangeKind.playlist ? @tr("Delete the playlist “{}”", entry.playlist)
                                : entry.kind == ChangeKind.undo ? @tr("Undo tags in {n} file" | "Undo tags in {n} files" % entry.files)
                                : entry.kind == ChangeKind.labels && entry.files == 0 ? @tr("New labels")
                                : entry.kind == ChangeKind.labels ? @tr("Labels of {n} track" | "Labels of {n} tracks" % entry.files)
                                : entry.kind == ChangeKind.label-undo && entry.files == 0 ? @tr("Undo new labels")
                                : entry.kind == ChangeKind.label-undo ? @tr("Undo labels on {n} track" | "Undo labels on {n} tracks" % entry.files)
                                : @tr("Tags of {n} file" | "Tags of {n} files" % entry.files);
                            color: Theme.colors.text;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }
                        Text {
                            text: @tr("Asked by {0} {1}, {2}", AgentWords.asked-by(entry.agent), AgentWords.age(entry.minutes-ago), AgentWords.status-text(entry.status));
                            color: Theme.colors.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }
                    }

                    if entry.status == ChangeStatus.pending: VerticalLayout {
                        alignment: center;

                        Button {
                            text: @tr("Review");
                            label: @tr("Review the change asked by {}", AgentWords.asked-by(entry.agent));
                            clicked => {
                                root.review(entry.id, false);
                            }
                        }
                    }
                    if entry.can-undo: VerticalLayout {
                        alignment: center;

                        Button {
                            text: @tr("Undo…");
                            label: @tr("Undo the change asked by {}", AgentWords.asked-by(entry.agent));
                            clicked => {
                                root.review(entry.id, true);
                            }
                        }
                    }
                }
            }
        }
    }

    // Marks where the list scrolls under the foot, when it doesn't fit.
    Rectangle {
        height: 1px;

        Rectangle {
            visible: scroll.content-height > scroll.visible-height;
            background: Theme.colors.surface;
        }
    }

    HorizontalLayout {
        padding: Theme.space-xl;
        padding-top: Theme.space-l;
        alignment: start;

        Button {
            property <int> first: root.wrap-first;
            property <int> last: root.wrap-last;
            changed first => {
                self.focus();
            }
            changed last => {
                self.focus();
            }
            text: @tr("Close");
            label: @tr("Close the changes by agents");
            init => {
                self.focus();
            }
            clicked => {
                root.close();
            }
        }
    }
}

// One value in the review's table: text, or for a cover its image.
component ChangeValue inherits VerticalLayout {
    in property <ChangeRow> change;
    // The value after the change, rather than before.
    in property <bool> after;

    private property <string> value: root.after ? root.change.after : root.change.before;
    private property <bool> has-cover: root.after ? root.change.has-after-cover : root.change.has-before-cover;

    alignment: start;

    if root.change.field == ChangeField.cover && root.has-cover: HorizontalLayout {
        alignment: start;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: Theme.radius-m;
            clip: true;
            background: Theme.colors.surface;
            accessible-role: image;
            accessible-label: root.after ? @tr("After: the new cover") : @tr("Before: the cover it had");

            Image {
                width: parent.width;
                height: parent.height;
                source: root.after ? root.change.after-cover : root.change.before-cover;
                image-fit: ImageFit.cover;
                accessible-role: none;
            }
        }
    }
    if root.change.field == ChangeField.cover && !root.has-cover: Text {
        text: root.after ? @tr("Removed") : @tr("No cover");
        color: root.after ? Theme.colors.text : Theme.colors.text-muted;
        font-size: Theme.font-body;
        wrap: word-wrap;
        min-height: self.preferred-height;
        accessible-label: root.after ? @tr("After: removed") : @tr("Before: no cover");
    }
    if root.change.field == ChangeField.label: Text {
        text: root.value != "" ? @tr("On") : @tr("Not on");
        color: root.after ? Theme.colors.text : Theme.colors.text-muted;
        font-size: Theme.font-body;
        wrap: word-wrap;
        min-height: self.preferred-height;
        accessible-label: root.after ? (root.value == "" ? @tr("After: not on the track") : @tr("After: on the track"))
            : (root.value == "" ? @tr("Before: not on the track") : @tr("Before: on the track"));
    }
    if root.change.field != ChangeField.cover && root.change.field != ChangeField.label: Text {
        text: root.value != "" ? root.value : root.after ? @tr("Removed") : @tr("Not set");
        color: root.after ? Theme.colors.text : Theme.colors.text-muted;
        font-size: Theme.font-body;
        wrap: word-wrap;
        min-height: self.preferred-height;
        accessible-label: root.after ? (root.value == "" ? @tr("After: removed") : @tr("After: {}", root.value))
            : (root.value == "" ? @tr("Before: not set") : @tr("Before: {}", root.value));
    }
}

// The review's columns: the field's name, then its value before and after, each
// half of the rest, so they line up from row to row and file to file.
global ChangeColumns {
    out property <length> field: 120px;
    out property <length> gap: Theme.space-m;
    public pure function value(width: length) -> length {
        (width - self.field - 2 * self.gap) / 2
    }
}

// "Before" and "After" over the review's columns.
component ChangeHeadings inherits HorizontalLayout {
    // The width the columns share, from outside: the layout's own would loop.
    in property <length> table-width;

    spacing: ChangeColumns.gap;

    Rectangle {
        width: ChangeColumns.field;
    }
    Text {
        width: ChangeColumns.value(root.table-width);
        text: @tr("Before");
        color: Theme.colors.text-muted;
        font-size: Theme.font-small;
        font-weight: Theme.weight-strong;
        accessible-role: none;
    }
    Text {
        width: ChangeColumns.value(root.table-width);
        text: @tr("After");
        color: Theme.colors.text-muted;
        font-size: Theme.font-small;
        font-weight: Theme.weight-strong;
        accessible-role: none;
    }
}

// The changes of one file (or those every file shares) under a heading: the field,
// its value before, and after.
component ChangeTable inherits VerticalLayout {
    in property <string> heading;
    // The file's name after the heading, muted; empty for the shared changes.
    in property <string> file;
    in property <[ChangeRow]> rows;
    // The width the columns share, from outside: the layout's own would loop.
    in property <length> table-width;

    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-s;
        padding-bottom: Theme.space-xs;

        Text {
            horizontal-stretch: 0;
            max-width: self.preferred-width;
            text: root.heading;
            color: Theme.colors.text;
            font-size: Theme.font-body;
            font-weight: Theme.weight-strong;
            overflow: elide;
        }
        if root.file != "": Text {
            horizontal-stretch: 1;
            text: root.file;
            color: Theme.colors.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    for row in root.rows: HorizontalLayout {
        spacing: ChangeColumns.gap;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;

        Text {
            width: ChangeColumns.field;
            text: AgentWords.field-name(row);
            color: Theme.colors.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
        ChangeValue {
            width: ChangeColumns.value(root.table-width);
            change: row;
        }
        ChangeValue {
            width: ChangeColumns.value(root.table-width);
            change: row;
            after: true;
        }
    }
}

// The review of one change, a dialog like the tag editor: what the agent asks, then
// Accept, Reject, or Decide later, which leaves the change waiting. The focus starts
// on Decide later, so an Enter pressed by accident writes nothing. While the files
// are written only the progress shows; afterwards, what was left as it was.
export component ChangeReview inherits Modal {
    private property <bool> waiting: AgentState.review-status == ReviewStatus.waiting;
    private property <bool> writing: AgentState.review-status == ReviewStatus.writing;
    private property <bool> done: AgentState.review-status == ReviewStatus.done;
    private property <bool> blocked: AgentState.review-playing != "";
    private property <ChangeKind> kind: AgentState.review-kind;
    // The changes' columns span the card inside its padding.
    private property <length> table-width: root.shown-width - 2 * Theme.space-xl;
    // Tab went past the last control, or Shift+Tab before the first.
    private property <int> wrap-first;
    private property <int> wrap-last;
    private property <bool> labels: root.kind == ChangeKind.labels || root.kind == ChangeKind.label-undo;
    // A change of labels, or its undo, that changes no track: it only makes labels.
    private property <bool> no-tracks: root.labels && AgentState.review-files == 0;
    private property <string> title-text: root.kind == ChangeKind.playlist ? @tr("Delete a playlist?")
        : root.kind == ChangeKind.undo || root.kind == ChangeKind.label-undo ? @tr("Review an undo")
        : root.kind == ChangeKind.labels ? @tr("Review label changes") : @tr("Review tag changes");

    label: root.title-text;
    card-width: Theme.dialog-width;
    // A click beside the dialog does nothing, as beside the tag editor.
    escape => {
        if !root.writing {
            AgentState.close-review();
        }
    }
    focus-first => {
        root.wrap-first += 1;
    }
    focus-last => {
        root.wrap-last += 1;
    }

    scroll := ScrollView {
        vertical-stretch: 1;
        preferred-height: body.preferred-height;

        body := VerticalLayout {
            padding: Theme.space-xl;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-xl;
            alignment: start;

            VerticalLayout {
                spacing: Theme.space-s;

                Text {
                    text: root.title-text;
                    color: Theme.colors.text;
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-strong;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                Text {
                    text: @tr("Asked by {}", AgentWords.asked-by(AgentState.review-agent));
                    color: Theme.colors.text;
                    font-size: Theme.font-heading;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                if !root.done: Text {
                    text: root.kind == ChangeKind.playlist ? @tr("The playlist “{}” would be deleted. Its tracks stay in your library.", AgentState.review-playlist)
                        : root.kind == ChangeKind.undo ? @tr("The tags below are put back into {n} file. A file whose tags changed since is left as it was." | "The tags below are put back into {n} files. A file whose tags changed since is left as it was." % AgentState.review-files)
                        : root.kind == ChangeKind.label-undo && root.no-tracks ? @tr("The change only made labels. Undoing it deletes them, except any a track holds by then.")
                        : root.kind == ChangeKind.label-undo ? @tr("The labels below are put back as they were on {n} track. A track whose labels changed since is left as it was." | "The labels below are put back as they were on {n} tracks. A track whose labels changed since is left as it was." % AgentState.review-files)
                        : root.no-tracks ? @tr("This change only makes labels, for no track yet. Labels stay in VCMP, so no file is written, and the change can be undone for 30 days.")
                        : root.kind == ChangeKind.labels ? @tr("The labels below would be put on or taken off {n} track. Labels stay in VCMP, so no file is written. A track whose labels changed since the agent looked is left as it was, and the change can be undone for 30 days." | "The labels below would be put on or taken off {n} tracks. Labels stay in VCMP, so no file is written. A track whose labels changed since the agent looked is left as it was, and the change can be undone for 30 days." % AgentState.review-files)
                        : @tr("The tags below would be written into {n} file. A file whose tags changed since the agent looked is left as it was, and a written change can be undone for 30 days." | "The tags below would be written into {n} files. A file whose tags changed since the agent looked is left as it was, and a written change can be undone for 30 days." % AgentState.review-files);
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                // The warning the owner asked for: said plainly, before the button.
                if root.kind == ChangeKind.playlist && !root.done: Text {
                    text: @tr("Deleting a playlist can't be undone.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-strong;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }

            // Each file's changes, with their values before and after; what every
            // file gets comes first, once.
            if root.kind != ChangeKind.playlist && !root.done: VerticalLayout {
                spacing: Theme.space-l;

                if AgentState.review-new-labels != "": Text {
                    text: @tr("New labels it makes: {}", AgentState.review-new-labels);
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                if root.kind == ChangeKind.label-undo && AgentState.review-gone-labels != "": Text {
                    text: @tr("Labels it deletes, unless a track holds them by then: {}", AgentState.review-gone-labels);
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }

                if !root.no-tracks: ChangeHeadings {
                    table-width: root.table-width;
                }

                if AgentState.review-shared.length > 0: ChangeTable {
                    heading: root.labels ? @tr("On all {} tracks", AgentState.review-files) : @tr("In all {} files", AgentState.review-files);
                    rows: AgentState.review-shared;
                    table-width: root.table-width;
                }

                for group in AgentState.review-groups: VerticalLayout {
                    spacing: Theme.space-l;

                    Rectangle {
                        height: 1px;
                        background: Theme.colors.surface;
                    }
                    ChangeTable {
                        heading: group.title;
                        file: group.file;
                        rows: group.rows;
                        table-width: root.table-width;
                    }
                }
            }

            // What the accepted change did.
            if root.done: VerticalLayout {
                spacing: Theme.space-s;

                Text {
                    text: AgentState.review-failed ? @tr("The library could not be read or written, so nothing was changed.")
                        : root.kind == ChangeKind.playlist ? @tr("The playlist is deleted.")
                        : root.kind == ChangeKind.label-undo && root.no-tracks ? @tr("The change is undone.")
                        : root.no-tracks ? @tr("Made {n} label." | "Made {n} labels." % AgentState.review-new-label-count)
                        : root.labels && AgentState.review-problems.length == 0 ? @tr("Changed on {n} track." | "Changed on {n} tracks." % AgentState.review-written)
                        : root.labels ? @tr("Changed on {n} track. These tracks were left as they were:" | "Changed on {n} tracks. These tracks were left as they were:" % AgentState.review-written)
                        : AgentState.review-problems.length == 0 ? @tr("Written into {n} file." | "Written into {n} files." % AgentState.review-written)
                        : @tr("Written into {n} file. These files were left as they were:" | "Written into {n} files. These files were left as they were:" % AgentState.review-written);
                    color: AgentState.review-failed ? Theme.colors.error : Theme.colors.text;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-strong;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                for problem in AgentState.review-problems: VerticalLayout {
                    Text {
                        text: problem.file;
                        color: Theme.colors.text;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    Text {
                        text: root.labels ? @tr("Its labels changed since the change was asked for.")
                            : problem.conflict ? @tr("Its tags changed since the change was asked for.") : @tr("Its tags could not be written.");
                        color: Theme.colors.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
            }
        }
    }

    // Marks where the list scrolls under the foot, when it doesn't fit.
    Rectangle {
        height: 1px;

        Rectangle {
            visible: scroll.content-height > scroll.visible-height;
            background: Theme.colors.surface;
        }
    }

    VerticalLayout {
        padding: Theme.space-xl;
        padding-top: Theme.space-l;
        spacing: Theme.space-l;

        if root.writing: VerticalLayout {
            spacing: Theme.space-s;

            Text {
                text: root.labels ? @tr("Changing labels: {0} of {1} tracks", AgentState.review-done, AgentState.review-files)
                    : @tr("Writing tags: {0} of {1} files", AgentState.review-done, AgentState.review-files);
                color: Theme.colors.text;
                font-size: Theme.font-body;
            }
            ProgressBar {
                progress: AgentState.review-files > 0 ? AgentState.review-done / AgentState.review-files : 0;
                label: @tr("Writing tags");
            }
        }

        // Always in the layout, collapsed while nothing plays: a wrapped text an `if`
        // creates lost its last line.
        Text {
            visible: root.waiting && root.blocked;
            height: self.visible ? self.preferred-height : 0px;
            text: !self.visible ? "" : @tr("{} is playing, and Windows doesn't let VCMP rewrite a file in use. Stop playback or play another track, then accept.", AgentState.review-playing);
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        if !root.done: HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;

            Button {
                property <int> wrap: root.wrap-first;
                changed wrap => {
                    self.focus();
                }
                text: root.kind == ChangeKind.playlist ? @tr("Delete playlist")
                    : root.kind == ChangeKind.undo ? @tr("Undo in {n} file" | "Undo in {n} files" % AgentState.review-files)
                    : root.kind == ChangeKind.label-undo && root.no-tracks ? @tr("Undo")
                    : root.kind == ChangeKind.label-undo ? @tr("Undo on {n} track" | "Undo on {n} tracks" % AgentState.review-files)
                    : root.no-tracks ? @tr("Make {n} label" | "Make {n} labels" % AgentState.review-new-label-count)
                    : root.kind == ChangeKind.labels ? @tr("Change {n} track" | "Change {n} tracks" % AgentState.review-files)
                    : @tr("Write {n} file" | "Write {n} files" % AgentState.review-files);
                // Filled for writing tags, which can be undone; not for deleting a
                // playlist, which can't.
                primary: root.kind != ChangeKind.playlist;
                enabled: root.waiting && !root.blocked;
                clicked => {
                    AgentState.accept();
                }
            }
            Button {
                text: @tr("Reject");
                label: @tr("Reject the change; nothing is written");
                enabled: root.waiting;
                clicked => {
                    AgentState.reject();
                }
            }
            Button {
                property <int> wrap: root.wrap-last;
                changed wrap => {
                    self.focus();
                }
                text: @tr("Decide later");
                label: @tr("Close; the change keeps waiting for your review");
                enabled: root.waiting;
                init => {
                    self.focus();
                }
                clicked => {
                    AgentState.close-review();
                }
            }
        }

        if root.done: HorizontalLayout {
            alignment: start;

            Button {
                property <int> first: root.wrap-first;
                property <int> last: root.wrap-last;
                changed first => {
                    self.focus();
                }
                changed last => {
                    self.focus();
                }
                text: @tr("Close");
                init => {
                    self.focus();
                }
                clicked => {
                    AgentState.close-review();
                }
            }
        }
    }
}
