import { Theme } from "theme.slint";
import { Button, Modal, ProgressBar, ScrollArea, TextField } from "components.slint";

// The tags the editor shows and saves, as text. Numbers are checked when saved.
export struct TagValues {
    title: string,
    artist: string,
    album: string,
    album-artist: string,
    track: string,
    disc: string,
    year: string,
    genre: string,
}

// The fields whose value differs between the tracks edited together. Such a field
// starts empty and keeps each track's own value unless something is typed in it.
export struct TagMixed {
    artist: bool,
    album: bool,
    album-artist: bool,
    disc: bool,
    year: bool,
    genre: bool,
    cover: bool,
}

// `waiting`: saved, except for the file the player has open, which is written once
// the player lets go of it (Windows can't replace an open file).
export enum TagEditorStatus { editing, writing, waiting, failed }

// What is wrong with the values; the field they belong to says so.
export enum TagProblem { none, track, disc, year, line-break, cover }

// Why a file kept its old tags.
export enum TagFailureReason { unavailable, read-only, unreadable, write, verify, changed, replace }

export struct TagFailure {
    file: string,
    reason: TagFailureReason,
}

export enum TagField { title, artist, album, album-artist, track, disc, year, genre, cover }

// One changed field, as the list before a write to several files shows it.
export struct TagChange {
    field: TagField,
    // The new value; empty for a cover, which the list shows from `TagEditorState.cover`.
    value: string,
    // The tag is taken away instead.
    removed: bool,
}

// The tag editor: one track's tags, or an album's at once. src/tag_editor.rs fills it
// in and implements the callbacks.
export global TagEditorState {
    in-out property <bool> open;
    // How many tracks are edited; one shows the title and track number too.
    in property <int> track-count;
    // What is edited: the track's or album's title (empty for tracks of several
    // albums), and its artist.
    in property <string> subject;
    // Every track of the album page's album, rather than a selection of tracks.
    in property <bool> whole-album;
    in property <string> subject-artist;
    // The values as the files have them; empty where they differ (`mixed`).
    in property <TagValues> values;
    in property <TagMixed> mixed;
    // The cover the files will have: as they are, or as chosen here.
    in property <bool> has-cover;
    in property <image> cover;
    in property <TagEditorStatus> status;
    // Files written so far, while writing.
    in property <int> done;
    in property <TagProblem> problem;
    in property <[TagFailure]> failures;
    // The file of an edited track whose new tags wait for the player to let go of it.
    in property <string> waiting-file;
    // Saving would write to more than one file, so the editor lists the changes and
    // waits for `confirm` or `back`.
    in property <bool> confirming;
    // How many files `confirm` writes.
    in property <int> confirm-files;
    in property <[TagChange]> changes;
    // Opens the editor for the track with this file path, or for the album page's album.
    callback edit-track(string);
    callback edit-album();
    // Chooses an image file as the cover, or takes the cover away.
    callback choose-cover();
    callback remove-cover();
    // Writes the values that changed to every file; for several files, once confirmed.
    callback save(TagValues);
    callback confirm();
    // Leaves the list of changes for the form, writing nothing.
    callback back();
    callback cancel();
}

component TagInput inherits VerticalLayout {
    in property <string> label;
    in property <bool> mixed;
    in property <bool> wrong;
    // The field takes the focus as it is made.
    in property <bool> takes-focus;
    in-out property <string> text;
    // Tab came round to this field: each change of `wrap` focuses it while `wraps` is set.
    in property <int> wrap;
    in property <bool> wraps;
    callback accepted();

    init => {
        if root.takes-focus {
            field.focus-text();
        }
    }
    changed wrap => {
        if root.wraps {
            field.focus-text();
        }
    }

    spacing: Theme.space-xs;

    Text {
        text: root.label;
        color: root.wrong ? Theme.colors.error : Theme.colors.text;
        font-size: Theme.font-small;
        font-weight: root.wrong ? Theme.weight-strong : Theme.weight-regular;
        accessible-role: none;
    }

    field := TextField {
        label: root.label;
        placeholder: root.mixed ? @tr("Several values") : "";
        text <=> root.text;
        accepted => {
            root.accepted();
        }
        cancelled => {
            TagEditorState.cancel();
        }
    }
}

// A dialog over the sidebar and pages, like the cover picker. Enter in a field saves;
// Escape or Cancel closes without writing. A save to several files first lists the
// changes in place of the form, with the focus on Back; Escape goes back too. The
// form scrolls in a short window, and the buttons stay at the foot of the dialog.
export component TagEditorView inherits Modal {
    private property <bool> single: TagEditorState.track-count == 1;
    private property <bool> writing: TagEditorState.status == TagEditorStatus.writing;
    private property <bool> waiting: TagEditorState.status == TagEditorStatus.waiting;
    private property <bool> confirming: TagEditorState.confirming;
    // What has the focus when the form is made: at first the first field, and after
    // Back from the list of changes what saved (0 to 7 the fields in form order, 8 the
    // Save button).
    private property <int> focus-index: root.single ? 0 : 1;
    // Where the form was scrolled to before the list of changes took its place.
    private property <length> form-scroll;
    // Tab went past the last control, or Shift+Tab before the first: each change sends
    // the focus to the control at the other end. While the tags are written, only the
    // fields take it.
    private property <int> wrap-first;
    private property <int> wrap-last;
    private property <TagMixed> mixed: TagEditorState.mixed;
    private property <TagProblem> problem: TagEditorState.problem;
    private property <string> title-text: TagEditorState.values.title;
    private property <string> artist-text: TagEditorState.values.artist;
    private property <string> album-text: TagEditorState.values.album;
    private property <string> album-artist-text: TagEditorState.values.album-artist;
    private property <string> track-text: TagEditorState.values.track;
    private property <string> disc-text: TagEditorState.values.disc;
    private property <string> year-text: TagEditorState.values.year;
    private property <string> genre-text: TagEditorState.values.genre;

    function save(from: int) {
        if !root.writing && !root.waiting && !root.confirming {
            root.focus-index = from;
            TagEditorState.save({
                title: root.title-text,
                artist: root.artist-text,
                album: root.album-text,
                album-artist: root.album-artist-text,
                track: root.track-text,
                disc: root.disc-text,
                year: root.year-text,
                genre: root.genre-text,
            });
        }
    }

    // The list of changes starts at the top; Back returns to the form where it was.
    changed confirming => {
        if root.confirming {
            root.form-scroll = scroll.content-y;
            scroll.content-y = 0;
        } else {
            scroll.content-y = root.form-scroll;
        }
    }

    label: @tr("Edit tags");
    card-width: Theme.dialog-width;
    // A click beside the dialog does nothing: it would lose what was typed.
    escape => {
        if root.confirming {
            TagEditorState.back();
        } else {
            TagEditorState.cancel();
        }
    }
    focus-first => {
        root.wrap-first += 1;
    }
    focus-last => {
        root.wrap-last += 1;
    }

    scroll := ScrollArea {
        vertical-stretch: 1;
        preferred-height: body.preferred-height;

        body := VerticalLayout {
            padding: Theme.space-xl;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-xl;
            alignment: start;

            VerticalLayout {
                spacing: Theme.space-s;

                Text {
                    text: @tr("Edit tags");
                    color: Theme.colors.text;
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-strong;
                }
                Text {
                    text: root.single ? (TagEditorState.subject-artist == "" ? TagEditorState.subject : @tr("{0} by {1}", TagEditorState.subject, TagEditorState.subject-artist))
                        : TagEditorState.whole-album ? (TagEditorState.subject == "" ? @tr("All {} tracks of the Unknown album", TagEditorState.track-count) : @tr("All {0} tracks of {1}", TagEditorState.track-count, TagEditorState.subject))
                        : TagEditorState.subject != "" ? @tr("{0} tracks of {1}", TagEditorState.track-count, TagEditorState.subject)
                        : @tr("{n} selected track" | "{n} selected tracks" % TagEditorState.track-count);
                    color: Theme.colors.text;
                    font-size: Theme.font-heading;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                Text {
                    text: root.confirming ? @tr("The tags below will be written into {n} file. Tags not listed stay as each file has them." | "The tags below will be written into {n} files. Tags not listed stay as each file has them." % TagEditorState.confirm-files)
                        : root.single ? @tr("The tags are written into the file, then read back to check them. An empty field removes its tag.")
                        : @tr("What you change is written into every track. A field showing “Several values” keeps each track's own unless you type one.");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }

            if !root.confirming: HorizontalLayout {
                spacing: Theme.space-xl;

                // The cover, and the ways to change it.
                VerticalLayout {
                    spacing: Theme.space-m;
                    alignment: start;

                    Rectangle {
                        width: 160px;
                        height: 160px;
                        border-radius: Theme.radius-l;
                        clip: true;
                        background: Theme.colors.surface;

                        if TagEditorState.has-cover: Image {
                            width: parent.width;
                            height: parent.height;
                            source: TagEditorState.cover;
                            image-fit: ImageFit.cover;
                            accessible-role: none;
                        }
                        if !TagEditorState.has-cover: Text {
                            width: parent.width - 2 * Theme.space-m;
                            text: root.mixed.cover ? @tr("Several covers") : @tr("No cover");
                            color: Theme.colors.text-muted;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }
                    }

                    // The form's first control.
                    Button {
                        property <int> wrap: root.wrap-first;
                        changed wrap => {
                            if !root.writing {
                                self.focus();
                            }
                        }
                        text: @tr("Choose image…");
                        label: @tr("Choose a cover image");
                        enabled: !root.writing;
                        clicked => {
                            TagEditorState.choose-cover();
                        }
                    }
                    if TagEditorState.has-cover || root.mixed.cover: Button {
                        text: @tr("Remove cover");
                        enabled: !root.writing;
                        clicked => {
                            TagEditorState.remove-cover();
                        }
                    }
                }

                // The fields take the rest of the dialog's width.
                VerticalLayout {
                    spacing: Theme.space-m;
                    horizontal-stretch: 1;

                    if root.single: TagInput {
                        takes-focus: root.focus-index == 0;
                        wrap: root.wrap-first;
                        wraps: root.writing;
                        label: @tr("Title");
                        text <=> root.title-text;
                        accepted => {
                            root.save(0);
                        }
                    }
                    TagInput {
                        takes-focus: root.focus-index == 1;
                        wrap: root.wrap-first;
                        wraps: root.writing && !root.single;
                        label: @tr("Artist");
                        mixed: root.mixed.artist;
                        text <=> root.artist-text;
                        accepted => {
                            root.save(1);
                        }
                    }
                    TagInput {
                        takes-focus: root.focus-index == 2;
                        label: @tr("Album");
                        mixed: root.mixed.album;
                        text <=> root.album-text;
                        accepted => {
                            root.save(2);
                        }
                    }
                    TagInput {
                        takes-focus: root.focus-index == 3;
                        label: @tr("Album artist");
                        mixed: root.mixed.album-artist;
                        text <=> root.album-artist-text;
                        accepted => {
                            root.save(3);
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-m;

                        if root.single: TagInput {
                            // Equal widths, whatever they hold.
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            takes-focus: root.focus-index == 4;
                            label: @tr("Track");
                            wrong: root.problem == TagProblem.track;
                            text <=> root.track-text;
                            accepted => {
                                root.save(4);
                            }
                        }
                        TagInput {
                            // Equal widths, whatever they hold.
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            takes-focus: root.focus-index == 5;
                            label: @tr("Disc");
                            mixed: root.mixed.disc;
                            wrong: root.problem == TagProblem.disc;
                            text <=> root.disc-text;
                            accepted => {
                                root.save(5);
                            }
                        }
                        TagInput {
                            // Equal widths, whatever they hold.
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            takes-focus: root.focus-index == 6;
                            label: @tr("Year");
                            mixed: root.mixed.year;
                            wrong: root.problem == TagProblem.year;
                            text <=> root.year-text;
                            accepted => {
                                root.save(6);
                            }
                        }
                    }

                    TagInput {
                        takes-focus: root.focus-index == 7;
                        wrap: root.wrap-last;
                        wraps: root.writing;
                        label: @tr("Genre");
                        mixed: root.mixed.genre;
                        text <=> root.genre-text;
                        accepted => {
                            root.save(7);
                        }
                    }
                }
            }

            // In place of the form while a save to several files waits to be
            // confirmed: each changed field, labelled as in the form, in form order.
            if root.confirming: VerticalLayout {
                spacing: Theme.space-m;

                for change in TagEditorState.changes: VerticalLayout {
                    spacing: Theme.space-xs;

                    Text {
                        text: change.field == TagField.title ? @tr("Title")
                            : change.field == TagField.artist ? @tr("Artist")
                            : change.field == TagField.album ? @tr("Album")
                            : change.field == TagField.album-artist ? @tr("Album artist")
                            : change.field == TagField.track ? @tr("Track")
                            : change.field == TagField.disc ? @tr("Disc")
                            : change.field == TagField.year ? @tr("Year")
                            : change.field == TagField.genre ? @tr("Genre")
                            : @tr("Cover");
                        color: Theme.colors.text-muted;
                        font-size: Theme.font-small;
                    }
                    // The cover that will be written, as the form showed it.
                    if change.field == TagField.cover && !change.removed: Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: Theme.radius-m;
                        clip: true;
                        background: Theme.colors.surface;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: TagEditorState.cover;
                            image-fit: ImageFit.cover;
                            accessible-role: image;
                            accessible-label: @tr("The new cover");
                        }
                    }
                    // Muted and worded, so a removal doesn't read as a value.
                    if change.field != TagField.cover || change.removed: Text {
                        text: change.removed ? @tr("Removed") : change.value;
                        color: change.removed ? Theme.colors.text-muted : Theme.colors.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
            }

            // The files that kept their old tags, each with the reason.
            if TagEditorState.status == TagEditorStatus.failed && !root.confirming: VerticalLayout {
                spacing: Theme.space-s;

                Text {
                    text: TagEditorState.waiting-file == "" ? @tr("These files kept their old tags. The others were written.") : @tr("These files kept their old tags.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-strong;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                for failure in TagEditorState.failures: VerticalLayout {
                    Text {
                        text: failure.file;
                        color: Theme.colors.text;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    Text {
                        text: failure.reason == TagFailureReason.unavailable ? @tr("The file isn't there now.")
                            : failure.reason == TagFailureReason.read-only ? @tr("The file is read-only.")
                            : failure.reason == TagFailureReason.unreadable ? @tr("Its tags could not be read.")
                            : failure.reason == TagFailureReason.write ? @tr("The tags could not be written.")
                            : failure.reason == TagFailureReason.verify ? @tr("The written tags didn't read back right, so the file was left as it was.")
                            : failure.reason == TagFailureReason.changed ? @tr("The file changed while it was written, so it was left as it was.")
                            : @tr("The file could not be replaced. Another program, or VCMP playing it, may be using it.");
                        color: Theme.colors.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
            }
        }
    }

    // Marks where the form scrolls under the foot, when it doesn't fit.
    Rectangle {
        height: 1px;

        Rectangle {
            visible: scroll.content-height > scroll.visible-height;
            background: Theme.colors.surface;
        }
    }

    // The foot, in view however the form is scrolled: what keeps the tags from being
    // written, the progress, and the buttons.
    VerticalLayout {
        padding: Theme.space-xl;
        padding-top: Theme.space-l;
        spacing: Theme.space-l;

        // Why nothing was written yet: one sentence for the wrong value.
        if root.problem != TagProblem.none: Text {
            text: root.problem == TagProblem.track ? @tr("The track number must be a whole number, like 3.")
                : root.problem == TagProblem.disc ? @tr("The disc number must be a whole number, like 1.")
                : root.problem == TagProblem.year ? @tr("The year must be a number from 1 to 9999.")
                : root.problem == TagProblem.line-break ? @tr("Tags are one line each, so they can't hold line breaks or other control characters.")
                : @tr("That file isn't a JPEG or PNG image VCMP can read, so the cover stays as it was.");
            color: Theme.colors.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }

        if root.writing: VerticalLayout {
            spacing: Theme.space-s;

            Text {
                text: @tr("Writing tags: {0} of {1} files", TagEditorState.done, TagEditorState.track-count);
                color: Theme.colors.text;
                font-size: Theme.font-body;
            }
            ProgressBar {
                progress: TagEditorState.track-count > 0 ? TagEditorState.done / TagEditorState.track-count : 0;
                label: @tr("Writing tags");
            }
        }

        // Why one file still has its old tags (the player has it open), above the
        // buttons. Always in the layout and collapsed while nothing waits: a wrapped
        // text that an `if` creates gets its height before its width, and its last
        // line was cut off.
        VerticalLayout {
            spacing: TagEditorState.waiting-file == "" ? 0px : Theme.space-l;

            Text {
                visible: TagEditorState.waiting-file != "";
                height: self.visible ? self.preferred-height : 0px;
                text: !self.visible ? "" : root.waiting && !root.single ? @tr("{0} is in use by the player, so its new tags will be written when playback stops or the next track starts. The other tracks have their new tags.", TagEditorState.waiting-file)
                    : @tr("{0} is in use by the player, so its new tags will be written when playback stops or the next track starts.", TagEditorState.waiting-file);
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            if !root.confirming: HorizontalLayout {
                spacing: Theme.space-m;
                alignment: start;

                // Once only the waiting file is left, there is nothing more to save.
                if !root.waiting: Button {
                    text: TagEditorState.status == TagEditorStatus.failed ? @tr("Try again") : @tr("Save");
                    label: TagEditorState.status == TagEditorStatus.failed ? @tr("Write the tags again") : @tr("Save the tags");
                    primary: true;
                    enabled: !root.writing;
                    init => {
                        if root.focus-index == 8 {
                            self.focus();
                        }
                    }
                    clicked => {
                        root.save(8);
                    }
                }
                // The form's last control.
                Button {
                    property <int> wrap: root.wrap-last;
                    changed wrap => {
                        if !root.writing {
                            self.focus();
                        }
                    }
                    text: TagEditorState.status == TagEditorStatus.failed || root.waiting ? @tr("Close") : @tr("Cancel");
                    primary: root.waiting;
                    enabled: !root.writing;
                    clicked => {
                        TagEditorState.cancel();
                    }
                }
            }

            // The focus starts on Back, as on any question before a change that is
            // hard to undo: an Enter pressed twice by accident goes back to the form
            // instead of writing.
            if root.confirming: HorizontalLayout {
                spacing: Theme.space-m;
                alignment: start;

                Button {
                    property <int> wrap: root.wrap-first;
                    changed wrap => {
                        self.focus();
                    }
                    text: @tr("Write {n} file" | "Write {n} files" % TagEditorState.confirm-files);
                    primary: true;
                    clicked => {
                        TagEditorState.confirm();
                    }
                }
                Button {
                    property <int> wrap: root.wrap-last;
                    changed wrap => {
                        self.focus();
                    }
                    text: @tr("Back");
                    label: @tr("Back to editing");
                    init => {
                        self.focus();
                    }
                    clicked => {
                        TagEditorState.back();
                    }
                }
            }
        }
    }
}
