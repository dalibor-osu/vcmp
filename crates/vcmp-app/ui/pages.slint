import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, ThemeMode } from "theme.slint";
import { Button, Dropdown, FocusRing, SectionHeading, SegmentedChoice, SettingRow, Toggle } from "components.slint";
import { LibraryState } from "library-state.slint";
import { LibrarySection } from "library-settings.slint";
import { PlayerState, ShuffleKind } from "player-state.slint";
import { AlbumGrid, AlbumTile } from "album-grid.slint";
import { AlbumDetail, AlbumView, TrackRow } from "album-page.slint";

// Shared page frame: title plus content, fading in when the page is opened.
component Page inherits VerticalLayout {
    in property <string> title;

    opacity: 0;
    init => {
        self.opacity = 1;
    }
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }

    padding: Theme.space-xxl;
    spacing: Theme.space-xl;
    alignment: start;

    Text {
        text: root.title;
        color: Theme.colors.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-strong;
    }

    @children
}


export component SettingsPage inherits Page {
    title: @tr("Settings");

    // Devices come and go; list them each time the page opens.
    init => {
        PlayerState.refresh-output-devices();
    }

    LibrarySection {
        max-width: Theme.content-max-width;
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SettingRow {
            title: @tr("Update automatically");
            description: @tr("Scan the music folders when VCMP starts, and whenever their contents change.");

            Toggle {
                label: @tr("Update automatically");
                checked: LibraryState.auto-update;
                toggled(on) => {
                    LibraryState.set-auto-update(on);
                }
            }
        }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: @tr("Playback");
        }

        SettingRow {
            title: @tr("Shuffle");
            description: @tr("Fewer repeats plays every track once before any comes back, and keeps the same artist apart. Fully random may play a track again soon.");

            SegmentedChoice {
                label: @tr("Shuffle");
                segment-min: 128px;
                options: [@tr("Fewer repeats"), @tr("Fully random")];
                current-index: PlayerState.shuffle-kind == ShuffleKind.true-random ? 1 : 0;
                selected(index) => {
                    PlayerState.set-shuffle-kind(index == 1 ? ShuffleKind.true-random : ShuffleKind.fewer-repeats);
                }
            }
        }

        SettingRow {
            title: @tr("Output device");
            description: PlayerState.output-fallback != "" ? @tr("The chosen device isn't connected, so sound plays through {} until it is.", PlayerState.output-fallback)
                : @tr("Where VCMP plays its sound. The system default follows your operating system's choice.");

            Dropdown {
                label: @tr("Output device");
                first-option: @tr("System default");
                options: PlayerState.output-devices;
                current-index: PlayerState.output-device;
                selected(index) => {
                    PlayerState.set-output-device(index);
                }
                opening => {
                    PlayerState.refresh-output-devices();
                }
            }
        }

        if PlayerState.discord-available: SettingRow {
            title: @tr("Show on Discord");
            description: @tr("While Discord runs, your status shows the track you're listening to and its album cover. For albums without a MusicBrainz ID, the cover is looked up on musicbrainz.org, which receives the album title and artist.");

            Toggle {
                label: @tr("Show on Discord");
                checked: PlayerState.discord;
                toggled(on) => {
                    PlayerState.set-discord(on);
                }
            }
        }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: @tr("Appearance");
        }

        SettingRow {
            title: @tr("Theme");
            description: @tr("Follow the system setting, or always use the light or dark theme.");

            SegmentedChoice {
                label: @tr("Theme");
                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                current-index: Theme.mode == ThemeMode.light ? 1 : Theme.mode == ThemeMode.dark ? 2 : 0;
                selected(index) => {
                    Theme.mode = index == 1 ? ThemeMode.light : index == 2 ? ThemeMode.dark : ThemeMode.system;
                    Theme.preferences-changed();
                }
            }
        }

        SettingRow {
            title: @tr("Reduce motion");
            description: @tr("Turns off transitions, such as fading pages and the moving page marker.");

            Toggle {
                label: @tr("Reduce motion");
                checked: Theme.reduced-motion;
                toggled(on) => {
                    Theme.reduced-motion = on;
                    Theme.preferences-changed();
                }
            }
        }
    }
}

export component AboutPage inherits Page {
    in property <string> version;

    title: @tr("About");

    VerticalLayout {
        spacing: Theme.space-s;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: "VCMP";
        }

        Text {
            text: @tr("Version {}", root.version);
            color: Theme.colors.text-muted;
            font-size: Theme.font-small;
        }

        Text {
            text: @tr("A cross-platform music player for locally stored music.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Licensed under the MIT License or the Apache License 2.0, at your option.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Typeface: Sora by the Sora Project Authors, licensed under the SIL Open Font License 1.1.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
    }

    // The Slint royalty-free license requires showing this widget in the About
    // screen. Its logo follows the operating system's colour scheme rather than
    // VCMP's theme, so it sits on the system palette's own background. The widget
    // opens slint.dev on click only; the focus scope adds the keyboard path.
    VerticalLayout {
        alignment: start;

        Rectangle {
            border-radius: Theme.radius-l;
            background: Palette.background;
            min-height: about.min-height;
            max-width: 320px;
            accessible-role: button;
            accessible-label: @tr("Made with Slint, opens slint.dev");
            accessible-action-default => {
                Platform.open-url("https://slint.dev");
            }

            about := AboutSlint { }

            link-focus := FocusScope {
                focus-on-click: false;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        Platform.open-url("https://slint.dev");
                        return accept;
                    }
                    reject
                }
            }

            if link-focus.has-focus: FocusRing {
                around-width: parent.width;
                around-height: parent.height;
                radius: Theme.radius-l;
            }
        }
    }
}

// Fades a page in that stays alive while hidden: created each time the page is
// shown, it starts in the page background colour and turns transparent.
component FadeCurtain inherits Rectangle {
    background: Theme.colors.base;
    opacity: 1;
    init => {
        self.opacity = 0;
    }
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
}

export component AlbumsPage inherits Rectangle {
    in property <[AlbumTile]> albums;
    in property <AlbumDetail> album;
    in property <[TrackRow]> tracks;
    in property <bool> multi-disc;
    // The page is selected in the sidebar. It stays alive while hidden, so the grid
    // keeps its scroll position.
    in property <bool> shown;
    // Showing one album instead of the grid.
    in-out property <bool> album-open;
    // Plays the open album from a track (-1: from its start), shuffled or not.
    callback play-album(int, bool);
    callback queue-album-track(int, bool);
    // The library database could not be opened or read.
    in property <bool> library-failed;
    callback range-changed(int, int);
    callback activated(int);

    // Shows the grid again, with the album that was open as its current card.
    public function close-album() {
        root.album-open = false;
        grid.focus-album(grid.current);
    }

    changed album-open => {
        if self.album-open {
            view.focus-back();
        }
    }

    visible: root.shown;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        visible: !root.album-open;

        HorizontalLayout {
            padding-left: Theme.space-xxl;
            padding-right: Theme.space-xxl;
            padding-top: Theme.space-xxl;

            Text {
                text: @tr("Albums");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
            }
        }

        // Empty states: why there is nothing to show, and what fills the page.
        if root.albums.length == 0: VerticalLayout {
            padding: Theme.space-xxl;
            spacing: Theme.space-l;
            alignment: start;

            Text {
                text: root.library-failed ? @tr("The music library could not be opened, so no albums can be shown.")
                    : LibraryState.scanning ? @tr("Looking for albums in your music folders. They appear here as they are found.")
                    : LibraryState.folders.length == 0 ? @tr("Your library is empty. Add the folder your music is in, and VCMP finds your albums.")
                    : @tr("No albums found in your music folders. Tracks without an album tag don't appear here.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                max-width: Theme.content-max-width;
            }

            if !root.library-failed && !LibraryState.scanning && LibraryState.folders.length == 0: HorizontalLayout {
                alignment: start;

                Button {
                    text: @tr("Add music folder…");
                    primary: true;
                    clicked => {
                        LibraryState.add-folder();
                    }
                }
            }
        }

        // Kept while an album is open, so its scroll position survives.
        grid := AlbumGrid {
            visible: root.albums.length > 0;
            vertical-stretch: 1;
            albums: root.albums;
            visible-range-changed(first, count) => {
                root.range-changed(first, count);
            }
            activated(index) => {
                root.activated(index);
            }
        }
    }

    view := AlbumView {
        width: parent.width;
        height: parent.height;
        visible: root.album-open;
        playing-path: PlayerState.track-path;
        play(start, shuffle) => {
            root.play-album(start, shuffle);
        }
        queue-track(index, next) => {
            root.queue-album-track(index, next);
        }
        album: root.album;
        tracks: root.tracks;
        multi-disc: root.multi-disc;
        back => {
            root.close-album();
        }
    }

    if root.shown: FadeCurtain { }
}
