import { AboutSlint, Palette, ScrollView } from "std-widgets.slint";
import { ReduceMotion, Theme, ThemeMode } from "theme.slint";
import { Button, Dropdown, FocusRing, SearchField, SectionHeading, SegmentedChoice, SettingRow, Toggle } from "components.slint";
import { LibraryState } from "library-state.slint";
import { AddFolderButton, LibrarySection } from "library-settings.slint";
import { LastfmRow } from "lastfm-settings.slint";
import { LastfmState } from "lastfm-state.slint";
import { PlayerState, ShuffleKind } from "player-state.slint";
import { AlbumGrid, AlbumTile, CardGrid } from "album-grid.slint";
import { AlbumDetail, AlbumView, TrackList, TrackRow } from "album-page.slint";
import { ArtistDetail, ArtistView } from "artist-page.slint";
import { SongColumn, SongRow, SongTable } from "songs-page.slint";
import { FolderBrowser, FolderRow } from "folders-page.slint";
import { UpdateLink, UpdatesSection, UpdateState } from "updates.slint";
import { PlaylistDetail, PlaylistView } from "playlist-page.slint";

// Shared page frame: title plus content, fading in when the page is opened.
component Page inherits VerticalLayout {
    in property <string> title;

    opacity: 0;
    init => {
        self.opacity = 1;
    }
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }

    padding: Theme.space-xxl;
    spacing: Theme.space-xl;
    alignment: start;

    Text {
        text: root.title;
        color: Theme.colors.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-strong;
    }

    @children
}


export component SettingsPage inherits Page {
    title: @tr("Settings");

    // Devices come and go; list them each time the page opens.
    init => {
        PlayerState.refresh-output-devices();
    }

    LibrarySection {
        max-width: Theme.content-max-width;
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SettingRow {
            title: @tr("Update automatically");
            description: @tr("Scan the music folders when VCMP starts, and whenever their contents change.");

            Toggle {
                label: @tr("Update automatically");
                checked: LibraryState.auto-update;
                toggled(on) => {
                    LibraryState.set-auto-update(on);
                }
            }
        }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: @tr("Playback");
        }

        SettingRow {
            title: @tr("Shuffle");
            description: @tr("Fewer repeats plays every track once before any comes back, and keeps the same artist apart. Fully random may play a track again soon.");

            SegmentedChoice {
                label: @tr("Shuffle");
                segment-min: 128px;
                options: [@tr("Fewer repeats"), @tr("Fully random")];
                current-index: PlayerState.shuffle-kind == ShuffleKind.true-random ? 1 : 0;
                selected(index) => {
                    PlayerState.set-shuffle-kind(index == 1 ? ShuffleKind.true-random : ShuffleKind.fewer-repeats);
                }
            }
        }

        SettingRow {
            title: @tr("Output device");
            description: PlayerState.output-fallback != "" ? @tr("The chosen device isn't connected, so sound plays through {} until it is.", PlayerState.output-fallback)
                : @tr("Where VCMP plays its sound. The system default follows your operating system's choice.");

            Dropdown {
                label: @tr("Output device");
                first-option: @tr("System default");
                options: PlayerState.output-devices;
                current-index: PlayerState.output-device;
                selected(index) => {
                    PlayerState.set-output-device(index);
                }
                opening => {
                    PlayerState.refresh-output-devices();
                }
            }
        }

        if PlayerState.discord-available: SettingRow {
            title: @tr("Show on Discord");
            description: @tr("While Discord runs, your status shows the track you're listening to and its album cover. For albums without a MusicBrainz ID, the cover is looked up on musicbrainz.org, which receives the album title and artist.");

            Toggle {
                label: @tr("Show on Discord");
                checked: PlayerState.discord;
                toggled(on) => {
                    PlayerState.set-discord(on);
                }
            }
        }

        if LastfmState.available: LastfmRow { }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: @tr("Appearance");
        }

        SettingRow {
            title: @tr("Theme");
            description: @tr("Follow the system setting, or always use the light or dark theme.");

            SegmentedChoice {
                label: @tr("Theme");
                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                current-index: Theme.mode == ThemeMode.light ? 1 : Theme.mode == ThemeMode.dark ? 2 : 0;
                selected(index) => {
                    Theme.mode = index == 1 ? ThemeMode.light : index == 2 ? ThemeMode.dark : ThemeMode.system;
                    Theme.preferences-changed();
                }
            }
        }

        SettingRow {
            title: @tr("Reduce motion");
            description: @tr("Turns off transitions, such as fading pages and the moving page marker. System follows your operating system's setting where it has one.");

            SegmentedChoice {
                label: @tr("Reduce motion");
                options: [@tr("System"), @tr("On"), @tr("Off")];
                current-index: Theme.motion-choice == ReduceMotion.on ? 1 : Theme.motion-choice == ReduceMotion.off ? 2 : 0;
                selected(index) => {
                    Theme.motion-choice = index == 1 ? ReduceMotion.on : index == 2 ? ReduceMotion.off : ReduceMotion.system;
                    Theme.preferences-changed();
                }
            }
        }
    }

    UpdatesSection {
        max-width: Theme.content-max-width;
    }
}

export component AboutPage inherits Page {
    in property <string> version;

    title: @tr("About");

    VerticalLayout {
        spacing: Theme.space-s;
        max-width: Theme.content-max-width;

        SectionHeading {
            text: "VCMP";
        }

        Text {
            text: @tr("Version {}", root.version);
            color: Theme.colors.text-muted;
            font-size: Theme.font-small;
        }

        // Strong, so it doesn't read as one more line of the description below.
        if UpdateState.available: UpdateLink {
            font-weight: Theme.weight-strong;
        }

        Text {
            text: @tr("A cross-platform music player for locally stored music.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }

        Text {
            text: @tr("Licensed under the MIT License or the Apache License 2.0, at your option.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }

        Text {
            text: @tr("Typeface: Sora by the Sora Project Authors, licensed under the SIL Open Font License 1.1.");
            color: Theme.colors.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }

    // The Slint royalty-free license requires showing this widget in the About
    // screen. Its logo follows the operating system's colour scheme rather than
    // VCMP's theme, so it sits on the system palette's own background. The widget
    // opens slint.dev on click only; the focus scope adds the keyboard path.
    VerticalLayout {
        alignment: start;

        Rectangle {
            border-radius: Theme.radius-l;
            background: Palette.background;
            min-height: about.min-height;
            max-width: 320px;
            accessible-role: button;
            accessible-label: @tr("Made with Slint, opens slint.dev");
            accessible-action-default => {
                Platform.open-url("https://slint.dev");
            }

            about := AboutSlint { }

            link-focus := FocusScope {
                focus-on-click: false;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        Platform.open-url("https://slint.dev");
                        return accept;
                    }
                    reject
                }
            }

            if link-focus.has-focus: FocusRing {
                around-width: parent.width;
                around-height: parent.height;
                radius: Theme.radius-l;
            }
        }
    }
}

// Fades a page in that stays alive while hidden: created each time the page is
// shown, it starts in the page background colour and turns transparent.
component FadeCurtain inherits Rectangle {
    background: Theme.colors.base;
    opacity: 1;
    init => {
        self.opacity = 0;
    }
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
}

export component AlbumsPage inherits Rectangle {
    in property <[AlbumTile]> albums;
    in property <AlbumDetail> album;
    in property <[TrackRow]> tracks;
    in property <bool> multi-disc;
    // The page is selected in the sidebar. It stays alive while hidden, so the grid
    // keeps its scroll position.
    in property <bool> shown;
    // Showing one album instead of the grid.
    in-out property <bool> album-open;
    // The open album came from search, so going back returns there.
    in property <bool> from-search;
    callback back-to-search();
    // Plays the open album from a track (-1: from its start), shuffled or not.
    callback play-album(int, bool);
    callback queue-album-track(int, bool);
    // The library database could not be opened or read.
    in property <bool> library-failed;
    // Narrows the grid to albums whose title or artist holds every typed word.
    in-out property <string> filter;
    callback filter-edited(string);
    callback range-changed(int, int);
    callback activated(int);

    // Shows the grid again, with the album that was open as its current card.
    public function close-album() {
        root.album-open = false;
        grid.focus-album(grid.current);
    }

    changed album-open => {
        if self.album-open {
            view.focus-back();
        }
    }

    visible: root.shown;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        visible: !root.album-open;

        // Space below the title, so the grid scrolls under it with room to spare.
        HorizontalLayout {
            padding-left: Theme.space-xxl;
            padding-right: Theme.space-xxl;
            padding-top: Theme.space-xxl;
            padding-bottom: Theme.space-l;
            spacing: Theme.space-xl;

            Text {
                text: @tr("Albums");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            SearchField {
                compact: true;
                horizontal-stretch: 0;
                preferred-width: 280px;
                min-width: 160px;
                label: @tr("Filter albums");
                placeholder: @tr("Filter albums");
                text <=> root.filter;
                edited(text) => {
                    root.filter-edited(text);
                }
            }
        }

        // Empty states: why there is nothing to show, and what fills the page.
        if root.albums.length == 0: VerticalLayout {
            padding: Theme.space-xxl;
            spacing: Theme.space-l;
            alignment: start;

            Text {
                text: root.library-failed ? @tr("The music library could not be opened, so no albums can be shown.")
                    : root.filter != "" ? @tr("No albums match “{}”.", root.filter)
                    : LibraryState.scanning ? @tr("Looking for albums in your music folders. They appear here as they are found.")
                    : LibraryState.folders.length == 0 ? @tr("Your library is empty. Add the folder your music is in, and VCMP finds your albums.")
                    : @tr("No albums found in your music folders. Tracks without an album tag don't appear here.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
                max-width: Theme.content-max-width;
            }

            if !root.library-failed && root.filter == "" && !LibraryState.scanning && LibraryState.folders.length == 0: AddFolderButton { }
        }

        // Kept while an album is open, so its scroll position survives.
        grid := AlbumGrid {
            visible: root.albums.length > 0;
            vertical-stretch: 1;
            albums: root.albums;
            visible-range-changed(first, count) => {
                root.range-changed(first, count);
            }
            activated(index) => {
                root.activated(index);
            }
        }
    }

    view := AlbumView {
        width: parent.width;
        height: parent.height;
        visible: root.album-open;
        playing-path: PlayerState.track-path;
        play(start, shuffle) => {
            root.play-album(start, shuffle);
        }
        queue-track(index, next) => {
            root.queue-album-track(index, next);
        }
        album: root.album;
        tracks: root.tracks;
        multi-disc: root.multi-disc;
        back-label: root.from-search ? @tr("Search") : @tr("Albums");
        back => {
            if root.from-search {
                root.back-to-search();
            } else {
                root.close-album();
            }
        }
    }

    if root.shown: FadeCurtain { }
}

// The artists: a grid of album artists, or of everyone credited on a track. Choosing
// one shows the artist; an album chosen there opens in this page too, so going back
// returns to the artist.
export component ArtistsPage inherits Rectangle {
    in property <[AlbumTile]> artists;
    // Everyone credited on a track, rather than album artists only.
    in-out property <bool> show-all;
    // Narrows the grid to artists whose name holds every typed word.
    in-out property <string> filter;
    callback filter-edited(string);
    in property <bool> shown;
    in property <bool> library-failed;
    in-out property <bool> artist-open;
    // An album opened from the artist's page.
    in-out property <bool> album-open;
    // The open artist came from search, so going back returns there.
    in property <bool> from-search;
    callback back-to-search();
    in property <ArtistDetail> artist;
    in property <[AlbumTile]> artist-albums;
    in property <[TrackRow]> appearances;
    in property <AlbumDetail> album;
    in property <[TrackRow]> tracks;
    in property <bool> multi-disc;
    callback activated(int);
    // The artist grid's cards in view changed: first index and how many fit.
    callback range-changed(int, int);
    callback filter-changed();
    callback album-activated(int);
    callback play-artist(bool);
    callback play-appearance(int);
    callback queue-appearance(int, bool);
    callback play-album(int, bool);
    callback queue-album-track(int, bool);

    // Leaves an open artist or album for the grid.
    public function show-grid() {
        root.album-open = false;
        root.close-artist();
    }

    // Shows the grid again, with the artist that was open as its current card.
    public function close-artist() {
        root.artist-open = false;
        grid.focus-album(grid.current);
    }

    // Shows the artist again, with the album that was open as the current card.
    public function close-album() {
        root.album-open = false;
        artist-view.focus-album(root.album-index);
    }

    private property <int> album-index: 0;

    changed artist-open => {
        if self.artist-open {
            artist-view.focus-back();
        }
    }
    changed album-open => {
        if self.album-open {
            album-view.focus-back();
        }
    }

    visible: root.shown;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        visible: !root.artist-open && !root.album-open;

        // Space below the title, so the grid scrolls under it with room to spare.
        HorizontalLayout {
            padding-left: Theme.space-xxl;
            padding-right: Theme.space-xxl;
            padding-top: Theme.space-xxl;
            padding-bottom: Theme.space-l;
            spacing: Theme.space-l;

            Text {
                text: @tr("Artists");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            SearchField {
                compact: true;
                horizontal-stretch: 0;
                preferred-width: 240px;
                min-width: 96px;
                label: @tr("Filter artists");
                placeholder: @tr("Filter artists");
                text <=> root.filter;
                edited(text) => {
                    root.filter-edited(text);
                }
            }

            // Its natural width, narrower in a small window.
            SegmentedChoice {
                label: @tr("Artists shown");
                segment-min: 96px;
                horizontal-stretch: 0;
                preferred-width: 272px;
                max-width: 272px;
                options: [@tr("Album artists"), @tr("All artists")];
                current-index: root.show-all ? 1 : 0;
                selected(index) => {
                    root.show-all = index == 1;
                    root.filter-changed();
                    Theme.preferences-changed();
                }
            }
        }

        if root.artists.length == 0: VerticalLayout {
            padding: Theme.space-xxl;
            spacing: Theme.space-l;
            alignment: start;

            Text {
                text: root.library-failed ? @tr("The music library could not be opened, so no artists can be shown.")
                    : root.filter != "" ? @tr("No artists match “{}”.", root.filter)
                    : LibraryState.scanning ? @tr("Looking for artists in your music folders. They appear here as they are found.")
                    : LibraryState.folders.length == 0 ? @tr("Your library is empty. Add the folder your music is in, and VCMP finds your artists.")
                    : root.show-all ? @tr("No artists found in your music folders.")
                    : @tr("No album artists found. Choose All artists to see everyone credited on a track.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
                max-width: Theme.content-max-width;
            }

            if !root.library-failed && root.filter == "" && !LibraryState.scanning && LibraryState.folders.length == 0: AddFolderButton { }
        }

        // Kept while an artist is open, so its scroll position survives.
        grid := AlbumGrid {
            visible: root.artists.length > 0;
            vertical-stretch: 1;
            round: true;
            albums: root.artists;
            visible-range-changed(first, count) => {
                root.range-changed(first, count);
            }
            activated(index) => {
                root.activated(index);
            }
        }
    }

    artist-view := ArtistView {
        width: parent.width;
        height: parent.height;
        visible: root.artist-open && !root.album-open;
        artist: root.artist;
        albums: root.artist-albums;
        appearances: root.appearances;
        back-label: root.from-search ? @tr("Search") : @tr("Artists");
        back => {
            if root.from-search {
                root.back-to-search();
            } else {
                root.close-artist();
            }
        }
        album-activated(index) => {
            root.album-index = index;
            root.album-activated(index);
        }
        play(shuffle) => {
            root.play-artist(shuffle);
        }
        play-appearance(index) => {
            root.play-appearance(index);
        }
        queue-appearance(index, next) => {
            root.queue-appearance(index, next);
        }
    }

    album-view := AlbumView {
        width: parent.width;
        height: parent.height;
        visible: root.album-open;
        back-label: root.artist.name;
        playing-path: PlayerState.track-path;
        album: root.album;
        tracks: root.tracks;
        multi-disc: root.multi-disc;
        play(start, shuffle) => {
            root.play-album(start, shuffle);
        }
        queue-track(index, next) => {
            root.queue-album-track(index, next);
        }
        back => {
            root.close-album();
        }
    }

    if root.shown: FadeCurtain { }
}

// The playlists as a grid, and one playlist instead of it while open.
export component PlaylistsPage inherits Rectangle {
    in property <[AlbumTile]> playlists;
    in property <bool> shown;
    in property <bool> library-failed;
    in-out property <bool> playlist-open;
    // The open playlist came from search, so going back returns there.
    in property <bool> from-search;
    callback back-to-search();
    in property <PlaylistDetail> playlist;
    in property <[TrackRow]> tracks;
    callback range-changed(int, int);
    callback activated(int);
    // Makes a playlist with this name and opens it.
    callback create(string);
    callback play(int, bool);
    callback queue-track(int, bool);
    callback remove-track(int);
    callback move-track(int, int);
    callback rename(string);
    callback choose-picture();
    callback clear-picture();
    callback delete();

    // Shows the grid again, with the playlist that was open as its current card.
    public function close-playlist() {
        root.playlist-open = false;
        grid.focus-album(grid.current);
    }

    changed playlist-open => {
        // A playlist just made opens with its name field focused instead.
        if self.playlist-open && !view.renaming {
            view.focus-back();
        }
    }

    visible: root.shown;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        visible: !root.playlist-open;

        // Space below the title, so the grid scrolls under it with room to spare.
        HorizontalLayout {
            padding-left: Theme.space-xxl;
            padding-right: Theme.space-xxl;
            padding-top: Theme.space-xxl;
            padding-bottom: Theme.space-l;
            spacing: Theme.space-xl;

            Text {
                text: @tr("Playlists");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if !root.library-failed: Button {
                text: @tr("New playlist");
                clicked => {
                    root.create(@tr("Playlist {}", root.playlists.length + 1));
                    view.start-rename();
                }
            }
        }

        if root.playlists.length == 0: VerticalLayout {
            padding: Theme.space-xxl;
            alignment: start;

            Text {
                text: root.library-failed ? @tr("The music library could not be opened, so no playlists can be shown.")
                    : @tr("No playlists yet. Make one with New playlist, or from any track's menu: right-click a track, or press the Menu key, and choose Add to playlist.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
                max-width: Theme.content-max-width;
            }
        }

        // Kept while a playlist is open, so its scroll position survives.
        grid := AlbumGrid {
            visible: root.playlists.length > 0;
            vertical-stretch: 1;
            playlists: true;
            albums: root.playlists;
            visible-range-changed(first, count) => {
                root.range-changed(first, count);
            }
            activated(index) => {
                root.activated(index);
            }
        }
    }

    view := PlaylistView {
        width: parent.width;
        height: parent.height;
        visible: root.playlist-open;
        playlist: root.playlist;
        tracks: root.tracks;
        playing-path: PlayerState.track-path;
        back-label: root.from-search ? @tr("Search") : @tr("Playlists");
        back => {
            if root.from-search {
                root.back-to-search();
            } else {
                root.close-playlist();
            }
        }
        play(start, shuffle) => {
            root.play(start, shuffle);
        }
        queue-track(index, next) => {
            root.queue-track(index, next);
        }
        remove-track(index) => {
            root.remove-track(index);
        }
        move-track(from, to) => {
            root.move-track(from, to);
        }
        rename(name) => {
            root.rename(name);
        }
        choose-picture => {
            root.choose-picture();
        }
        clear-picture => {
            root.clear-picture();
        }
        delete => {
            root.delete();
            root.close-playlist();
        }
    }

    if root.shown: FadeCurtain { }
}

// Search over the whole library: artists, albums and tracks whose names contain the
// typed words (any part of a name, in any script), and playlists by their names.
// The page stays alive while hidden, so the search and its results are still there
// when the user comes back.
export component SearchPage inherits Rectangle {
    in property <bool> shown;
    in-out property <string> text;
    in property <[AlbumTile]> artists;
    in property <[AlbumTile]> albums;
    in property <[AlbumTile]> playlists;
    in property <[TrackRow]> tracks;
    callback edited(string);
    callback artist-activated(int);
    callback album-activated(int);
    callback playlist-activated(int);
    callback play-track(int);
    callback queue-track(int, bool);

    public function focus-field() {
        field.focus-text();
    }

    private property <bool> found: root.artists.length + root.albums.length + root.playlists.length + root.tracks.length > 0;

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    visible: root.shown;

    VerticalLayout {
        padding: Theme.space-xxl;
        padding-bottom: 0;
        spacing: Theme.space-xl;

        Text {
            text: @tr("Search");
            color: Theme.colors.text;
            font-size: Theme.font-title;
            font-weight: Theme.weight-strong;
        }

        field := SearchField {
            max-width: Theme.content-max-width;
            label: @tr("Search");
            placeholder: @tr("Artists, albums, playlists and tracks");
            text <=> root.text;
            edited(text) => {
                root.edited(text);
            }
        }

        scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: Theme.space-xxl;
                spacing: Theme.space-l;
                alignment: start;

                if root.text == "": Text {
                    text: @tr("Finds artists, albums, playlists and tracks by any part of their names, in any language.");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                    max-width: Theme.content-max-width;
                }

                if root.text != "" && !root.found: Text {
                    text: @tr("Nothing in your library matches “{}”.", root.text);
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                    max-width: Theme.content-max-width;
                }

                if root.artists.length > 0: SectionHeading {
                    text: @tr("Artists");
                }
                if root.artists.length > 0: CardGrid {
                    tiles: root.artists;
                    round: true;
                    label: @tr("Artists");
                    available-width: root.width - 2 * Theme.space-xxl - Theme.space-l;
                    activated(index) => {
                        root.artist-activated(index);
                    }
                }

                if root.albums.length > 0: SectionHeading {
                    text: @tr("Albums");
                }
                if root.albums.length > 0: CardGrid {
                    tiles: root.albums;
                    label: @tr("Albums");
                    available-width: root.width - 2 * Theme.space-xxl - Theme.space-l;
                    activated(index) => {
                        root.album-activated(index);
                    }
                }

                if root.playlists.length > 0: SectionHeading {
                    text: @tr("Playlists");
                }
                if root.playlists.length > 0: CardGrid {
                    tiles: root.playlists;
                    playlists: true;
                    label: @tr("Playlists");
                    available-width: root.width - 2 * Theme.space-xxl - Theme.space-l;
                    activated(index) => {
                        root.playlist-activated(index);
                    }
                }

                if root.tracks.length > 0: SectionHeading {
                    text: @tr("Tracks");
                }
                TrackList {
                    label: @tr("Tracks");
                    detail-heading: @tr("Artist and album");
                    tracks: root.tracks;
                    playing-path: PlayerState.track-path;
                    play(index) => {
                        root.play-track(index);
                    }
                    queue(index, next) => {
                        root.queue-track(index, next);
                    }
                    shown-focused(top, height) => {
                        root.ensure-visible(top, height);
                    }
                }
            }
        }
    }

    if root.shown: FadeCurtain { }
}

// Every track in a sortable table. The tracks are loaded the first time the page
// is shown, so a large library does not slow the start.
export component SongsPage inherits Rectangle {
    in property <bool> shown;
    in property <[SongRow]> songs;
    in property <SongColumn> sort-column;
    in property <bool> sort-descending;
    in property <bool> library-failed;
    // Narrows the table to songs whose title, artist or album hold every typed word.
    in-out property <string> filter;
    callback filter-edited(string);
    // The page is shown and wants its tracks.
    callback needed();
    callback sort(SongColumn);
    callback play(int);
    callback queue(int, bool);

    changed shown => {
        if self.shown {
            root.needed();
        }
    }
    init => {
        if self.shown {
            root.needed();
        }
    }

    visible: root.shown;

    VerticalLayout {
        padding: Theme.space-xxl;
        padding-bottom: 0;
        spacing: Theme.space-xl;

        HorizontalLayout {
            spacing: Theme.space-l;

            Text {
                text: @tr("Songs");
                color: Theme.colors.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-strong;
            }
            if root.songs.length > 0: Text {
                text: @tr("{n} song" | "{n} songs" % root.songs.length);
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SearchField {
                compact: true;
                horizontal-stretch: 0;
                preferred-width: 280px;
                min-width: 160px;
                label: @tr("Filter songs");
                placeholder: @tr("Filter songs");
                text <=> root.filter;
                edited(text) => {
                    root.filter-edited(text);
                }
            }
        }

        if root.songs.length == 0: VerticalLayout {
            spacing: Theme.space-l;

            Text {
                text: root.library-failed ? @tr("The music library could not be opened, so no songs can be shown.")
                    : root.filter != "" ? @tr("No songs match “{}”.", root.filter)
                    : LibraryState.scanning ? @tr("Looking for songs in your music folders. They appear here as they are found.")
                    : LibraryState.folders.length == 0 ? @tr("Your library is empty. Add the folder your music is in, and VCMP finds your songs.")
                    : @tr("No songs found in your music folders.");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                min-height: self.preferred-height;
                max-width: Theme.content-max-width;
            }

            if !root.library-failed && root.filter == "" && !LibraryState.scanning && LibraryState.folders.length == 0: AddFolderButton { }
        }

        SongTable {
            vertical-stretch: 1;
            visible: root.songs.length > 0;
            songs: root.songs;
            sort-column: root.sort-column;
            sort-descending: root.sort-descending;
            sort(column) => {
                root.sort(column);
            }
            play(index) => {
                root.play(index);
            }
            queue(index, next) => {
                root.queue(index, next);
            }
        }
    }

    if root.shown: FadeCurtain { }
}

// The music folders as a file tree. The tracks are read the first time the page is
// shown, like the Songs page.
export component FoldersPage inherits Rectangle {
    in property <bool> shown;
    in property <[string]> crumbs;
    in property <[FolderRow]> folders;
    in property <[TrackRow]> files;
    callback needed();
    callback open-folder(int);
    callback go-to(int);
    callback play-file(int);
    callback queue-file(int, bool);

    changed shown => {
        if self.shown {
            root.needed();
        }
    }
    init => {
        if self.shown {
            root.needed();
        }
    }

    visible: root.shown;

    VerticalLayout {
        padding: Theme.space-xxl;
        padding-bottom: 0;
        spacing: Theme.space-l;

        Text {
            text: @tr("Folders");
            color: Theme.colors.text;
            font-size: Theme.font-title;
            font-weight: Theme.weight-strong;
        }

        FolderBrowser {
            vertical-stretch: 1;
            crumbs: root.crumbs;
            folders: root.folders;
            files: root.files;
            has-sources: LibraryState.folders.length > 0;
            open-folder(index) => {
                root.open-folder(index);
            }
            go-to(index) => {
                root.go-to(index);
            }
            play-file(index) => {
                root.play-file(index);
            }
            queue-file(index, next) => {
                root.queue-file(index, next);
            }
        }
    }

    if root.shown: FadeCurtain { }
}
