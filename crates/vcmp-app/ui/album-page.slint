import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, FocusRing, IconButton } from "components.slint";
import { Glyph, Icon } from "icons.slint";
import { CoverSearch } from "cover-picker.slint";
import { Playlists } from "playlist-state.slint";
import { TagEditorState } from "tag-editor.slint";
import { SelectionChange } from "selection.slint";
import { ColumnEdge, ColumnWidths } from "columns.slint";
import { LabelChips, LabelEntry, LabelWords, Labels } from "labels.slint";
import { MovingPicture, PictureFrame, PictureSlot } from "picture.slint";

export struct AlbumDetail {
    // The library's id, for the menu that labels the album's tracks.
    id: int,
    title: string,
    artist: string,
    // Empty when unknown.
    year: string,
    track-count: int,
    minutes: int,
    has-cover: bool,
    cover: image,
    // The frames of an animated cover, once decoded; empty for a still one.
    frames: [PictureFrame],
    // The cover was fetched online, rather than being the files' own.
    fetched-cover: bool,
    // First letter of the title, shown when there is no cover.
    initial: string,
    // The tracks could not be read from the library.
    failed: bool,
    // The album left the library while its page was open.
    missing: bool,
    // Some track has an artist of its own, so the track list shows an artist column.
    track-artists: bool,
    // The "Unknown" album of the artist's tracks without an album tag (or of the
    // tracks naming neither): shown by that name, with a question mark for a cover.
    unknown: bool,
}

export struct TrackRow {
    // Track number as tagged; empty when untagged.
    number: string,
    title: string,
    // Only set when the track artist differs from the album artist.
    artist: string,
    duration: string,
    disc: int,
    // First track of its disc, so the disc heading goes above it.
    disc-start: bool,
    // File path, matched against the playing track.
    path: string,
    // A playlist entry whose file is gone (deleted, or on a drive not plugged in).
    // It stays in the list, dimmed, and playback skips it.
    unavailable: bool,
    // Picked with Ctrl or Shift, so the track menu acts on it with the others.
    selected: bool,
    // The track's labels, by name.
    labels: [LabelEntry],
}

// The selection in a track list, kept in its rows (src/selection.rs). The menu's
// actions take the list and the row the menu is for: they act on the selected rows
// when that row is one of them, or else on that row alone.
export global TrackSelection {
    // Changes which rows are selected (n, then the anchor); returns how many are.
    callback change([TrackRow], int, int, SelectionChange) -> int;
    // Adds the tracks to playlist n (-1: to a new one).
    callback add-to-playlist([TrackRow], int, int);
    callback edit-tags([TrackRow], int);
    // The Labels submenu: fills `Labels.choices` before the menu opens, puts label
    // n on the tracks or takes it off, or opens the dialog for a new label.
    callback prepare-labels([TrackRow], int);
    callback toggle-label([TrackRow], int, int);
    callback new-label([TrackRow], int);
}

// Returns to the page before. The chevron points the way back.
export component BackButton {
    in property <string> label;
    callback clicked;

    min-height: Theme.target-height;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover ? Theme.colors.surface : transparent;
        animate background { duration: Theme.duration-fast; }
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;

        Path {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 10 3 L 5 8 L 10 13";
            stroke: Theme.colors.text;
            stroke-width: 2px;
            accessible-role: none;
        }

        Text {
            text: root.label;
            color: Theme.colors.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// One track of the list. A click selects it; a double-click, or the play button that
// takes the number's place under the pointer, plays the album from here. The playing
// track is marked in the accent.
export component TrackLine {
    in property <TrackRow> track;
    in property <bool> show-disc;
    in property <bool> playing;
    // The column beside the title (artist, album or both) is shown.
    in property <bool> detail-column;
    // The rows just above and below are selected too, with no heading between: a run
    // of selected rows reads as one block, rounded only at its ends.
    in property <bool> selected-above;
    in property <bool> selected-below;
    // The keyboard's current track in a focused list.
    in property <bool> focused;
    // A click, and whether it toggles the row's selection (Ctrl, or Cmd on macOS) or
    // selects a range (Shift).
    callback clicked(bool, bool);
    // Plays from this track: a double-click, the play button, or assistive technology.
    callback play-requested();
    // Window position of a right click.
    callback menu-requested(length, length);
    // Where the row is, so the list can scroll it into view.
    callback shown-focused(length, length);
    // The row can be dragged to another place in its list: the list hears where the
    // pointer is (window y) and how tall a row is, then when it lets go.
    in property <bool> draggable;
    callback drag-moved(length, length);
    callback drag-ended();

    // The press became a drag, so letting go plays nothing.
    private property <bool> dragging;
    private property <bool> dragged;
    // The keys held when the button went down.
    private property <bool> toggle-click;
    private property <bool> range-click;
    // Secondary text turns full strength on the fill of a selected or hovered row:
    // muted text on that fill would fall under 4.5:1 in the light theme.
    private property <color> secondary: root.track.selected || touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
    private property <bool> joined-above: root.track.selected && root.selected-above;
    private property <bool> joined-below: root.track.selected && root.selected-below;
    // The pointer is on the play button, in the number's place.
    private property <bool> on-play-button: touch.has-hover && touch.mouse-x < number.x + number.width + Theme.space-l / 2;
    private property <string> spoken: root.track.unavailable ? @tr("{0}, file not found", root.track.title)
        : root.track.artist == "" ? root.track.title : @tr("{0}, {1}", root.track.title, root.track.artist);

    changed focused => {
        if self.focused {
            root.shown-focused(row.absolute-position.y, row.height);
        }
    }

    VerticalLayout {
        if root.show-disc && root.track.disc-start: Text {
            text: @tr("Disc {}", root.track.disc);
            color: Theme.colors.text;
            font-size: Theme.font-heading;
            font-weight: Theme.weight-strong;
            height: Theme.target-height + Theme.space-l;
            vertical-alignment: bottom;
        }

        row := Rectangle {
            min-height: Theme.target-height;
            border-top-left-radius: root.joined-above ? 0 : Theme.radius-m;
            border-top-right-radius: root.joined-above ? 0 : Theme.radius-m;
            border-bottom-left-radius: root.joined-below ? 0 : Theme.radius-m;
            border-bottom-right-radius: root.joined-below ? 0 : Theme.radius-m;
            background: root.track.selected || touch.has-hover ? Theme.colors.surface : transparent;
            accessible-role: list-item;
            accessible-label: root.track.labels.length == 0 ? root.spoken : @tr("{0}, labels: {1}", root.spoken, LabelWords.names(root.track.labels));
            accessible-item-selectable: true;
            accessible-item-selected: root.track.selected || root.focused;
            accessible-action-default => {
                root.play-requested();
            }

            // A selected row is marked at its edge, as well as filled, so it reads
            // apart from the row under the pointer. The mark runs on through a block
            // of selected rows.
            if root.track.selected: Rectangle {
                x: 0;
                y: root.joined-above ? 0 : Theme.space-s;
                width: 3px;
                height: parent.height - (root.joined-above ? 0 : Theme.space-s) - (root.joined-below ? 0 : Theme.space-s);
                border-top-left-radius: root.joined-above ? 0 : Theme.radius-s;
                border-top-right-radius: root.joined-above ? 0 : Theme.radius-s;
                border-bottom-left-radius: root.joined-below ? 0 : Theme.radius-s;
                border-bottom-right-radius: root.joined-below ? 0 : Theme.radius-s;
                background: Theme.colors.accent;
            }

            HorizontalLayout {
                spacing: Theme.space-l;
                padding-right: Theme.space-s;

                // The number; under the pointer a play button takes its place, and the
                // track now playing has a play mark in the accent.
                number := Rectangle {
                    width: 32px;

                    if !root.playing && !touch.has-hover: Text {
                        width: parent.width;
                        text: root.track.number;
                        color: root.secondary;
                        font-size: Theme.font-body;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if root.playing || touch.has-hover: Icon {
                        x: parent.width - self.width;
                        width: 14px;
                        height: 14px;
                        glyph: Glyph.play;
                        tint: root.playing ? Theme.colors.accent : Theme.colors.text;
                    }
                }

                // Zero preferred widths make the columns share space by stretch alone,
                // so every row's columns start where the list's headings do. The
                // track's labels follow its title.
                HorizontalLayout {
                    horizontal-stretch: ColumnWidths.track-title;
                    preferred-width: 0;
                    min-width: 0;
                    spacing: Theme.space-m;

                    Text {
                        horizontal-stretch: 1;
                        preferred-width: 0;
                        min-width: 0;
                        text: root.track.title;
                        color: root.playing ? Theme.colors.accent : root.track.unavailable ? root.secondary : Theme.colors.text;
                        font-size: Theme.font-body;
                        font-weight: root.playing ? Theme.weight-strong : Theme.weight-regular;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                    if root.track.labels.length > 0: LabelChips {
                        labels: root.track.labels;
                        strong: root.track.selected || touch.has-hover;
                    }
                }

                // A missing file says so in words, not only by its dimmed title.
                if root.detail-column: Text {
                    horizontal-stretch: ColumnWidths.track-detail;
                    preferred-width: 0;
                    min-width: 0;
                    text: root.track.unavailable ? @tr("File not found") : root.track.artist;
                    color: root.secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                Text {
                    width: 64px;
                    text: root.track.duration;
                    color: root.secondary;
                    font-size: Theme.font-body;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            touch := TouchArea {
                mouse-cursor: root.dragging ? MouseCursor.grabbing : root.on-play-button ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if root.dragged {
                        root.dragged = false;
                    } else {
                        Theme.keyboard-navigation = false;
                        if root.on-play-button && !root.toggle-click && !root.range-click {
                            root.play-requested();
                        } else {
                            root.clicked(root.toggle-click, root.range-click);
                        }
                    }
                }
                double-clicked => {
                    if !root.on-play-button && !root.dragging {
                        root.play-requested();
                    }
                }
                moved => {
                    if root.draggable && self.pressed && (root.dragging || abs(self.mouse-y - self.pressed-y) > 6px) {
                        root.dragging = true;
                        root.drag-moved(row.absolute-position.y + self.mouse-y, row.height);
                    }
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.menu-requested(row.absolute-position.x + self.mouse-x, row.absolute-position.y + self.mouse-y);
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.dragged = false;
                        root.toggle-click = event.modifiers.control || event.modifiers.meta;
                        root.range-click = event.modifiers.shift;
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging {
                        root.dragging = false;
                        root.dragged = true;
                        root.drag-ended();
                    }
                }
            }

            if root.focused: FocusRing {
                around-width: parent.width;
                around-height: parent.height;
                radius: Theme.radius-m;
            }
        }
    }
}

// Tracks as a list that is one tab stop: Up/Down and Home/End move, Enter plays,
// and the Menu key (or a right click) opens a track's menu: Play now, Play next,
// Add to queue, Add to playlist, Edit tags. A click selects a track; a double-click
// or the play button in the number's place plays from it. Several tracks can be
// selected for the menu: Ctrl+click (Cmd on macOS) or Ctrl+Space toggles one,
// Shift+click or Shift+arrows select a range, Ctrl+A selects all, Escape clears.
// A playlist's own list (`editable`) also moves and removes
// tracks: from the menu, with Alt+Up/Down, with Delete, and by dragging. The owner
// scrolls the row reported by `shown-focused` into view, and scrolls while a drag
// holds the pointer near the view's edge (`dragging`, `drag-y`).
export component TrackList {
    in property <[TrackRow]> tracks;
    in property <string> label;
    // The headings of the title column and of the column beside it (artist, album or
    // both). Without a `detail-heading` the titles have the whole row.
    in property <string> title-heading: @tr("Title");
    in property <string> detail-heading;
    // Disc headings above the first track of each disc.
    in property <bool> show-disc;
    // Path of the track now playing, to mark it.
    in property <string> playing-path;
    in property <bool> editable;
    callback play(int);
    // Puts a track into Up next: at its front (`next`), or at its end.
    callback queue(int, bool);
    callback remove(int);
    // Moves the track at the first position to the second.
    callback reorder(int, int);
    callback shown-focused(length, length);
    // A row is being dragged, and the pointer's window y.
    out property <bool> dragging: root.drag-from >= 0;
    out property <length> drag-y;

    function move-current(by: int) {
        let to = root.current + by;
        if to >= 0 && to < root.tracks.length {
            root.reorder(root.current, to);
            root.current = to;
        }
    }

    // The keyboard's current track.
    private property <int> current: 0;
    // Where a Shift range starts, and how many rows are selected.
    private property <int> anchor: 0;
    private property <int> selected-count: 0;

    function select(index: int, change: SelectionChange) {
        root.selected-count = TrackSelection.change(root.tracks, index, root.anchor, change);
    }

    // Moves the keyboard's current track; with Shift, the selection follows it.
    function go-to(index: int, extend: bool) {
        root.current = max(0, min(root.tracks.length - 1, index));
        if extend {
            root.select(root.current, SelectionChange.range);
        } else {
            root.anchor = root.current;
        }
    }
    // A row being dragged in an editable list, and the place it would go. The place
    // follows the list when it scrolls under a pointer held still.
    private property <int> drag-from: -1;
    private property <length> drag-row-height;
    private property <int> drag-to: root.drag-from < 0 ? -1
        : clamp(floor((root.drag-y - list.absolute-position.y) / root.drag-row-height), 0, root.tracks.length - 1);

    // A row outside the selection gets the menu to itself.
    function show-menu(index: int, x: length, y: length) {
        if root.selected-count > 0 && !root.tracks[index].selected {
            root.select(index, SelectionChange.none);
        }
        root.current = index;
        TrackSelection.prepare-labels(root.tracks, index);
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    changed tracks => {
        root.current = max(0, min(root.current, root.tracks.length - 1));
        // Another list: nothing in it is selected.
        root.anchor = root.current;
        root.selected-count = 0;
    }

    VerticalLayout {
        // Keeps the first row's fill off the line under the headings.
        spacing: Theme.space-xs;

        // Headings over the columns; the edge between the title and the column beside
        // it resizes them, for every track list at once.
        if root.tracks.length > 0: Rectangle {
            height: Theme.target-height;

            HorizontalLayout {
                spacing: Theme.space-l;
                padding-right: Theme.space-s;

                Text {
                    width: 32px;
                    text: @tr("#");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                title-heading := Text {
                    horizontal-stretch: ColumnWidths.track-title;
                    preferred-width: 0;
                    min-width: 0;
                    text: root.title-heading;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.detail-heading != "": Text {
                    horizontal-stretch: ColumnWidths.track-detail;
                    preferred-width: 0;
                    min-width: 0;
                    text: root.detail-heading;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    width: 64px;
                    text: @tr("Time");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            if root.detail-heading != "": ColumnEdge {
                x: title-heading.x + title-heading.width;
                height: parent.height;
                label: @tr("Width of the {} column", root.title-heading);
                first <=> ColumnWidths.track-title;
                second <=> ColumnWidths.track-detail;
                first-width: title-heading.width;
                resized => {
                    ColumnWidths.save();
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.colors.surface;
            }
        }

        menu := ContextMenuArea {
            Menu {
                // With several tracks, the menu says how many it acts on.
                if root.selected-count > 1: MenuItem {
                    title: @tr("{n} track selected" | "{n} tracks selected" % root.selected-count);
                    enabled: false;
                }
                if root.selected-count > 1: MenuSeparator { }
                if root.selected-count < 2: MenuItem {
                    title: @tr("Play now");
                    activated => {
                        root.play(root.current);
                    }
                }
                MenuItem {
                    title: @tr("Play next");
                    activated => {
                        root.queue(root.current, true);
                    }
                }
                MenuItem {
                    title: @tr("Add to queue");
                    activated => {
                        root.queue(root.current, false);
                    }
                }
                Menu {
                    title: @tr("Add to playlist");

                    MenuItem {
                        title: @tr("New playlist");
                        activated => {
                            TrackSelection.add-to-playlist(root.tracks, root.current, -1);
                        }
                    }
                    if Playlists.names.length > 0: MenuSeparator { }
                    for name[index] in Playlists.names: MenuItem {
                        title: name;
                        activated => {
                            TrackSelection.add-to-playlist(root.tracks, root.current, index);
                        }
                    }
                }
                Menu {
                    title: @tr("Labels");

                    for choice in Labels.choices: MenuItem {
                        title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                        checkable: true;
                        checked: choice.checked;
                        activated => {
                            TrackSelection.toggle-label(root.tracks, root.current, choice.id);
                        }
                    }
                    if Labels.choices.length > 0: MenuSeparator { }
                    MenuItem {
                        title: @tr("New label…");
                        activated => {
                            TrackSelection.new-label(root.tracks, root.current);
                        }
                    }
                }
                MenuItem {
                    title: @tr("Edit tags…");
                    activated => {
                        TrackSelection.edit-tags(root.tracks, root.current);
                    }
                }
                if root.editable: MenuSeparator { }
                if root.editable && root.selected-count < 2 && root.current > 0: MenuItem {
                    title: @tr("Move up");
                    activated => {
                        root.move-current(-1);
                    }
                }
                if root.editable && root.selected-count < 2 && root.current < root.tracks.length - 1: MenuItem {
                    title: @tr("Move down");
                    activated => {
                        root.move-current(1);
                    }
                }
                if root.editable: MenuItem {
                    title: @tr("Remove from playlist");
                    activated => {
                        root.remove(root.current);
                    }
                }
            }

            list := FocusScope {
                focus-on-click: false;
                focus-on-tab-navigation: root.tracks.length > 0;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    if root.editable && event.modifiers.alt && event.text == Key.UpArrow {
                        root.move-current(-1);
                    } else if root.editable && event.modifiers.alt && event.text == Key.DownArrow {
                        root.move-current(1);
                    } else if root.editable && event.text == Key.Delete {
                        root.remove(root.current);
                    } else if event.text == Key.DownArrow {
                        root.go-to(root.current + 1, event.modifiers.shift);
                    } else if event.text == Key.UpArrow {
                        root.go-to(root.current - 1, event.modifiers.shift);
                    } else if event.text == Key.Home {
                        root.go-to(0, event.modifiers.shift);
                    } else if event.text == Key.End {
                        root.go-to(root.tracks.length - 1, event.modifiers.shift);
                    } else if (event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A") {
                        root.select(0, SelectionChange.all);
                    } else if event.modifiers.control && event.text == Key.Space {
                        root.anchor = root.current;
                        root.select(root.current, SelectionChange.toggle);
                    } else if event.text == Key.Escape && root.selected-count > 0 {
                        root.select(0, SelectionChange.none);
                    } else if event.text == Key.Return || event.text == Key.Space {
                        root.play(root.current);
                    } else if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                        // The menu opens on its own; it needs the current labels first.
                        TrackSelection.prepare-labels(root.tracks, root.current);
                        return reject;
                    } else {
                        return reject;
                    }
                    accept
                }

                VerticalLayout {
                    accessible-role: AccessibleRole.list;
                    accessible-label: root.label;

                    for track[index] in root.tracks: TrackLine {
                        track: track;
                        show-disc: root.show-disc;
                        detail-column: root.detail-heading != "";
                        // A disc heading between two rows parts them.
                        selected-above: index > 0 && root.tracks[index - 1].selected && !(root.show-disc && track.disc-start);
                        selected-below: index + 1 < root.tracks.length && root.tracks[index + 1].selected && !(root.show-disc && root.tracks[index + 1].disc-start);
                        playing: track.path == root.playing-path;
                        focused: list.has-focus && index == root.current;
                        draggable: root.editable;
                        drag-moved(y, height) => {
                            root.drag-row-height = height;
                            root.drag-y = y;
                            if root.drag-from < 0 {
                                root.drag-from = index;
                                root.current = index;
                            }
                        }
                        drag-ended => {
                            let to = root.drag-to;
                            if root.drag-from >= 0 && to >= 0 && to != root.drag-from {
                                root.reorder(root.drag-from, to);
                                root.current = to;
                            }
                            root.drag-from = -1;
                        }
                        clicked(toggle, range) => {
                            root.current = index;
                            if range {
                                root.select(index, SelectionChange.range);
                            } else if toggle {
                                root.anchor = index;
                                root.select(index, SelectionChange.toggle);
                            } else {
                                // This track alone: a range from it to itself.
                                root.anchor = index;
                                root.select(index, SelectionChange.range);
                            }
                        }
                        play-requested => {
                            root.current = index;
                            root.play(index);
                        }
                        menu-requested(x, y) => {
                            root.show-menu(index, x, y);
                        }
                        shown-focused(top, height) => {
                            root.shown-focused(top, height);
                        }
                    }
                }

                // Where a dragged row would land: a line above the row it would take the
                // place of, or below it when moving down.
                if root.drag-from >= 0 && root.drag-to != root.drag-from: Rectangle {
                    x: 0;
                    y: (root.drag-to > root.drag-from ? root.drag-to + 1 : root.drag-to) * root.drag-row-height - 1px;
                    width: parent.width;
                    height: 2px;
                    border-radius: self.height / 2;
                    background: Theme.colors.accent;
                }
            }
        }
    }
}

// One album: its cover and details, then its tracks grouped by disc. An album
// without a cover offers to find one online.
export component AlbumView {
    in property <AlbumDetail> album;
    // The names shown: an Unknown album's are words of the UI, not tags.
    private property <string> shown-title: root.album.unknown ? @tr("Unknown") : root.album.title;
    private property <string> shown-artist: root.album.unknown && root.album.artist == "" ? @tr("Unknown artist") : root.album.artist;
    // Names the page the back button returns to.
    in property <string> back-label: @tr("Albums");
    in property <[TrackRow]> tracks;
    in property <bool> multi-disc;
    // Path of the track now playing, to mark it in the list.
    in property <string> playing-path;
    // The page is in sight, so an animated picture plays.
    in property <bool> in-sight;
    // Which of the two album pages this is, for the animated cover's frames.
    in property <PictureSlot> picture-slot: PictureSlot.album;
    callback back();
    // Plays the album from track `start` (-1: from its beginning, or shuffled).
    callback play(int, bool);
    // Puts a track into Up next: at its front (`next`), or at its end.
    callback queue-track(int, bool);

    public function focus-back() {
        back-button.focus();
    }

    // The cover as large as the page allows beside the details.
    private property <length> cover-size: Theme.detail-cover-size(root.width);

    // The cover picker or the album's tag editor, opened from this page's More menu,
    // closed: the focus comes back to the page, so its keys work again. Both pages
    // that show albums hold one of these, so only the shown one takes it.
    private property <bool> asked-for-cover;
    private property <bool> picker-open: CoverSearch.open;
    changed picker-open => {
        if self.picker-open {
            self.asked-for-cover = root.visible;
        } else if self.asked-for-cover {
            self.asked-for-cover = false;
            back-button.focus();
        }
    }
    private property <bool> asked-for-tags;
    private property <bool> editor-open: TagEditorState.open;
    changed editor-open => {
        if self.editor-open {
            self.asked-for-tags = root.visible && TagEditorState.whole-album;
        } else if self.asked-for-tags {
            self.asked-for-tags = false;
            back-button.focus();
        }
    }

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    forward-focus: back-button;

    // Handles Escape for everything on the page; not a tab stop itself.
    FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.back();
                return accept;
            }
            reject
        }

        scroll := ScrollView {
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                padding: Theme.space-xxl;
                padding-top: Theme.space-xl;
                spacing: Theme.space-xl;
                alignment: start;

                HorizontalLayout {
                    alignment: start;

                    back-button := BackButton {
                        label: root.back-label;
                        clicked => {
                            root.back();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xl;
                    alignment: start;

                    VerticalLayout {
                        alignment: start;

                        Rectangle {
                            width: root.cover-size;
                            height: root.cover-size;
                            border-radius: Theme.radius-l;
                            clip: true;
                            background: Theme.colors.surface;

                            if root.album.has-cover: MovingPicture {
                                width: parent.width;
                                height: parent.height;
                                still: root.album.cover;
                                slot: root.picture-slot;
                                frames: root.album.frames;
                                in-sight: root.in-sight;
                                image-fit: ImageFit.cover;
                                accessible-role: none;
                            }
                            if !root.album.has-cover: Text {
                                text: root.album.initial;
                                color: Theme.colors.text-muted;
                                font-size: 64px;
                                font-weight: Theme.weight-strong;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: end;
                        max-width: Theme.content-max-width;

                        Text {
                            text: root.shown-title;
                            color: Theme.colors.text;
                            font-size: Theme.font-display;
                            font-weight: Theme.weight-strong;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }

                        if root.shown-artist != "": Text {
                            text: root.shown-artist;
                            color: Theme.colors.text;
                            font-size: Theme.font-large;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }

                        if !root.album.missing: HorizontalLayout {
                            spacing: Theme.space-l;
                            alignment: start;

                            if root.album.year != "": Text {
                                text: root.album.year;
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-body;
                            }
                            Text {
                                text: @tr("{n} track" | "{n} tracks" % root.album.track-count);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-body;
                            }
                            Text {
                                text: @tr("{} min", root.album.minutes);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-body;
                            }
                        }

                        if root.tracks.length > 0: HorizontalLayout {
                            padding-top: Theme.space-s;
                            spacing: Theme.space-m;
                            alignment: start;

                            Button {
                                text: @tr("Play");
                                label: @tr("Play {}", root.shown-title);
                                primary: true;
                                clicked => {
                                    root.play(-1, false);
                                }
                            }

                            Button {
                                text: @tr("Shuffle");
                                label: @tr("Shuffle {}", root.shown-title);
                                clicked => {
                                    root.play(-1, true);
                                }
                            }

                            // The album's other actions, used now and then; the menu
                            // opens below the button.
                            if !root.album.missing: actions := ContextMenuArea {
                                width: Theme.target-height;
                                height: Theme.target-height;

                                Menu {
                                    if !root.album.has-cover && !root.album.unknown: MenuItem {
                                        title: @tr("Find cover online");
                                        activated => {
                                            CoverSearch.find();
                                        }
                                    }
                                    // A cover fetched online can be swapped for another
                                    // or taken away.
                                    if root.album.fetched-cover: MenuItem {
                                        title: @tr("Find another cover");
                                        activated => {
                                            CoverSearch.find();
                                        }
                                    }
                                    if root.album.fetched-cover: MenuItem {
                                        title: @tr("Remove cover");
                                        activated => {
                                            CoverSearch.remove();
                                        }
                                    }
                                    if (!root.album.has-cover && !root.album.unknown) || root.album.fetched-cover: MenuSeparator { }
                                    // The whole album into a playlist.
                                    Menu {
                                        title: @tr("Add to playlist");

                                        MenuItem {
                                            title: @tr("New playlist");
                                            activated => {
                                                Playlists.add-album(-1);
                                            }
                                        }
                                        if Playlists.names.length > 0: MenuSeparator { }
                                        for name[index] in Playlists.names: MenuItem {
                                            title: name;
                                            activated => {
                                                Playlists.add-album(index);
                                            }
                                        }
                                    }
                                    // Labels for every track the album has now.
                                    Menu {
                                        title: @tr("Labels");

                                        for choice in Labels.choices: MenuItem {
                                            title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                                            checkable: true;
                                            checked: choice.checked;
                                            activated => {
                                                Labels.toggle-album(root.album.id, choice.id);
                                            }
                                        }
                                        if Labels.choices.length > 0: MenuSeparator { }
                                        MenuItem {
                                            title: @tr("New label…");
                                            activated => {
                                                Labels.new-for-album(root.album.id);
                                            }
                                        }
                                    }
                                    // The album's tags, its cover among them.
                                    MenuItem {
                                        title: @tr("Edit tags…");
                                        activated => {
                                            TagEditorState.edit-album();
                                        }
                                    }
                                }

                                IconButton {
                                    glyph: Glyph.more;
                                    label: @tr("More for {}", root.shown-title);
                                    clicked => {
                                        Labels.prepare-album(root.album.id);
                                        actions.show({ x: 0, y: self.height });
                                    }
                                }
                            }
                        }
                    }
                }

                if root.album.missing: Text {
                    text: @tr("This album is no longer in your library: its files were moved or deleted, or their folder was removed.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }

                if root.album.failed: Text {
                    text: @tr("The tracks of this album could not be read from the library.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }

                TrackList {
                    label: @tr("Tracks");
                    detail-heading: root.album.track-artists ? @tr("Artist") : "";
                    tracks: root.tracks;
                    show-disc: root.multi-disc;
                    playing-path: root.playing-path;
                    play(index) => {
                        root.play(index, false);
                    }
                    queue(index, next) => {
                        root.queue-track(index, next);
                    }
                    shown-focused(top, height) => {
                        root.ensure-visible(top, height);
                    }
                }
            }
        }
    }
}
