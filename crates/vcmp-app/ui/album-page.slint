import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, FocusRing } from "components.slint";
import { Icon, Icons } from "player-bar.slint";

export struct AlbumDetail {
    title: string,
    artist: string,
    // Empty when unknown.
    year: string,
    track-count: int,
    minutes: int,
    has-cover: bool,
    cover: image,
    // First letter of the title, shown when there is no cover.
    initial: string,
    // The tracks could not be read from the library.
    failed: bool,
    // The album left the library while its page was open.
    missing: bool,
}

export struct TrackRow {
    // Track number as tagged; empty when untagged.
    number: string,
    title: string,
    // Only set when the track artist differs from the album artist.
    artist: string,
    duration: string,
    disc: int,
    // First track of its disc, so the disc heading goes above it.
    disc-start: bool,
    // File path, matched against the playing track.
    path: string,
}

// Returns to the album grid. The chevron points the way back.
component BackButton {
    in property <string> label;
    callback clicked;

    min-height: Theme.target-height;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover ? Theme.colors.surface : transparent;
        animate background { duration: Theme.duration-fast; }
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;

        Path {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 10 3 L 5 8 L 10 13";
            stroke: Theme.colors.text;
            stroke-width: 2px;
            accessible-role: none;
        }

        Text {
            text: root.label;
            color: Theme.colors.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// One track of the list. Clicking it plays the album from here; the playing track
// is marked in the accent.
component TrackLine {
    in property <TrackRow> track;
    in property <bool> show-disc;
    in property <bool> playing;
    // The keyboard's current track in a focused list.
    in property <bool> focused;
    callback clicked();
    // Where the row is, so the list can scroll it into view.
    callback shown-focused(length, length);

    changed focused => {
        if self.focused {
            root.shown-focused(row.absolute-position.y, row.height);
        }
    }

    VerticalLayout {
        if root.show-disc && root.track.disc-start: Text {
            text: @tr("Disc {}", root.track.disc);
            color: Theme.colors.text;
            font-size: Theme.font-heading;
            font-weight: Theme.weight-strong;
            height: Theme.target-height + Theme.space-l;
            vertical-alignment: bottom;
        }

        row := Rectangle {
            min-height: Theme.target-height;
            border-radius: Theme.radius-m;
            background: touch.has-hover ? Theme.colors.surface : transparent;
            accessible-role: list-item;
            accessible-label: root.track.artist == "" ? root.track.title : @tr("{0}, {1}", root.track.title, root.track.artist);
            accessible-item-selected: root.focused;
            accessible-action-default => {
                root.clicked();
            }

            HorizontalLayout {
                spacing: Theme.space-l;
                padding-right: Theme.space-s;

                // The number, or a play mark on the track now playing.
                Rectangle {
                    width: 32px;

                    if !root.playing: Text {
                        width: parent.width;
                        text: root.track.number;
                        color: Theme.colors.text-muted;
                        font-size: Theme.font-body;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if root.playing: Icon {
                        x: parent.width - self.width;
                        width: 14px;
                        height: 14px;
                        glyph: Icons.play;
                        tint: Theme.colors.accent;
                    }
                }

                // Zero preferred widths make the columns share space by stretch alone,
                // so every row's artist column starts at the same x.
                Text {
                    horizontal-stretch: 2;
                    preferred-width: 0;
                    text: root.track.title;
                    color: root.playing ? Theme.colors.accent : Theme.colors.text;
                    font-size: Theme.font-body;
                    font-weight: root.playing ? Theme.weight-strong : Theme.weight-regular;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                if root.track.artist != "": Text {
                    horizontal-stretch: 1;
                    preferred-width: 0;
                    text: root.track.artist;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                Text {
                    width: 64px;
                    text: root.track.duration;
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-body;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            touch := TouchArea {
                clicked => {
                    Theme.keyboard-navigation = false;
                    root.clicked();
                }
            }

            if root.focused: FocusRing {
                around-width: parent.width;
                around-height: parent.height;
                radius: Theme.radius-m;
            }
        }
    }
}

// One album: its cover and details, then its tracks grouped by disc.
export component AlbumView {
    in property <AlbumDetail> album;
    in property <[TrackRow]> tracks;
    in property <bool> multi-disc;
    // Path of the track now playing, to mark it in the list.
    in property <string> playing-path;
    callback back();
    // Plays the album from track `start` (-1: from its beginning, or shuffled).
    callback play(int, bool);

    // The keyboard's current track; the list is one tab stop.
    private property <int> current: 0;

    public function focus-back() {
        back-button.focus();
    }

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    forward-focus: back-button;

    // Handles Escape for everything on the page; not a tab stop itself.
    FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.back();
                return accept;
            }
            reject
        }

        scroll := ScrollView {
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                padding: Theme.space-xxl;
                padding-top: Theme.space-xl;
                spacing: Theme.space-xl;
                alignment: start;

                HorizontalLayout {
                    alignment: start;

                    back-button := BackButton {
                        label: @tr("Albums");
                        clicked => {
                            root.back();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xl;
                    alignment: start;

                    Rectangle {
                        width: 200px;
                        height: 200px;
                        border-radius: Theme.radius-l;
                        clip: true;
                        background: Theme.colors.surface;

                        if root.album.has-cover: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.album.cover;
                            image-fit: ImageFit.cover;
                            accessible-role: none;
                        }
                        if !root.album.has-cover: Text {
                            text: root.album.initial;
                            color: Theme.colors.text-muted;
                            font-size: 64px;
                            font-weight: Theme.weight-strong;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: end;
                        max-width: Theme.content-max-width;

                        Text {
                            text: root.album.title;
                            color: Theme.colors.text;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-strong;
                            wrap: word-wrap;
                        }

                        if root.album.artist != "": Text {
                            text: root.album.artist;
                            color: Theme.colors.text;
                            font-size: Theme.font-heading;
                            wrap: word-wrap;
                        }

                        if !root.album.missing: HorizontalLayout {
                            spacing: Theme.space-l;
                            alignment: start;

                            if root.album.year != "": Text {
                                text: root.album.year;
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: @tr("{n} track" | "{n} tracks" % root.album.track-count);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: @tr("{} min", root.album.minutes);
                                color: Theme.colors.text-muted;
                                font-size: Theme.font-small;
                            }
                        }

                        if root.tracks.length > 0: HorizontalLayout {
                            padding-top: Theme.space-s;
                            spacing: Theme.space-m;
                            alignment: start;

                            Button {
                                text: @tr("Play");
                                label: @tr("Play {}", root.album.title);
                                primary: true;
                                clicked => {
                                    root.play(-1, false);
                                }
                            }

                            Button {
                                text: @tr("Shuffle");
                                label: @tr("Shuffle {}", root.album.title);
                                clicked => {
                                    root.play(-1, true);
                                }
                            }
                        }
                    }
                }

                if root.album.missing: Text {
                    text: @tr("This album is no longer in your library: its files were moved or deleted, or their folder was removed.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                if root.album.failed: Text {
                    text: @tr("The tracks of this album could not be read from the library.");
                    color: Theme.colors.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                // The tracks: one tab stop; Up/Down move, Enter or Space plays.
                list := FocusScope {
                    max-width: Theme.content-max-width;
                    focus-on-click: false;
                    focus-gained(reason) => {
                        if reason == FocusReason.tab-navigation {
                            Theme.keyboard-navigation = true;
                        }
                    }
                    key-pressed(event) => {
                        if event.text == Key.DownArrow {
                            root.current = min(root.tracks.length - 1, root.current + 1);
                        } else if event.text == Key.UpArrow {
                            root.current = max(0, root.current - 1);
                        } else if event.text == Key.Home {
                            root.current = 0;
                        } else if event.text == Key.End {
                            root.current = root.tracks.length - 1;
                        } else if event.text == Key.Return || event.text == Key.Space {
                            root.play(root.current, false);
                        } else {
                            return reject;
                        }
                        accept
                    }

                    VerticalLayout {
                        accessible-role: AccessibleRole.list;

                        for track[index] in root.tracks: TrackLine {
                            track: track;
                            show-disc: root.multi-disc;
                            playing: track.path == root.playing-path;
                            focused: list.has-focus && index == root.current;
                            clicked => {
                                root.current = index;
                                root.play(index, false);
                            }
                            shown-focused(top, height) => {
                                root.ensure-visible(top, height);
                            }
                        }
                    }
                }
            }
        }
    }
}
