// The single source of colours, spacing, type sizes and motion for the whole UI.
// Components must not contain colour literals or durations of their own (enforced by
// tests/ui_invariants.rs). Colour values are supplied from Rust (src/theme.rs), so a
// future custom theme only has to set different palettes.

import { Palette } from "std-widgets.slint";

export struct ThemePalette {
    // Content background.
    base: color,
    // Sidebar and other recessed areas.
    mantle: color,
    // Hover and resting fill for interactive elements; text on it must stay readable.
    surface: color,
    // Boundary of interactive elements, at least 3:1 against base and mantle.
    outline: color,
    text: color,
    // Secondary text; only placed on base or mantle. Rows filled for hover or
    // selection turn their secondary text to `text`.
    text-muted: color,
    // Marks what is active: current page, selected option, switched-on state.
    accent: color,
    // Text and marks drawn on an accent fill.
    on-accent: color,
    // Says what is wrong, as text on base only: a value the tag editor can't write.
    error: color,
    // Translucent, over the sidebar and pages behind a dialog; nothing is drawn on it.
    scrim: color,
}

export enum ThemeMode { system, light, dark }

// The Reduce motion choice in Settings: as the operating system asks, always or never.
export enum ReduceMotion { system, on, off }

export global Theme {
    in-out property <ThemeMode> mode: ThemeMode.system;
    in-out property <ReduceMotion> motion-choice: ReduceMotion.system;
    // The operating system asks apps to reduce motion. Set at start and on every
    // change (src/preferences.rs); stays false where the system has no such setting.
    in property <bool> system-reduces-motion: false;
    // Called after the user changes `mode`, `motion-choice` or opens or closes the
    // queue panel, so they can be saved.
    callback preferences-changed();
    // The UI's size as a share of the operating system's scale (Settings → Zoom).
    // Rust applies it to the window (src/zoom.rs); `zoom-by` steps it: 1 larger,
    // -1 smaller, 0 back to 100 %. The ends match `zoom::STEPS`.
    in-out property <float> zoom: 1;
    out property <float> zoom-smallest: 0.8;
    out property <float> zoom-largest: 2;
    callback zoom-by(int);
    // The last input was the keyboard. Focus rings show only then, so clicking with
    // the mouse leaves no ring behind (like :focus-visible on the web).
    in-out property <bool> keyboard-navigation: false;

    in property <ThemePalette> light-colors;
    in property <ThemePalette> dark-colors;

    // An unknown system scheme counts as light.
    out property <bool> dark: root.mode == ThemeMode.system ? Palette.color-scheme == ColorScheme.dark : root.mode == ThemeMode.dark;
    out property <ThemePalette> colors: root.dark ? root.dark-colors : root.light-colors;
    // Transitions are off: the user's choice, or the system's under "System".
    out property <bool> reduced-motion: root.motion-choice == ReduceMotion.system ? root.system-reduces-motion : root.motion-choice == ReduceMotion.on;

    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 40px;

    out property <length> radius-s: 2px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 12px;

    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-heading: 16px;
    out property <length> font-wordmark: 20px;
    out property <length> font-title: 26px;
    // The artist under an album page's title.
    out property <length> font-large: 20px;
    // The track title in the now playing view, the one larger text, and a step up
    // in a window wide enough for the largest cover.
    out property <length> font-display: 34px;
    out property <length> font-display-wide: 42px;
    out property <int> weight-regular: 400;
    out property <int> weight-strong: 600;

    // Interactive targets are at least this tall.
    out property <length> target-height: 40px;
    // Reading width for page content, so labels and their controls stay close.
    out property <length> content-max-width: 720px;
    // Settings and About: a column in the middle of the page, growing from
    // `content-max-width` to this on wide windows.
    out property <length> column-max-width: 960px;
    // The cover or picture at the top of an album, artist or playlist page: as large
    // as a page `page-width` wide allows beside the title and the Play, Shuffle and
    // More buttons (about 240 px), within these bounds.
    out property <length> detail-cover-min: 128px;
    out property <length> detail-cover-max: 280px;
    pure public function detail-cover-size(page-width: length) -> length {
        clamp(page-width - 2 * root.space-xxl - root.space-xl - 240px, root.detail-cover-min, root.detail-cover-max)
    }
    // Windows: the window's own minimise, maximise and close buttons, at the top
    // right, sized as Windows sizes its own (src/title_bar.rs). The window drags by
    // a strip along its top, clear of every page's controls, and by the sidebar
    // down to its first section.
    out property <length> caption-button-width: 46px;
    out property <length> caption-button-height: 32px;
    out property <length> caption-drag-height: 16px;
    // Dialogs: the tag editor's form, and the pickers' grid of covers or photos.
    out property <length> dialog-width: 720px;
    out property <length> dialog-wide-width: 960px;

    out property <duration> duration-fast: root.reduced-motion ? 0ms : 120ms;
    out property <duration> duration-medium: root.reduced-motion ? 0ms : 220ms;

    // A list scrolls while a dragged row is held near its edge: up to one step per
    // tick, so about 750 px a second at the edge itself. The pointer drives it, so
    // reduced motion leaves it on.
    out property <duration> drag-scroll-tick: 16ms;
    out property <length> drag-scroll-step: 12px;

    // The wheel turning over the volume slider changes the volume at once, and the
    // volume is saved once the wheel has rested this long. Not motion, so reduced
    // motion leaves it.
    out property <duration> wheel-commit-delay: 400ms;
}
