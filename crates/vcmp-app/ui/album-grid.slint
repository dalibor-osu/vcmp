import { Theme } from "theme.slint";
import { FocusRing, MenuHost } from "components.slint";
import { Labels } from "labels.slint";
import { PlayerState } from "player-state.slint";
import { Favourites, FavouritesPicture } from "favourites.slint";

export enum ArtworkState { none, loading, loaded }

// A card in a grid: an album, or (with round covers) an artist, whose subtitle is
// its number of albums, or tracks when it has no albums of its own, or a playlist,
// whose subtitle is its number of tracks.
export struct AlbumTile {
    id: int,
    title: string,
    artist: string,
    album-count: int,
    track-count: int,
    // First letter of the title, shown while there is no cover.
    initial: string,
    artwork: ArtworkState,
    cover: image,
    // An "Unknown" album: shown by that name (and "Unknown artist" without one).
    unknown: bool,
    // The Favourites playlist: a heart for its picture.
    favourites: bool,
}

export component AlbumCard {
    in property <AlbumTile> album;
    in property <length> cover-size;
    // An artist: a round picture, and counts below the name.
    in property <bool> round;
    // A playlist: its number of tracks below the name.
    in property <bool> playlist;
    // A photo to pick: below the name, what tells the artist apart, as given.
    in property <bool> photo;
    private property <string> title: root.album.unknown ? @tr("Unknown") : root.album.title;
    private property <string> subtitle: root.photo ? root.album.artist
        : root.playlist ? @tr("{n} track" | "{n} tracks" % root.album.track-count)
        : !root.round ? (root.album.unknown && root.album.artist == "" ? @tr("Unknown artist") : root.album.artist)
        : root.album.album-count > 0 ? @tr("{n} album" | "{n} albums" % root.album.album-count)
        : @tr("{n} track" | "{n} tracks" % root.album.track-count);
    // Drawn with a focus ring: the grid has keyboard focus and this is its current card.
    in property <bool> focused;
    callback clicked;
    // Window position of a right click.
    callback menu-requested(length, length);

    accessible-role: button;
    accessible-item-selected: root.focused;
    accessible-label: root.subtitle == "" ? root.title : @tr("{0}, {1}", root.title, root.subtitle);
    accessible-action-default => {
        root.clicked();
    }

    // Under the pointer the card sits on a fill, as rows do, reaching into the gap
    // around it.
    Rectangle {
        x: -Theme.space-s;
        y: -Theme.space-s;
        width: root.width + 2 * Theme.space-s;
        height: root.height + 2 * Theme.space-s;
        border-radius: Theme.radius-l;
        background: touch.has-hover ? Theme.colors.surface : transparent;
    }

    VerticalLayout {
        spacing: Theme.space-s;
        alignment: start;

        Rectangle {
            width: root.cover-size;
            height: root.cover-size;
            border-radius: root.round ? self.width / 2 : Theme.radius-m;
            clip: true;
            background: Theme.colors.surface;

            if root.album.favourites: FavouritesPicture {
                width: parent.width;
                height: parent.height;
            }
            if root.album.artwork == ArtworkState.none && !root.album.favourites: Text {
                text: root.album.initial;
                color: Theme.colors.text-muted;
                font-size: root.cover-size / 3;
                font-weight: Theme.weight-strong;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            if root.album.artwork == ArtworkState.loaded: Image {
                width: parent.width;
                height: parent.height;
                source: root.album.cover;
                image-fit: ImageFit.cover;
                accessible-role: none;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.colors.text;
                font-size: Theme.font-body;
                font-weight: Theme.weight-strong;
                overflow: elide;
                accessible-role: none;
            }

            // Full strength on the hover fill, where muted text would fall under
            // 4.5:1 in the light theme.
            Text {
                text: root.subtitle;
                color: touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
                font-size: Theme.font-small;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu-requested(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }

    if root.focused: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// A grid of album covers that only creates cards for the rows in view. The owner
// loads covers for the range reported through `visible-range-changed`. The grid is
// one tab stop: arrow keys, Home/End and Page Up/Down move the current card, Enter or
// Space opens it.
export component AlbumGrid {
    in property <[AlbumTile]> albums;
    // Artists rather than albums: round pictures, counts as subtitles.
    in property <bool> round;
    // Playlists: track counts as subtitles.
    in property <bool> playlists;
    // Albums whose cards have a menu: Play next, Add to queue, favourites and labels
    // for their tracks.
    in property <bool> album-menu;
    // The keyboard's current card.
    in-out property <int> current: 0;
    // The queue panel's slide (app-window.slint), so the cards glide between the
    // page's two widths instead of jumping from one number of columns to another:
    // `slide-room` is the width the open panel takes from the page (none where it
    // covers the page instead), `slide-out` how far out it is (1 closed, 0 open),
    // and `slide-opening` whether it is headed in.
    in property <length> slide-room;
    in property <float> slide-out: 1;
    in property <bool> slide-opening;
    callback visible-range-changed(int, int);
    callback activated(int);

    function show-menu(index: int, x: length, y: length) {
        root.current = index;
        Labels.prepare-album(root.albums[index].id);
        Favourites.prepare-album(root.albums[index].id);
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    // Makes `index` the current card, scrolls it into view and focuses the grid.
    public function focus-album(index: int) {
        root.move-to(index);
        focus.focus();
    }

    function move-to(index: int) {
        root.current = max(0, min(root.albums.length - 1, index));
        let top = root.edge + floor(root.current / root.columns) * root.row-height;
        let bottom = top + root.row-height - root.gap + root.edge;
        if top - root.edge < -flick.content-y {
            flick.content-y = -(top - root.edge);
        } else if bottom > -flick.content-y + flick.height {
            flick.content-y = -(bottom - flick.height);
        }
    }

    private property <length> edge: Theme.space-xxl;
    private property <length> gap: Theme.space-xl;
    private property <length> min-tile: 160px;
    private property <length> text-height: 44px;

    // The grid laid out for the page with the queue closed (a) and open beside it
    // (b). At rest the two differ only while the panel is open beside the page; while
    // it slides, every card's place and size is the mix of its two, `mix` of the way
    // to b, so the cards follow the panel frame by frame.
    private property <length> closed-width: self.width + self.slide-room * (1 - self.slide-out);
    private property <length> open-width: self.closed-width - self.slide-room;
    private property <int> columns-a: max(1, floor((self.closed-width - 2 * self.edge + self.gap) / (self.min-tile + self.gap)));
    private property <int> columns-b: max(1, floor((self.open-width - 2 * self.edge + self.gap) / (self.min-tile + self.gap)));
    private property <length> tile-a: (self.closed-width - 2 * self.edge - (self.columns-a - 1) * self.gap) / self.columns-a;
    private property <length> tile-b: (self.open-width - 2 * self.edge - (self.columns-b - 1) * self.gap) / self.columns-b;
    private property <length> row-a: self.tile-a + Theme.space-s + self.text-height + self.gap;
    private property <length> row-b: self.tile-b + Theme.space-s + self.text-height + self.gap;
    private property <float> mix: 1 - self.slide-out;
    // While it slides, the layout the panel is leaving is moved by its offset, so the
    // first album in view stays where it was at the start, and the content scrolls to
    // keep it there at the end (`changed slide-opening`). The offsets are folded into
    // the scroll position once the panel settles.
    private property <bool> sliding;
    private property <length> offset-a;
    private property <length> offset-b;
    private property <length> card-size: self.tile-a + (self.tile-b - self.tile-a) * self.mix;

    // The layout headed for, which is the one shown at rest: the keys, scrolling a
    // card into view and the content's height follow it.
    private property <int> columns: self.slide-opening ? self.columns-b : self.columns-a;
    private property <length> row-height: self.slide-opening ? self.row-b : self.row-a;
    private property <int> rows: ceil(self.albums.length / self.columns);
    private property <int> visible-rows: ceil(self.height / self.row-height) + 1;

    // The cards made: those in view in the layout shown, or while sliding in either
    // layout, with a row to spare.
    private property <int> rows-in-view-a: ceil(self.height / self.row-a) + 1;
    private property <int> rows-in-view-b: ceil(self.height / self.row-b) + 1;
    private property <int> first-a: max(0, floor((-flick.content-y - self.edge - self.offset-a) / self.row-a)) * self.columns-a;
    private property <int> first-b: max(0, floor((-flick.content-y - self.edge - self.offset-b) / self.row-b)) * self.columns-b;
    private property <int> end-a: self.first-a + self.rows-in-view-a * self.columns-a;
    private property <int> end-b: self.first-b + self.rows-in-view-b * self.columns-b;
    private property <bool> both: self.sliding || (self.slide-out > 0 && self.slide-out < 1);
    private property <int> spare: max(self.columns-a, self.columns-b);
    private property <int> first-index: !self.both ? (self.slide-opening ? self.first-b : self.first-a)
        : max(0, min(self.first-a, self.first-b) - self.spare);
    private property <int> slot-count: !self.both ? (self.slide-opening ? self.end-b - self.first-b : self.end-a - self.first-a)
        : max(self.end-a, self.end-b) + self.spare - self.first-index;

    pure function card-x(index: int) -> length {
        let a = root.edge + mod(index, root.columns-a) * (root.tile-a + root.gap);
        let b = root.edge + mod(index, root.columns-b) * (root.tile-b + root.gap);
        a + (b - a) * root.mix
    }
    pure function card-y(index: int) -> length {
        let a = root.edge + floor(index / root.columns-a) * root.row-a + root.offset-a;
        let b = root.edge + floor(index / root.columns-b) * root.row-b + root.offset-b;
        a + (b - a) * root.mix
    }
    pure function content-a() -> length {
        ceil(root.albums.length / root.columns-a) * root.row-a + 2 * root.edge
    }
    pure function content-b() -> length {
        ceil(root.albums.length / root.columns-b) * root.row-b + 2 * root.edge
    }

    // The panel set off from rest (a turn back halfway keeps the anchor as it is):
    // the first album in view keeps its place on screen in the layout left, through
    // the offset, and in the layout headed for, through the scroll position.
    changed slide-opening => {
        if !root.sliding {
            root.sliding = true;
            let columns-from = root.slide-opening ? root.columns-a : root.columns-b;
            let row-from = root.slide-opening ? root.row-a : root.row-b;
            let columns-to = root.slide-opening ? root.columns-b : root.columns-a;
            let row-to = root.slide-opening ? root.row-b : root.row-a;
            let content-to = root.slide-opening ? root.content-b() : root.content-a();
            let anchor = min(max(0, root.albums.length - 1), max(0, floor((-flick.content-y - root.edge) / row-from)) * columns-from);
            let from-y = root.edge + floor(anchor / columns-from) * row-from;
            let on-screen = from-y + flick.content-y;
            let scroll = clamp(on-screen - (root.edge + floor(anchor / columns-to) * row-to), min(0px, flick.height - content-to), 0px);
            if root.slide-opening {
                root.offset-a = on-screen - scroll - from-y;
                root.offset-b = 0;
            } else {
                root.offset-b = on-screen - scroll - from-y;
                root.offset-a = 0;
            }
            flick.content-y = scroll;
        }
        root.settle();
    }
    changed slide-out => {
        root.settle();
    }

    // Once the panel is at rest where it was headed, its layout's offset goes into
    // the scroll position.
    function settle() {
        if root.sliding && root.slide-out == (root.slide-opening ? 0 : 1) {
            flick.content-y += root.slide-opening ? root.offset-b : root.offset-a;
            root.offset-a = 0;
            root.offset-b = 0;
            root.sliding = false;
        }
    }

    changed first-index => {
        root.visible-range-changed(self.first-index, self.slot-count);
    }
    changed slot-count => {
        root.visible-range-changed(self.first-index, self.slot-count);
    }
    init => {
        root.visible-range-changed(self.first-index, self.slot-count);
    }

    accessible-role: list;
    forward-focus: focus;

    // The card's menu: the album's tracks into Up next or the favourites, and labels
    // for every track.
    // In a MenuHost, so the pointer is read right while the menu is open.
    host := MenuHost {
        width: 100%;
        height: 100%;

        menu := ContextMenuArea {
            x: host.shift-x;
            y: host.shift-y;
            width: host.width;
            height: host.height;
            enabled: root.album-menu;

            Menu {
                MenuItem {
                    title: @tr("Play next");
                    activated => {
                        PlayerState.queue-album(root.albums[root.current].id, true);
                    }
                }
                MenuItem {
                    title: @tr("Add to queue");
                    activated => {
                        PlayerState.queue-album(root.albums[root.current].id, false);
                    }
                }
                MenuItem {
                    title: Favourites.entry(Favourites.menu-removes);
                    activated => {
                        Favourites.toggle-album(root.albums[root.current].id);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Labels for every track");
                    enabled: false;
                }
                MenuSeparator { }
                for choice in Labels.choices: MenuItem {
                    title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                    checkable: true;
                    checked: choice.checked;
                    activated => {
                        Labels.toggle-album(root.albums[root.current].id, choice.id);
                    }
                }
                if Labels.choices.length > 0: MenuSeparator { }
                MenuItem {
                    title: @tr("New label…");
                    activated => {
                        Labels.new-for-album(root.albums[root.current].id);
                    }
                }
            }

            focus := FocusScope {
                focus-on-click: false;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    let page = root.columns * max(1, root.visible-rows - 2);
                    if event.text == Key.RightArrow {
                        root.move-to(root.current + 1);
                    } else if event.text == Key.LeftArrow {
                        root.move-to(root.current - 1);
                    } else if event.text == Key.DownArrow {
                        root.move-to(root.current + root.columns);
                    } else if event.text == Key.UpArrow {
                        root.move-to(root.current - root.columns);
                    } else if event.text == Key.PageDown {
                        root.move-to(root.current + page);
                    } else if event.text == Key.PageUp {
                        root.move-to(root.current - page);
                    } else if event.text == Key.Home {
                        root.move-to(0);
                    } else if event.text == Key.End {
                        root.move-to(root.albums.length - 1);
                    } else if event.text == Key.Return || event.text == Key.Space {
                        root.activated(root.current);
                    } else if root.album-menu && root.albums.length > 0 && (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                        // The menu opens on its own; it needs the album's labels and
                        // favourites first.
                        Labels.prepare-album(root.albums[root.current].id);
                        Favourites.prepare-album(root.albums[root.current].id);
                        return reject;
                    } else {
                        return reject;
                    }
                    accept
                }
            }

            // While sliding, tall enough for either layout, so the scroll position
            // set for the one headed for is never cut back.
            flick := Flickable {
                content-height: root.both ? max(root.content-a() + max(0px, root.offset-a), root.content-b() + max(0px, root.offset-b))
                    : root.rows * root.row-height + 2 * root.edge;

                for slot in root.slot-count: AlbumCard {
                    property <int> index: root.first-index + slot;
                    visible: self.index < root.albums.length;
                    x: root.card-x(self.index);
                    y: root.card-y(self.index);
                    width: root.card-size;
                    cover-size: root.card-size;
                    round: root.round;
                    playlist: root.playlists;
                    album: root.albums[self.index];
                    focused: focus.has-focus && self.index == root.current;
                    clicked => {
                        root.current = self.index;
                        root.activated(self.index);
                    }
                    menu-requested(x, y) => {
                        if root.album-menu {
                            root.show-menu(self.index, x, y);
                        }
                    }
                }
            }
        }
    }
}

// A grid that is as tall as its cards, for a few cards inside a scrolling page (an
// artist's albums). `available-width` comes from the page, so the height can follow
// it without a layout loop. One tab stop: arrow keys, Home/End, Enter or Space.
export component CardGrid {
    in property <[AlbumTile]> tiles;
    // Artists rather than albums.
    in property <bool> round;
    // Photos to pick: the subtitles as given.
    in property <bool> photos;
    // Playlists: track counts as subtitles.
    in property <bool> playlists;
    in property <length> available-width;
    in property <string> label;
    // Albums whose cards have a menu: Play next, Add to queue, favourites and labels
    // for their tracks.
    in property <bool> album-menu;
    in-out property <int> current: 0;
    // The queue panel's slide, as for `AlbumGrid`: the cards glide between the
    // layouts for the page's two widths. Left at rest outside the pages.
    in property <length> slide-room;
    in property <float> slide-out: 1;
    in property <bool> slide-opening;
    callback activated(int);

    function show-menu(index: int, x: length, y: length) {
        root.current = index;
        Labels.prepare-album(root.tiles[index].id);
        Favourites.prepare-album(root.tiles[index].id);
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    // Makes `index` the current card and focuses the grid.
    public function focus-card(index: int) {
        root.current = max(0, min(root.tiles.length - 1, index));
        focus.focus();
    }

    private property <length> gap: Theme.space-xl;
    private property <length> min-tile: 160px;
    private property <length> text-height: 44px;
    // Laid out for the queue closed (a) and open beside the page (b), each card at
    // the mix of its two places while the panel slides. No scroll position to keep:
    // the page around the grid scrolls, and its height follows the mix.
    private property <length> closed-width: root.available-width + root.slide-room * (1 - root.slide-out);
    private property <length> open-width: root.closed-width - root.slide-room;
    private property <int> columns-a: max(1, floor((root.closed-width + root.gap) / (root.min-tile + root.gap)));
    private property <int> columns-b: max(1, floor((root.open-width + root.gap) / (root.min-tile + root.gap)));
    private property <length> tile-a: (root.closed-width - (root.columns-a - 1) * root.gap) / root.columns-a;
    private property <length> tile-b: (root.open-width - (root.columns-b - 1) * root.gap) / root.columns-b;
    private property <length> row-a: root.tile-a + Theme.space-s + root.text-height + root.gap;
    private property <length> row-b: root.tile-b + Theme.space-s + root.text-height + root.gap;
    private property <float> mix: 1 - root.slide-out;
    private property <length> card-size: root.tile-a + (root.tile-b - root.tile-a) * root.mix;
    private property <length> height-a: ceil(root.tiles.length / root.columns-a) * root.row-a - root.gap;
    private property <length> height-b: ceil(root.tiles.length / root.columns-b) * root.row-b - root.gap;
    // The layout headed for, which the keys follow.
    private property <int> columns: root.slide-opening ? root.columns-b : root.columns-a;

    pure function card-x(index: int) -> length {
        let a = mod(index, root.columns-a) * (root.tile-a + root.gap);
        let b = mod(index, root.columns-b) * (root.tile-b + root.gap);
        a + (b - a) * root.mix
    }
    pure function card-y(index: int) -> length {
        let a = floor(index / root.columns-a) * root.row-a;
        let b = floor(index / root.columns-b) * root.row-b;
        a + (b - a) * root.mix
    }

    width: root.available-width;
    height: max(0px, root.height-a + (root.height-b - root.height-a) * root.mix);
    accessible-role: list;
    accessible-label: root.label;
    forward-focus: focus;

    // The card's menu: the album's tracks into Up next or the favourites, and labels
    // for every track.
    // In a MenuHost, so the pointer is read right while the menu is open.
    host := MenuHost {
        width: 100%;
        height: 100%;

        menu := ContextMenuArea {
            x: host.shift-x;
            y: host.shift-y;
            width: host.width;
            height: host.height;
            enabled: root.album-menu;

            Menu {
                MenuItem {
                    title: @tr("Play next");
                    activated => {
                        PlayerState.queue-album(root.tiles[root.current].id, true);
                    }
                }
                MenuItem {
                    title: @tr("Add to queue");
                    activated => {
                        PlayerState.queue-album(root.tiles[root.current].id, false);
                    }
                }
                MenuItem {
                    title: Favourites.entry(Favourites.menu-removes);
                    activated => {
                        Favourites.toggle-album(root.tiles[root.current].id);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Labels for every track");
                    enabled: false;
                }
                MenuSeparator { }
                for choice in Labels.choices: MenuItem {
                    title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                    checkable: true;
                    checked: choice.checked;
                    activated => {
                        Labels.toggle-album(root.tiles[root.current].id, choice.id);
                    }
                }
                if Labels.choices.length > 0: MenuSeparator { }
                MenuItem {
                    title: @tr("New label…");
                    activated => {
                        Labels.new-for-album(root.tiles[root.current].id);
                    }
                }
            }

            focus := FocusScope {
                focus-on-click: false;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    let last = root.tiles.length - 1;
                    if event.text == Key.RightArrow {
                        root.current = min(last, root.current + 1);
                    } else if event.text == Key.LeftArrow {
                        root.current = max(0, root.current - 1);
                    } else if event.text == Key.DownArrow {
                        root.current = min(last, root.current + root.columns);
                    } else if event.text == Key.UpArrow {
                        root.current = max(0, root.current - root.columns);
                    } else if event.text == Key.Home {
                        root.current = 0;
                    } else if event.text == Key.End {
                        root.current = last;
                    } else if event.text == Key.Return || event.text == Key.Space {
                        root.activated(root.current);
                    } else if root.album-menu && root.tiles.length > 0 && (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                        // The menu opens on its own; it needs the album's labels and
                        // favourites first.
                        Labels.prepare-album(root.tiles[root.current].id);
                        Favourites.prepare-album(root.tiles[root.current].id);
                        return reject;
                    } else {
                        return reject;
                    }
                    accept
                }
            }

            for tile[index] in root.tiles: AlbumCard {
                x: root.card-x(index);
                y: root.card-y(index);
                width: root.card-size;
                cover-size: root.card-size;
                round: root.round;
                photo: root.photos;
                playlist: root.playlists;
                album: tile;
                focused: focus.has-focus && index == root.current;
                clicked => {
                    root.current = index;
                    root.activated(index);
                }
                menu-requested(x, y) => {
                    if root.album-menu {
                        root.show-menu(index, x, y);
                    }
                }
            }
        }
    }
}
