import { Theme } from "theme.slint";
import { FocusRing } from "components.slint";
import { Glyph, Icon } from "icons.slint";
import { PlayerState } from "player-state.slint";
import { Playlists } from "playlist-state.slint";
import { TagEditorState } from "tag-editor.slint";
import { SelectionChange } from "selection.slint";
import { ColumnEdge, ColumnWidths } from "columns.slint";
import { LabelChips, LabelEntry, LabelWords, Labels } from "labels.slint";

export enum SongColumn { title, artist, album, year, duration }

// One track in the songs table.
export struct SongRow {
    title: string,
    artist: string,
    album: string,
    // Empty when unknown.
    year: string,
    duration: string,
    // File path, matched against the playing track.
    path: string,
    // Picked with Ctrl or Shift, so the track menu acts on it with the others.
    selected: bool,
    // The track's labels, by name.
    labels: [LabelEntry],
}

// The selection in the songs table, kept in its rows, as `TrackSelection` does for
// the other track lists.
export global SongSelection {
    callback change([SongRow], int, int, SelectionChange) -> int;
    callback add-to-playlist([SongRow], int, int);
    callback edit-tags([SongRow], int);
    callback prepare-labels([SongRow], int);
    callback toggle-label([SongRow], int, int);
    callback new-label([SongRow], int);
}

// The width of the Labels column, there while any label exists.
global LabelColumn {
    out property <length> width: 140px;
}

// A column header: sorts by its column, and shows the direction while it does.
component ColumnHeader {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> right-aligned;
    callback clicked();

    min-height: Theme.target-height;
    accessible-role: button;
    accessible-label: !root.sorted ? @tr("Sort by {}", root.text)
        : root.descending ? @tr("{}, sorted in reverse", root.text)
        : @tr("{}, sorted", root.text);
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover ? Theme.colors.surface : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-xs;
        alignment: root.right-aligned ? end : start;

        Text {
            text: root.text;
            color: root.sorted || touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
            font-size: Theme.font-small;
            font-weight: root.sorted ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        if root.sorted: VerticalLayout {
            alignment: center;

            // Points down for A to Z (the list grows downward), up in reverse.
            Icon {
                width: 14px;
                height: 14px;
                glyph: Glyph.chevron-down;
                tint: Theme.colors.text;
                transform-rotation: root.descending ? 180deg : 0deg;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            Theme.keyboard-navigation = false;
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                Theme.keyboard-navigation = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// The column widths, shared by the header and the rows so they line up. Zero
// preferred widths make the text columns share space by stretch alone, in the
// shares the user set (`ColumnWidths`).
component Columns inherits HorizontalLayout {
    spacing: Theme.space-l;
    padding-left: Theme.space-m;
    padding-right: Theme.space-m;
}

// The width of the cell before the title: the play mark, or the play button under
// the pointer.
global SongCells {
    out property <length> play: 16px;
}

// One row. A click selects it; a double-click, or the play button at its start
// under the pointer, plays from it. A right click asks the table for the track's
// menu.
component SongLine {
    in property <SongRow> song;
    in property <bool> playing;
    in property <bool> focused;
    in property <bool> labels-column;
    // A click, and whether it toggles the row's selection (Ctrl, or Cmd on macOS) or
    // selects a range (Shift).
    callback clicked(bool, bool);
    // Plays from this song: a double-click, the play button, or assistive technology.
    callback play-requested();
    callback menu-requested(length, length);
    // The rows just above and below are selected too: a run of selected rows reads
    // as one block, rounded only at its ends.
    in property <bool> selected-above;
    in property <bool> selected-below;

    // The keys held when the button went down.
    private property <bool> toggle-click;
    private property <bool> range-click;
    // Secondary text turns full strength on the fill of a selected or hovered row:
    // muted text on that fill would fall under 4.5:1 in the light theme.
    private property <color> secondary: root.song.selected || touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
    private property <bool> joined-above: root.song.selected && root.selected-above;
    private property <bool> joined-below: root.song.selected && root.selected-below;
    // The pointer is on the play button at the row's start.
    private property <bool> on-play-button: touch.has-hover && touch.mouse-x < play-cell.x + play-cell.width + Theme.space-l / 2;
    private property <string> spoken: root.song.artist == "" ? root.song.title : @tr("{0}, {1}", root.song.title, root.song.artist);

    height: Theme.target-height;
    accessible-role: list-item;
    accessible-label: root.song.labels.length == 0 ? root.spoken : @tr("{0}, labels: {1}", root.spoken, LabelWords.names(root.song.labels));
    accessible-item-selectable: true;
    accessible-item-selected: root.song.selected || root.focused;
    accessible-action-default => {
        root.play-requested();
    }

    Rectangle {
        border-top-left-radius: root.joined-above ? 0 : Theme.radius-m;
        border-top-right-radius: root.joined-above ? 0 : Theme.radius-m;
        border-bottom-left-radius: root.joined-below ? 0 : Theme.radius-m;
        border-bottom-right-radius: root.joined-below ? 0 : Theme.radius-m;
        background: root.song.selected || touch.has-hover ? Theme.colors.surface : transparent;
    }

    // A selected row is marked at its edge, as well as filled, so it reads apart from
    // the row under the pointer. The mark runs on through a block of selected rows.
    if root.song.selected: Rectangle {
        x: 0;
        y: root.joined-above ? 0 : Theme.space-s;
        width: 3px;
        height: root.height - (root.joined-above ? 0 : Theme.space-s) - (root.joined-below ? 0 : Theme.space-s);
        border-top-left-radius: root.joined-above ? 0 : Theme.radius-s;
        border-top-right-radius: root.joined-above ? 0 : Theme.radius-s;
        border-bottom-left-radius: root.joined-below ? 0 : Theme.radius-s;
        border-bottom-right-radius: root.joined-below ? 0 : Theme.radius-s;
        background: Theme.colors.accent;
    }


    Columns {
        play-cell := Rectangle {
            width: SongCells.play;

            if root.playing || touch.has-hover: Icon {
                width: 14px;
                height: 14px;
                glyph: Glyph.play;
                tint: root.playing ? Theme.colors.accent : Theme.colors.text;
            }
        }
        Text {
            horizontal-stretch: ColumnWidths.song-title;
            preferred-width: 0;
            min-width: 0;
            text: root.song.title;
            color: root.playing ? Theme.colors.accent : Theme.colors.text;
            font-size: Theme.font-body;
            font-weight: root.playing ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            horizontal-stretch: ColumnWidths.song-artist;
            preferred-width: 0;
            min-width: 0;
            text: root.song.artist;
            color: root.secondary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            horizontal-stretch: ColumnWidths.song-album;
            preferred-width: 0;
            min-width: 0;
            text: root.song.album;
            color: root.secondary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        if root.labels-column: Rectangle {
            width: LabelColumn.width;
            clip: true;

            HorizontalLayout {
                alignment: start;

                LabelChips {
                    labels: root.song.labels;
                    shown: 1;
                    strong: root.song.selected || touch.has-hover;
                }
            }
        }
        Text {
            width: 56px;
            text: root.song.year;
            color: root.secondary;
            font-size: Theme.font-body;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
        Text {
            width: 64px;
            text: root.song.duration;
            color: root.secondary;
            font-size: Theme.font-body;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    // Over the columns, so what shows in them under the pointer (the play button)
    // doesn't take the hover from the row.
    touch := TouchArea {
        mouse-cursor: root.on-play-button ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            Theme.keyboard-navigation = false;
            if root.on-play-button && !root.toggle-click && !root.range-click {
                root.play-requested();
            } else {
                root.clicked(root.toggle-click, root.range-click);
            }
        }
        double-clicked => {
            if !root.on-play-button {
                root.play-requested();
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu-requested(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.toggle-click = event.modifiers.control || event.modifiers.meta;
                root.range-click = event.modifiers.shift;
            }
        }
    }

    if root.focused: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

// Every track, in a table that only creates the rows in view. The headers sort; the
// rows are one tab stop: arrow keys, Page Up/Down, Home/End move, Enter plays from
// there, and the Menu key (or a right click) opens the track's menu. Rows are
// selected for the menu as in `TrackList`: Ctrl+click or Ctrl+Space, Shift+click or
// Shift with the moving keys, Ctrl+A, Escape to clear.
export component SongTable {
    in property <[SongRow]> songs;
    in property <SongColumn> sort-column;
    in property <bool> sort-descending;
    callback sort(SongColumn);
    // Plays every song in the table's order, from this one.
    callback play(int);
    // Puts a song into Up next: at its front (`next`), or at its end.
    callback queue(int, bool);

    private property <bool> labels-column: Labels.all.length > 0;
    private property <int> current: 0;
    // Where a Shift range starts, and how many rows are selected.
    private property <int> anchor: 0;
    private property <int> selected-count: 0;
    private property <length> row-height: Theme.target-height;
    private property <int> first-row: max(0, floor(-flick.content-y / root.row-height));
    private property <int> slot-count: ceil(flick.height / root.row-height) + 1;

    function select(index: int, change: SelectionChange) {
        root.selected-count = SongSelection.change(root.songs, index, root.anchor, change);
    }

    // Moves the keyboard's current row into view; with Shift, the selection follows.
    function go-to(index: int, extend: bool) {
        root.move-to(index);
        if extend {
            root.select(root.current, SelectionChange.range);
        } else {
            root.anchor = root.current;
        }
    }

    function move-to(index: int) {
        root.current = max(0, min(root.songs.length - 1, index));
        let top = root.current * root.row-height;
        if top < -flick.content-y {
            flick.content-y = -top;
        } else if top + root.row-height > -flick.content-y + flick.height {
            flick.content-y = -(top + root.row-height - flick.height);
        }
    }

    // A row outside the selection gets the menu to itself.
    function show-menu(index: int, x: length, y: length) {
        if root.selected-count > 0 && !root.songs[index].selected {
            root.select(index, SelectionChange.none);
        }
        root.current = index;
        SongSelection.prepare-labels(root.songs, index);
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    changed songs => {
        root.current = max(0, min(root.current, root.songs.length - 1));
        // A new sort or filter: nothing in it is selected.
        root.anchor = root.current;
        root.selected-count = 0;
    }

    VerticalLayout {
        spacing: Theme.space-xs;

        // The headings sort; the edges between the text columns resize them.
        Rectangle {
            min-height: Theme.target-height;

            Columns {
                Rectangle {
                    width: SongCells.play;
                }
                title-header := ColumnHeader {
                    horizontal-stretch: ColumnWidths.song-title;
                    preferred-width: 0;
                    min-width: 0;
                    text: @tr("Title");
                    sorted: root.sort-column == SongColumn.title;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort(SongColumn.title);
                    }
                }
                artist-header := ColumnHeader {
                    horizontal-stretch: ColumnWidths.song-artist;
                    preferred-width: 0;
                    min-width: 0;
                    text: @tr("Artist");
                    sorted: root.sort-column == SongColumn.artist;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort(SongColumn.artist);
                    }
                }
                ColumnHeader {
                    horizontal-stretch: ColumnWidths.song-album;
                    preferred-width: 0;
                    min-width: 0;
                    text: @tr("Album");
                    sorted: root.sort-column == SongColumn.album;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort(SongColumn.album);
                    }
                }
                if root.labels-column: Text {
                    width: LabelColumn.width;
                    text: @tr("Labels");
                    color: Theme.colors.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                ColumnHeader {
                    width: 56px;
                    text: @tr("Year");
                    right-aligned: true;
                    sorted: root.sort-column == SongColumn.year;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort(SongColumn.year);
                    }
                }
                ColumnHeader {
                    width: 64px;
                    text: @tr("Time");
                    right-aligned: true;
                    sorted: root.sort-column == SongColumn.duration;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort(SongColumn.duration);
                    }
                }
            }

            ColumnEdge {
                x: title-header.x + title-header.width;
                height: parent.height;
                label: @tr("Width of the {} column", @tr("Title"));
                first <=> ColumnWidths.song-title;
                second <=> ColumnWidths.song-artist;
                first-width: title-header.width;
                resized => {
                    ColumnWidths.save();
                }
            }
            ColumnEdge {
                x: artist-header.x + artist-header.width;
                height: parent.height;
                label: @tr("Width of the {} column", @tr("Artist"));
                first <=> ColumnWidths.song-artist;
                second <=> ColumnWidths.song-album;
                first-width: artist-header.width;
                resized => {
                    ColumnWidths.save();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.surface;
        }

        menu := ContextMenuArea {
            vertical-stretch: 1;

            Menu {
                // With several songs, the menu says how many it acts on.
                if root.selected-count > 1: MenuItem {
                    title: @tr("{n} track selected" | "{n} tracks selected" % root.selected-count);
                    enabled: false;
                }
                if root.selected-count > 1: MenuSeparator { }
                if root.selected-count < 2: MenuItem {
                    title: @tr("Play now");
                    activated => {
                        root.play(root.current);
                    }
                }
                MenuItem {
                    title: @tr("Play next");
                    activated => {
                        root.queue(root.current, true);
                    }
                }
                MenuItem {
                    title: @tr("Add to queue");
                    activated => {
                        root.queue(root.current, false);
                    }
                }
                Menu {
                    title: @tr("Add to playlist");

                    MenuItem {
                        title: @tr("New playlist");
                        activated => {
                            SongSelection.add-to-playlist(root.songs, root.current, -1);
                        }
                    }
                    if Playlists.names.length > 0: MenuSeparator { }
                    for name[index] in Playlists.names: MenuItem {
                        title: name;
                        activated => {
                            SongSelection.add-to-playlist(root.songs, root.current, index);
                        }
                    }
                }
                Menu {
                    title: @tr("Labels");

                    for choice in Labels.choices: MenuItem {
                        title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                        checkable: true;
                        checked: choice.checked;
                        activated => {
                            SongSelection.toggle-label(root.songs, root.current, choice.id);
                        }
                    }
                    if Labels.choices.length > 0: MenuSeparator { }
                    MenuItem {
                        title: @tr("New label…");
                        activated => {
                            SongSelection.new-label(root.songs, root.current);
                        }
                    }
                }
                MenuItem {
                    title: @tr("Edit tags…");
                    activated => {
                        SongSelection.edit-tags(root.songs, root.current);
                    }
                }
            }

            list := FocusScope {
                focus-on-click: false;
                focus-on-tab-navigation: root.songs.length > 0;
                accessible-role: AccessibleRole.list;
                accessible-label: @tr("Songs");
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        Theme.keyboard-navigation = true;
                    }
                }
                key-pressed(event) => {
                    let page = max(1, root.slot-count - 2);
                    let extend = event.modifiers.shift;
                    if event.text == Key.DownArrow {
                        root.go-to(root.current + 1, extend);
                    } else if event.text == Key.UpArrow {
                        root.go-to(root.current - 1, extend);
                    } else if event.text == Key.PageDown {
                        root.go-to(root.current + page, extend);
                    } else if event.text == Key.PageUp {
                        root.go-to(root.current - page, extend);
                    } else if event.text == Key.Home {
                        root.go-to(0, extend);
                    } else if event.text == Key.End {
                        root.go-to(root.songs.length - 1, extend);
                    } else if (event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A") {
                        root.select(0, SelectionChange.all);
                    } else if event.modifiers.control && event.text == Key.Space {
                        root.anchor = root.current;
                        root.select(root.current, SelectionChange.toggle);
                    } else if event.text == Key.Escape && root.selected-count > 0 {
                        root.select(0, SelectionChange.none);
                    } else if event.text == Key.Return || event.text == Key.Space {
                        root.play(root.current);
                    } else if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                        // The menu opens on its own; it needs the current labels first.
                        SongSelection.prepare-labels(root.songs, root.current);
                        return reject;
                    } else {
                        return reject;
                    }
                    accept
                }

                flick := Flickable {
                    content-height: root.songs.length * root.row-height;

                    for slot in root.slot-count: SongLine {
                        property <int> index: root.first-row + slot;
                        visible: self.index < root.songs.length;
                        y: self.index * root.row-height;
                        width: parent.width;
                        song: root.songs[self.index];
                        selected-above: self.index > 0 && root.songs[self.index - 1].selected;
                        selected-below: self.index + 1 < root.songs.length && root.songs[self.index + 1].selected;
                        playing: self.song.path == PlayerState.track-path;
                        focused: list.has-focus && self.index == root.current;
                        labels-column: root.labels-column;
                        clicked(toggle, range) => {
                            root.current = self.index;
                            if range {
                                root.select(self.index, SelectionChange.range);
                            } else if toggle {
                                root.anchor = self.index;
                                root.select(self.index, SelectionChange.toggle);
                            } else {
                                // This song alone: a range from it to itself.
                                root.anchor = self.index;
                                root.select(self.index, SelectionChange.range);
                            }
                        }
                        play-requested => {
                            root.current = self.index;
                            root.play(self.index);
                        }
                        menu-requested(x, y) => {
                            root.show-menu(self.index, x, y);
                        }
                    }
                }
            }
        }
    }
}
