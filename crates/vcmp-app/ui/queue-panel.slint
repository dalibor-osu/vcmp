import { Theme } from "theme.slint";
import { Button, EdgeScroll, FocusRing, IconButton, ScrollArea } from "components.slint";
import { Glyph } from "icons.slint";
import { PlayerState, QueueRow, QueueSource } from "player-state.slint";
import { Playlists } from "playlist-state.slint";
import { Labels } from "labels.slint";

// One track in the queue. A right click asks the panel for the track's menu.
component QueueLine {
    in property <QueueRow> entry;
    // Tracks in Up next can be taken out; context tracks only played.
    in property <bool> removable;
    // The keyboard's current track in the focused list.
    in property <bool> focused;
    callback clicked();
    callback remove();
    // Window position of a right click.
    callback menu-requested(length, length);
    // Where the row is, so the list can scroll it into view.
    callback shown-focused(length, length);
    // Up next rows can be dragged to another place: the panel hears where the pointer
    // is and where the row is (window y) and its height, then when it lets go.
    in property <bool> draggable;
    callback drag-moved(length, length, length);
    callback drag-ended();

    // The press became a drag, so letting go plays nothing.
    private property <bool> dragging;
    private property <bool> dragged;

    changed focused => {
        if self.focused {
            root.shown-focused(self.absolute-position.y, self.height);
        }
    }

    min-height: Theme.target-height + Theme.space-s;
    accessible-role: list-item;
    accessible-label: root.entry.artist == "" ? root.entry.title : @tr("{0}, {1}", root.entry.title, root.entry.artist);
    accessible-item-selected: root.focused;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: Theme.radius-m;
        background: touch.has-hover ? Theme.colors.surface : transparent;
    }

    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.default;
        clicked => {
            if root.dragged {
                root.dragged = false;
            } else {
                Theme.keyboard-navigation = false;
                root.clicked();
            }
        }
        moved => {
            if root.draggable && self.pressed && (root.dragging || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragging = true;
                root.drag-moved(root.absolute-position.y + self.mouse-y, root.absolute-position.y, root.height);
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu-requested(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.dragged = false;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.dragged = true;
                root.drag-ended();
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: root.removable ? 0px : Theme.space-m;
        spacing: Theme.space-m;

        // The album cover, or an empty square while it loads or when there is none.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-s;
                clip: true;
                background: Theme.colors.surface;

                if root.entry.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.entry.cover;
                    image-fit: ImageFit.cover;
                    accessible-role: none;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.entry.title;
                color: Theme.colors.text;
                font-size: Theme.font-body;
                overflow: elide;
                accessible-role: none;
            }
            if root.entry.artist != "": Text {
                text: root.entry.artist;
                color: touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
                font-size: Theme.font-small;
                overflow: elide;
                accessible-role: none;
            }
        }

        Text {
            text: root.entry.duration;
            color: touch.has-hover ? Theme.colors.text : Theme.colors.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 0;
            accessible-role: none;
        }

        if root.removable: VerticalLayout {
            alignment: center;

            IconButton {
                glyph: Glyph.remove;
                label: @tr("Remove {} from the queue", root.entry.title);
                // The list's Delete key does the same from the keyboard.
                tab-stop: false;
                clicked => {
                    root.remove();
                }
            }
        }
    }

    if root.focused: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: Theme.radius-m;
    }
}

component SectionLabel inherits Text {
    color: Theme.colors.text-muted;
    font-size: Theme.font-small;
    font-weight: Theme.weight-strong;
    overflow: elide;
}

// The queue: the track playing, Up next, and what follows from the album or list
// being played. The tracks are one tab stop: Up and Down move, Enter or Space plays,
// Delete removes from Up next, Alt+Up and Alt+Down reorder it, and the Menu key (or
// a right click) opens a track's menu, with what applies to that track.
// The window slides it in and out from its edge.
export component QueuePanel inherits Rectangle {
    private property <int> up-next-count: PlayerState.up-next.length;
    private property <int> count: self.up-next-count + PlayerState.upcoming.length;
    // The keyboard's current track, counted over Up next then the context tracks.
    private property <int> current: 0;
    // An Up next row being dragged, where it is in the list and how tall, and the
    // pointer's window y. The place it would go, and the line that shows it, follow
    // the list when it scrolls under a pointer held still.
    private property <int> drag-from: -1;
    private property <length> drag-row-y;
    private property <length> drag-row-height;
    private property <length> drag-y;
    // The dragged row stays put; places count from it.
    private property <length> drag-pitch: root.drag-row-height + Theme.space-xs;
    private property <int> drag-to: root.drag-from < 0 ? -1
        : clamp(root.drag-from + round((root.drag-y - list.absolute-position.y - root.drag-row-y - root.drag-row-height / 2) / root.drag-pitch), 0, root.up-next-count - 1);
    private property <length> drag-line-y: root.drag-row-y + (root.drag-to - root.drag-from) * root.drag-pitch
        + (root.drag-to > root.drag-from ? root.drag-row-height + Theme.space-xs / 2 : -Theme.space-xs / 2) - 1px;

    // Scrolls so the row at window y `top` with `height` is inside the view.
    function ensure-visible(top: length, height: length) {
        let view-top = scroll.absolute-position.y;
        let view-bottom = view-top + scroll.visible-height;
        if top < view-top {
            scroll.content-y = min(0px, scroll.content-y + (view-top - top));
        } else if top + height > view-bottom {
            scroll.content-y = scroll.content-y - (top + height - view-bottom);
        }
    }

    function move-current(by: int) {
        let to = root.current + by;
        if root.current < root.up-next-count && to >= 0 && to < root.up-next-count {
            PlayerState.move-in-up-next(root.current, to);
            root.current = to;
        }
    }

    // The file of the row the menu is for.
    function current-path() -> string {
        if root.current < root.up-next-count {
            return PlayerState.up-next[root.current].path;
        }
        PlayerState.upcoming[root.current - root.up-next-count].path
    }

    function show-menu(index: int, x: length, y: length) {
        root.current = index;
        Labels.prepare-path(root.current-path());
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    changed count => {
        root.current = max(0, min(root.current, root.count - 1));
    }

    background: Theme.colors.mantle;
    accessible-role: groupbox;
    accessible-label: @tr("Queue");

    // Separates the panel from the page beside it.
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.colors.surface;
    }

    VerticalLayout {
        padding: Theme.space-l;
        padding-left: Theme.space-l + 1px;
        spacing: Theme.space-m;

        Text {
            text: @tr("Queue");
            color: Theme.colors.text;
            font-size: Theme.font-heading;
            font-weight: Theme.weight-strong;
        }

        if PlayerState.has-track: VerticalLayout {
            spacing: Theme.space-xs;

            SectionLabel {
                text: @tr("Now playing");
            }
            Text {
                text: PlayerState.title;
                color: Theme.colors.accent;
                font-size: Theme.font-body;
                font-weight: Theme.weight-strong;
                overflow: elide;
            }
            if PlayerState.artist != "": Text {
                text: PlayerState.artist;
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        if root.count == 0: Text {
            text: @tr("Nothing comes next. Play an album, or choose Play next or Add to queue in the menu of an album card or a track.");
            color: Theme.colors.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }

        scroll := ScrollArea {
            vertical-stretch: 1;
            visible: root.count > 0;

            // A layout, so the view knows how tall the rows are and scrolls them.
            VerticalLayout {
                menu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Play");
                            activated => {
                                PlayerState.play-queue-entry(root.current);
                            }
                        }
                        // Tracks added to Up next can be taken out and reordered.
                        if root.current < root.up-next-count: MenuItem {
                            title: @tr("Remove from queue");
                            activated => {
                                PlayerState.remove-from-up-next(root.current);
                            }
                        }
                        if root.current > 0 && root.current < root.up-next-count: MenuItem {
                            title: @tr("Move up");
                            activated => {
                                root.move-current(-1);
                            }
                        }
                        if root.current < root.up-next-count - 1: MenuItem {
                            title: @tr("Move down");
                            activated => {
                                root.move-current(1);
                            }
                        }
                        // Those from the album or list being played can be put into Up
                        // next; they stay in their place too.
                        if root.current >= root.up-next-count: MenuItem {
                            title: @tr("Play next");
                            activated => {
                                PlayerState.queue-upcoming(root.current - root.up-next-count, true);
                            }
                        }
                        if root.current >= root.up-next-count: MenuItem {
                            title: @tr("Add to queue");
                            activated => {
                                PlayerState.queue-upcoming(root.current - root.up-next-count, false);
                            }
                        }
                        Menu {
                            title: @tr("Add to playlist");

                            MenuItem {
                                title: @tr("New playlist");
                                activated => {
                                    Playlists.add-track(-1, root.current-path());
                                }
                            }
                            if Playlists.names.length > 0: MenuSeparator { }
                            for name[index] in Playlists.names: MenuItem {
                                title: name;
                                activated => {
                                    Playlists.add-track(index, root.current-path());
                                }
                            }
                        }
                        Menu {
                            title: @tr("Labels");

                            for choice in Labels.choices: MenuItem {
                                title: choice.partial ? @tr("{} (on some)", choice.name) : choice.name;
                                checkable: true;
                                checked: choice.checked;
                                activated => {
                                    Labels.toggle-path(root.current-path(), choice.id);
                                }
                            }
                            if Labels.choices.length > 0: MenuSeparator { }
                            MenuItem {
                                title: @tr("New label…");
                                activated => {
                                    Labels.new-for-path(root.current-path());
                                }
                            }
                        }
                    }

                    list := FocusScope {
                        focus-on-click: false;
                        focus-gained(reason) => {
                            if reason == FocusReason.tab-navigation {
                                Theme.keyboard-navigation = true;
                            }
                        }
                        key-pressed(event) => {
                            if root.count == 0 {
                                return reject;
                            }
                            if event.modifiers.alt && event.text == Key.UpArrow {
                                root.move-current(-1);
                            } else if event.modifiers.alt && event.text == Key.DownArrow {
                                root.move-current(1);
                            } else if event.text == Key.DownArrow {
                                root.current = min(root.count - 1, root.current + 1);
                            } else if event.text == Key.UpArrow {
                                root.current = max(0, root.current - 1);
                            } else if event.text == Key.Home {
                                root.current = 0;
                            } else if event.text == Key.End {
                                root.current = root.count - 1;
                            } else if event.text == Key.Return || event.text == Key.Space {
                                PlayerState.play-queue-entry(root.current);
                            } else if event.text == Key.Delete && root.current < root.up-next-count {
                                PlayerState.remove-from-up-next(root.current);
                            } else if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                                // The menu opens on its own; it needs the current labels first.
                                Labels.prepare-path(root.current-path());
                                return reject;
                            } else {
                                return reject;
                            }
                            accept
                        }

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            alignment: start;
                            accessible-role: AccessibleRole.list;
                            accessible-label: @tr("Coming up");

                            if root.up-next-count > 0: HorizontalLayout {
                                padding-top: Theme.space-s;
                                spacing: Theme.space-m;

                                SectionLabel {
                                    text: @tr("Next in queue");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: @tr("Clear");
                                    label: @tr("Clear the queue");
                                    clicked => {
                                        PlayerState.clear-up-next();
                                    }
                                }
                            }

                            for row[index] in PlayerState.up-next: QueueLine {
                                entry: row;
                                removable: true;
                                draggable: true;
                                drag-moved(y, top, height) => {
                                    root.drag-row-y = top - list.absolute-position.y;
                                    root.drag-row-height = height;
                                    root.drag-y = y;
                                    if root.drag-from < 0 {
                                        root.drag-from = index;
                                        root.current = index;
                                    }
                                }
                                drag-ended => {
                                    let to = root.drag-to;
                                    if root.drag-from >= 0 && to >= 0 && to != root.drag-from {
                                        PlayerState.move-in-up-next(root.drag-from, to);
                                        root.current = to;
                                    }
                                    root.drag-from = -1;
                                }
                                focused: list.has-focus && index == root.current;
                                clicked => {
                                    root.current = index;
                                    PlayerState.play-queue-entry(index);
                                }
                                remove => {
                                    PlayerState.remove-from-up-next(index);
                                }
                                menu-requested(x, y) => {
                                    root.show-menu(index, x, y);
                                }
                                shown-focused(top, height) => {
                                    root.ensure-visible(top, height);
                                }
                            }

                            if PlayerState.upcoming.length > 0: SectionLabel {
                                text: PlayerState.queue-source == QueueSource.search ? @tr("Next from your search")
                                    : PlayerState.queue-source == QueueSource.songs ? @tr("Next from all songs")
                                    : PlayerState.queue-origin != "" ? @tr("Next from {}", PlayerState.queue-origin) : @tr("Next up");
                                height: Theme.target-height;
                                vertical-alignment: bottom;
                            }

                            for row[index] in PlayerState.upcoming: QueueLine {
                                entry: row;
                                focused: list.has-focus && root.up-next-count + index == root.current;
                                clicked => {
                                    root.current = root.up-next-count + index;
                                    PlayerState.play-queue-entry(root.up-next-count + index);
                                }
                                menu-requested(x, y) => {
                                    root.show-menu(root.up-next-count + index, x, y);
                                }
                                shown-focused(top, height) => {
                                    root.ensure-visible(top, height);
                                }
                            }
                        }

                        // Where a dragged row would land.
                        if root.drag-from >= 0 && root.drag-to != root.drag-from: Rectangle {
                            x: 0;
                            y: root.drag-line-y;
                            width: parent.width;
                            height: 2px;
                            border-radius: self.height / 2;
                            background: Theme.colors.accent;
                        }
                    }
                }
            }
        }
    }

    // Scrolls the list while a dragged Up next track is held near its top or bottom.
    EdgeScroll {
        active: root.drag-from >= 0;
        pointer-y: root.drag-y;
        view-top: scroll.absolute-position.y;
        view-height: scroll.visible-height;
        content-height: scroll.content-height;
        content-y <=> scroll.content-y;
    }
}
